# 复制成 .env 后按需修改；不填则用 application.yml 里的默认值
# 注意：JWT_SECRET 至少 32 字节，生产必须换

JWT_SECRET=dev-only-please-replace-me-with-32-bytes-min

# 演示账号（首次启动时创建）
ADMIN_USER=demo
ADMIN_PASS=123456

# 后端 / 前端端口
SERVER_PORT=8080
FRONTEND_PORT=5173

# 本地 http 时保持 false；生产走 https 再改 true
COOKIE_SECURE=false

# 用 MySQL 时：SPRING_PROFILES_ACTIVE=mysql
SPRING_PROFILES_ACTIVE=
MYSQL_URL=jdbc:mysql://localhost:3306/mini?useSSL=false&serverTimezone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=root

# Docker Compose 里的 MySQL 根密码
MYSQL_ROOT_PASSWORD=root
