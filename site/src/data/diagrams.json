  {
    "id": "en-cache-breakdown",
    "type": "flow",
    "title": "击穿时序：同一 key 只有一个线程查库",
    "steps": [
      {
        "t": "线程 A、B、C 同时未命中缓存"
      },
      {
        "t": "三者都尝试 lock.lock()",
        "tone": "qing"
      },
      {
        "t": "A 拿到锁 → 锁内再判空值缓存与 Hash",
        "d": "双重判定"
      },
      {
        "t": "A 查库并 Lua 回填 → 释放锁",
        "tone": "lv"
      },
      {
        "t": "B、C 依次拿锁后判定已回填 → 直接读缓存返回",
        "d": "回源次数 = 1"
      }
    ],
    "attachTo": [
      "en-02"
    ]
  },
