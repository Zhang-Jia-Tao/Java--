  {
    "id": "ma-read-broadcast",
    "type": "flow",
    "title": "批量查模板：按店分组 → 手动路由到库 → 合并",
    "steps": [
      {
        "t": "入参 ids + shopNumber 列表",
        "tone": "qing"
