  {
    "id": "en-remind-execute",
    "type": "flow",
    "title": "提醒执行：写 Key → 线程池 → 10 秒后检查",
    "steps": [
      {
        "t": "延时消息到点 → 消费",
        "tone": "qing"
      },
      {
        "t": "先写 Redis Key",
        "d": "用户+券+时间+类型 唯一"
