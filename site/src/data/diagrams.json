        "t": "按 shopNumber 分组",
        "d": "同一店铺的数据一定同库"
      },
      {
        "t": "splitIndexByDatabase：算库下标",
        "d": "避免全路由扫描 32 张表",
        "tone": "jin"
      },
      {
        "t": "逐库执行 IN 查询",
        "d": "每库一次 SQL，而不是 32 次"
      },
      {
        "t": "合并结果并按 id 排序返回",
        "tone": "lv"
      }
    ],
    "attachTo": [
      "ma-12"
