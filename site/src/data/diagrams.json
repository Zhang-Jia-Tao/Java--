  {
    "id": "en-cache-chain",
    "type": "flow",
    "title": "模板查询漏斗：四层挡在数据库之前",
    "steps": [
      {
        "t": "Redis Hash 命中 → 直接返回",
        "tone": "lv",
        "d": "绝大多数请求在这里结束"
      },
      {
        "t": "布隆过滤器判存在性",
        "d": "不存在的 id 直接拒绝（穿透第一层）"
      },
      {
        "t": "空值缓存 hasKey",
        "d": "TTL 30 分钟（穿透第二层）"
      },
      {
        "t": "Redisson 锁 + 双重判定",
        "d": "并发只放一个线程回源（击穿）",
        "tone": "zhu"
      },
      {
        "t": "查库 → 空则写空标记 / 有则 Lua HMSET+EXPIREAT",
        "tone": "jin"
      }
    ],
    "attachTo": [
      "en-01"
    ]
  },
  {
    "id": "en-cache-breakdown",
    "type": "flow",
    "title": "击穿时序：同一 key 只有一个线程查库",
    "steps": [
      {
        "t": "线程 A、B、C 同时未命中缓存"
      },
      {
        "t": "三者都尝试 lock.lock()",
        "tone": "qing"
      },
      {
        "t": "A 拿到锁 → 锁内再判空值缓存与 Hash",
        "d": "双重判定"
      },
      {
        "t": "A 查库并 Lua 回填 → 释放锁",
        "tone": "lv"
      },
      {
        "t": "B、C 依次拿锁后判定已回填 → 直接读缓存返回",
        "d": "回源次数 = 1"
      }
    ],
    "attachTo": [
      "en-02"
    ]
  },
