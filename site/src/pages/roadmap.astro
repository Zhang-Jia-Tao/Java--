---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import roadmap from '../data/roadmap.json';
import { stats } from '../lib/stats';

const totalGain = (roadmap as any[]).reduce(
  (s, g) => s + g.items.reduce((a: number, it: any) => a + it.gain, 0),
  0
);
const s = stats;

// 三个区各自的短板模块（均分最低的两个）
const weak = (group: 'java' | 'project' | 'ai') =>
  s.moduleRows
    .filter((m) => m.group === group)
    .sort((a, b) => a.avg - b.avg)
    .slice(0, 2);

const tracks = [
  {
    key: 'java' as const,
    title: 'Java 基础',
    count: s.java.count,
    avg: s.java.avg,
    href: '/notes',
    steps: [
      '先补耳熟能详的八股，但每道题都要能讲出取舍，而不是背结论',
      '对照硬伤清单，一级硬伤优先级最高（当场被判理解错的那类）',
      '每章挑两道最低分做“重讲一遍”，其余靠闪卡与复习队列维持'
    ]
  },
  {
    key: 'project' as const,
    title: '项目经历 · OneCoupon',
    count: s.project.count,
    avg: s.project.avg,
    href: '/project',
    steps: [
      '先按模块过一遍源码锚点：每个结论都能指到某个类某一行',
      '背诵层只留「一句话 + 60 秒」，细节全部交给原文层 L3 逐字核对',
      '分片 / 缓存 / MQ 三条主线优先，其余模块按自测分从低到高补'
    ]
  },
  {
    key: 'ai' as const,
    title: 'Ragent AI',
    count: s.ai.count,
    avg: s.ai.avg,
    href: '/ai',
    steps: [
      '先吃透七阶段流水线与三个短路点，能口述整条链路再说细节',
      '意图树 / 多通道检索 / MCP 工具三块各自能画图',
      '评测部分只讲仓库里真实存在的机制，不编指标公式（文档里给不出的就说到哪算哪）'
    ]
  }
];
---

<BaseLayout title="提分路线 · 166 题" description="Java / 项目 / AI 三块的最短提分路径，含分层阅读方法">
  <SiteHeader />
  <main class="mx-auto max-w-[900px] px-6 pb-24">
    <header class="border-b border-line pt-10 pb-6">
      <h1 class="title-cn text-[32px]">提分路线</h1>
      <p class="mt-2 max-w-[46em] text-[13px] leading-relaxed text-ink3">
        当前综合均分 <strong class="text-ink2">{s.avg}</strong>（{s.total} 题：Java {s.java.count} / 项目 {s.project.count} / AI {s.ai.count}），
        硬伤 {s.hardErrors} 条。Java 部分按“每改 1 小时能拿多少分”排序，预计收益合计 +{totalGain}；
        项目与 AI 两块按顺序补链路，先把能指到源码的讲清楚。
      </p>
      <div class="mt-4 flex flex-wrap gap-2 text-[11.5px]">
        {tracks.map((t) => (
          <a href={`#${t.key}`} class="rounded border border-line px-2 py-0.5 text-ink2 hover:text-ink">
            {t.title} · {t.count} 题 · 均分 {t.avg}
          </a>
        ))}
      </div>
    </header>

    <section class="mt-8 rounded-xl border border-dashed border-line px-5 py-4">
      <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-zhu">阅读顺序 · L1 → L2 → L3</p>
      <ol class="mt-2 space-y-1.5 text-[12.5px] leading-relaxed text-ink3">
        <li><strong class="text-ink2">L1 背诵层</strong>：一句话 + 60 秒口述，先把骨架立住，适合通勤与面试前 10 分钟。</li>
        <li><strong class="text-ink2">L2 展开层</strong>：深挖与满分回答，用来对付追问；遇到不确定的点别编，直接去 L3。</li>
        <li><strong class="text-ink2">L3 原文层</strong>：{108} 篇全文，按小节折叠，可以逐行核对原样，也能一眼看到原文与代码不一致的地方。</li>
      </ol>
    </section>

    {tracks.map((t) => (
      <section class="mt-10" id={t.key}>
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2">
          <div class="flex items-baseline gap-3">
            <h2 class="title-cn text-[19px]">{t.title}</h2>
            <span class="text-[12px] text-ink3">{t.count} 题 · 均分 {t.avg}</span>
          </div>
          <a href={t.href} class="text-[12px] text-zhu hover:underline">进入 →</a>
        </div>
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <ol class="space-y-2 text-[13px] leading-relaxed text-ink2">
            {t.steps.map((step, i) => (
              <li class="flex gap-2">
                <span class="tabular mt-0.5 w-4 shrink-0 text-[11.5px] text-ink3">{i + 1}.</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
          <div class="rounded-lg border border-line bg-card px-4 py-3">
            <p class="text-[11px] uppercase tracking-wider text-ink3">优先补这两个模块</p>
            <ul class="mt-2 space-y-1.5">
              {weak(t.key).map((m) => (
                <li class="flex items-baseline justify-between gap-3">
                  <a href={m.href} class="truncate text-[13px] text-ink2 hover:text-zhu">{m.name}</a>
                  <span class="tabular shrink-0 text-[12.5px] text-sd">{m.avg}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))}

    <section class="mt-12">
      <div class="flex items-baseline gap-3 border-b border-line pb-2">
        <h2 class="title-cn text-[19px]">Java 逐条动作</h2>
        <span class="text-[12px] text-ink3">按性价比排序 · 预计合计 +{totalGain}</span>
      </div>
      {(roadmap as any[]).map((g) => (
        <div class="mt-6">
          <div class="flex items-baseline gap-3">
            <span class="tabular text-[14px] font-semibold text-zhu">{g.priority}</span>
            <span class="text-[12px] text-ink3">合计 +{g.items.reduce((a: number, it: any) => a + it.gain, 0)}</span>
          </div>
          <ul class="mt-3 space-y-2.5">
            {g.items.map((it: any) => (
              <li class="card flex items-start gap-4 px-5 py-3.5">
                <div class="min-w-0 flex-1">
                  <p class="text-[13.5px] leading-relaxed">{it.action}</p>
                  <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[11.5px] text-ink3">
                    <span>涉及</span>
                    {it.ids.length === 0 ? (
                      <span>全稿</span>
                    ) : (
                      it.ids.map((id: string) => (
                        <a
                          href={`/notes/ch${id.startsWith('6') ? id.slice(0, 2) : id[0]}/${id}`}
                          class="font-mono text-zhu hover:underline"
                        >
                          {id}
                        </a>
                      ))
                    )}
                  </p>
                </div>
                <div class="shrink-0 text-right">
                  <p class="tabular text-[15px] font-semibold text-sa">+{it.gain}</p>
                  <p class="text-[10.5px] text-ink3">预计提分</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <p class="mt-12 rounded-xl border border-dashed border-line px-5 py-4 text-[12px] leading-relaxed text-ink3">
      说明：Java 的预估收益是评审环节给的经验值，不是承诺；P0 那几条都是"题目点名要讲的东西整块没讲"。
      项目与 AI 两块没有逐条收益估算——它们的提升主要在"能不能指到源码"，这只有你自己练一遍才知道差多少。
    </p>
  </main>
</BaseLayout>
