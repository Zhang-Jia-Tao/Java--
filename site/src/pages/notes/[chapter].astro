---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import { loadQuestions, findChapter } from '../../lib/questions';

export function getStaticPaths() {
  const questions = loadQuestions();
  const seen = Array.from(new Set(questions.map((q: any) => q.chapter)));
  return seen.map((key) => ({ params: { chapter: key }, props: { chapterKey: key } }));
}

const { chapterKey } = Astro.props;
const meta = findChapter(chapterKey);
const list = loadQuestions()
  .filter((q: any) => q.chapter === chapterKey)
  .sort((a: any, b: any) => (a.id > b.id ? 1 : -1));
const errors = list.flatMap((q: any) => (q.hardErrors || []).map((e: any) => ({ ...e, id: q.id })));
const avg = list.length ? (list.reduce((s: number, q: any) => s + q.score.total, 0) / list.length).toFixed(1) : '0';
---

<BaseLayout title={`${meta ? meta.name : chapterKey} · Java 终极笔记`}>
  <SiteHeader />
  <main class="mx-auto max-w-[900px] px-6 pb-24">
    <nav class="pt-8 text-[12px] text-ink3">
      <a href="/" class="hover:text-ink">首页</a>
      <span class="mx-1.5">/</span>
      <a href="/notes" class="hover:text-ink">笔记</a>
    </nav>
    <header class="border-b border-line pb-8 pt-4">
      <h1 class="title-cn text-[32px]">
        {meta ? meta.name : chapterKey}
        {meta && meta.sub ? <span class="ml-3 text-[14px] font-normal text-ink3">{meta.sub}</span> : null}
      </h1>
      <p class="mt-2 text-[13px] text-ink3">
        {list.length} 题 · 均分 {avg} · 硬伤 {errors.length} 条
      </p>
    </header>

    <ul class="mt-4 divide-y divide-line">
      {list.map((q: any) => (
        <li>
          <a href={`/notes/${q.chapter}/${q.id}`} class="group flex items-center gap-4 py-4">
            <span class="tabular w-12 shrink-0 font-mono text-[12.5px] text-ink3">{q.id}</span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-[14.5px] group-hover:text-zhu">{q.title}</span>
              <span class="mt-0.5 flex items-center gap-2 text-[11.5px] text-ink3">
                <span>C{q.score.C}/20</span>
                {(q.hardErrors?.length ?? 0) > 0 ? <span class="text-zhu">{q.hardErrors.length} 处硬伤</span> : <span>无硬伤</span>}
                <span>追问 {q.followUps?.length ?? 0}</span>
              </span>
            </span>
            <ScoreBadge total={q.score.total} verdict={q.score.verdict} />
          </a>
        </li>
      ))}
    </ul>

    {errors.length > 0 ? (
      <section class="mt-12">
        <h2 class="border-b border-line pb-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-zhu">
          本章硬伤（{errors.length}）
        </h2>
        <ul class="mt-4 space-y-3">
          {errors.map((e: any) => (
            <li class="text-[13px] leading-relaxed">
              <a href={`/notes/${chapterKey}/${e.id}`} class="mr-2 font-mono text-[11.5px] text-zhu hover:underline">{e.id}</a>
              <span class="text-ink2">{e.wrong.length > 60 ? e.wrong.slice(0, 60) + '…' : e.wrong}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </main>
</BaseLayout>
