---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MindMap from '../../components/MindMap.astro';
import { loadQuestions } from '../../lib/questions';
import type { MMNode } from '../../lib/mindmap';
import chaptersJson from '../../data/chapters.json';

const questions = loadQuestions();

const groups = (chaptersJson as any[])
  .map((c) => {
    const list = questions.filter((q: any) => q.chapter === c.key);
    const avg = list.reduce((a: number, q: any) => a + q.score.total, 0) / Math.max(1, list.length);
    return { c, list, avg: Math.round(avg * 10) / 10 };
  })
  .filter((g) => g.list.length > 0);

/** 「第6章 网络」出现两次（高频 / 常见），短名要带上副标题才分得清 */
const shortName = (name: string) => name.replace(/^第\d+章\s*/, '');
const nameCount = new Map<string, number>();
for (const g of groups) {
  const n = shortName(g.c.name);
  nameCount.set(n, (nameCount.get(n) ?? 0) + 1);
}
const branchLabel = (g: (typeof groups)[number]) => {
  const n = shortName(g.c.name);
  if ((nameCount.get(n) ?? 0) < 2) return n;
  const sub = String(g.c.sub ?? '');
  return sub ? `${n}·${sub.replace(/\s*Q\d+-\d+$/, '')}` : n;
};

const total = questions.length;
const avgAll = Math.round((questions.reduce((a: number, q: any) => a + q.score.total, 0) / total) * 10) / 10;
const hardErr = questions.filter((q: any) => (q.hardErrors?.length ?? 0) > 0).length;

const tree: MMNode = {
  id: 'java',
  label: 'Java 基础',
  sub: `${total} 题 · ${groups.length} 组 · 均分 ${avgAll}`,
  href: '/notes',
  summary: `全站 ${total} 道 Java 题的总入口：${groups.length} 组、均分 ${avgAll}、${hardErr} 题含硬伤`,
  children: groups.map((g) => ({
    id: g.c.key,
    label: branchLabel(g),
    sub: `${g.list.length} 题 · 均分 ${g.avg}`,
    href: `/notes/${g.c.key}`,
    summary: `${g.c.name}${g.c.sub ? ' · ' + g.c.sub : ''}：${g.list.length} 题，均分 ${g.avg}（${g.c.min}–${g.c.max}）`,
    children: g.list.map((q: any) => ({
      id: q.id,
      label: q.title,
      score: q.score.total,
      href: `/notes/${q.chapter}/${q.id}`,
      summary: String(q.summary ?? '').slice(0, 150)
    }))
  }))
};
---

<BaseLayout title="思维导图 · Java 基础" description={`${total} 道 Java 题的三层思维导图：${groups.length} 个章节、悬停看整条路径、点章节折叠、按标题搜索`}>
  <SiteHeader />
  <main class="mx-auto max-w-[1240px] px-6 pb-24">
    <nav class="pt-8 text-[12px] text-ink3">
      <a href="/notes" class="hover:text-zhu">Java 基础</a>
      <span class="mx-1.5">/</span>
      <span class="text-ink2">思维导图</span>
    </nav>

    <header class="mt-4 border-b border-line pb-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-[11px] tracking-[0.22em] text-zhu">MIND MAP · 试验版</p>
          <h1 class="title-cn mt-1 text-[30px]">Java 基础 · 三层思维导图</h1>
          <p class="mt-2 max-w-[46em] text-[13px] leading-relaxed text-ink3">
            根是「Java 基础」，一层是 {groups.length} 个章节，二层是 {total} 道题。
            两侧分列是刻意的：58 道题摊在一边会拖成一条两米长的列表，镜像排布后才看得出「哪几章题多、哪一章最薄」。
          </p>
        </div>
        <dl class="flex gap-6 text-[12px] text-ink3">
          <div><dt>题量</dt><dd class="font-mono text-[22px] text-ink">{total}</dd></div>
          <div><dt>章节</dt><dd class="font-mono text-[22px] text-ink">{groups.length}</dd></div>
          <div><dt>均分</dt><dd class="font-mono text-[22px] text-zhu">{avgAll}</dd></div>
          <div><dt>含硬伤</dt><dd class="font-mono text-[22px] text-ink2">{hardErr}</dd></div>
        </dl>
      </div>
    </header>

    <section class="mt-6">
      <MindMap root={tree} total={total} />
    </section>

    <section class="mt-12 grid gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-line bg-surface px-4 py-3">
        <p class="text-[11px] uppercase tracking-[0.16em] text-zhu">怎么用</p>
        <ul class="mt-2 space-y-1.5 text-[12px] leading-relaxed text-ink2">
          <li>悬停任意题目：整条「题目 → 章节 → 根」变朱红，其它压暗，回答「这题属于哪一块」。</li>
          <li>点章节节点折叠/展开，角标 <span class="font-mono">+N</span> 是折起来的题数；<span class="font-mono">↗</span> 直接进章节页。</li>
          <li>左上搜标题或章节名：命中的题自动展开并高亮，其它淡出。</li>
        </ul>
      </div>
      <div class="rounded-xl border border-line bg-surface px-4 py-3">
        <p class="text-[11px] uppercase tracking-[0.16em] text-zhu">为什么这么画</p>
        <ul class="mt-2 space-y-1.5 text-[12px] leading-relaxed text-ink2">
          <li>三层封顶：再深一层（如「HashMap」下的子问题）在 1200px 宽里会挤成字墙，留给题目页的追问区更合适。</li>
          <li>左侧有色条按评分分档（≥85 朱 / 75–84 青 / &lt;75 金），扫一眼就知道哪一片是弱项。</li>
          <li>连线两层：实线负责入场描线，虚线一直流动——后者只在 <span class="font-mono">prefers-reduced-motion</span> 关掉。</li>
        </ul>
      </div>
      <div class="rounded-xl border border-line bg-surface px-4 py-3">
        <p class="text-[11px] uppercase tracking-[0.16em] text-zhu">下一步</p>
        <ul class="mt-2 space-y-1.5 text-[12px] leading-relaxed text-ink2">
          <li>这套组件是通用的（<span class="font-mono">lib/mindmap.ts</span> 只吃「根 → 组 → 条目」），其余模块换数据即可复用。</li>
          <li>缺的是「跨章节关系」：并发与 JVM、集合与 MySQL 索引之间其实有线可画，等主线稳定再加。</li>
          <li>手机端不画图，直接给可折叠列表，58 题一样能翻完。</li>
        </ul>
      </div>
    </section>

    <p class="mt-10 text-[12px] text-ink3">
      数据全部来自 <a href="/notes" class="text-zhu hover:underline">题目库</a> 的 58 份 JSON：标题、评分、章节归属、摘要都是原字段，没有人工补写；
      均分与硬伤数的口径与 <a href="/review" class="text-zhu hover:underline">评审页</a> 一致。
    </p>
  </main>
</BaseLayout>
