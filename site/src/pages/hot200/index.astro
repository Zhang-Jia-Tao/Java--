---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { loadHot200ByCategory, loadHot200, DIFF_LABEL, DIFF_COLOR } from '../../lib/hot200';

const groups = loadHot200ByCategory();
const all = loadHot200();
const written = all.filter((q) => q.status === 'written').length;
const withCode = all.filter((q) => q.code.source).length;
---

<BaseLayout title="Hot200 手撕题 · Java 终极笔记" description="秋招手撕题：通俗讲解 + 思路默写自测">
  <SiteHeader />
  <main class="mx-auto max-w-[1100px] px-6 pb-24">
    <header class="border-b border-line pt-10 pb-7">
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">HOT 200 · 手撕</p>
      <h1 class="title-cn mt-3 text-[32px]">手撕题：先讲明白，再默写一遍</h1>
      <p class="mt-3 max-w-[46em] text-[13.5px] leading-relaxed text-ink3">
        {all.length} 题（第一期 4 个专题）· 已写讲解 {written} 题 · 判定方式是<strong class="text-ink2">思路对照</strong>不是判题机：
        变量名随便改、格式随便排，只要走的是同一条路就算过。
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2 text-[12px]" id="hot-filter">
        <button data-cat="all" class="fb chip border border-line bg-zhusoft text-zhu">全部 {all.length}</button>
        {groups.map((g) => (
          <button data-cat={g.category} class="fb chip border border-line text-ink2">{g.category} {g.items.length}</button>
        ))}
        <span class="mx-2 h-4 w-px bg-line"></span>
        <button data-only="todo" class="fd chip border border-line text-ink2">只看没写讲解</button>
      </div>
    </header>

    {groups.map((g) => (
      <section class="mt-10" data-group={g.category}>
        <div class="flex items-baseline justify-between border-b border-line pb-2">
          <h2 class="title-cn text-[18px]">{g.category}</h2>
          <span class="text-[12px] text-ink3">{g.items.length} 题</span>
        </div>
        <ul class="divide-y divide-line">
          {g.items.map((q) => (
            <li
              class="qrow"
              data-cat={q.category}
              data-status={q.status}
              data-diff={q.difficulty || 'none'}
            >
              <a href={`/hot200/${q.slug}`} class="group flex items-center gap-3 py-3">
                <span class="tabular w-14 shrink-0 font-mono text-[11.5px] text-ink3">
                  {q.lc ? '#' + q.lc : ''}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[14.5px] group-hover:text-zhu">
                    {q.title}{q.approach ? `（${q.approach}）` : ''}
                  </span>
                  <span class="mt-0.5 flex flex-wrap items-center gap-2 text-[11.5px] text-ink3">
                    {q.difficulty ? (
                      <span style={`color:${DIFF_COLOR[q.difficulty]}`}>{DIFF_LABEL[q.difficulty]}</span>
                    ) : null}
                    {q.tags.map((t) => (
                      <span class="text-zhu">{t}</span>
                    ))}
                    <span>{q.code.lines} 行代码</span>
                    {q.status === 'written' ? (
                      <span class="text-sa">讲解 + 默写就绪</span>
                    ) : q.status === 'pending-code' ? (
                      <span class="text-sd">原稿缺代码，待补</span>
                    ) : (
                      <span class="text-sd">讲解待写</span>
                    )}
                  </span>
                </span>
                <span class="shrink-0 text-[12px] text-ink3 opacity-0 transition-opacity group-hover:opacity-100">
                  进入 →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="mt-14 rounded-xl border border-dashed border-line px-6 py-6">
      <h2 class="text-[14px] font-semibold">这套自测是怎么判的</h2>
      <ul class="mt-3 space-y-2 text-[12.5px] leading-relaxed text-ink3">
        <li>
          <strong class="text-ink2">L1 思路指纹</strong>：3-4 道选择题，只问"用什么结构、存什么、什么时候动"，对应面试官让你口述思路。
        </li>
        <li>
          <strong class="text-ink2">L2 关键行挖空</strong>：挖掉"换成别的写法就错"的那几行，你填。忽略空格、分号、注释差异。
        </li>
        <li>
          <strong class="text-ink2">L3 整段默写（可选）</strong>：凭记忆写完整方法，引擎会先把变量名归一，再算
          0.5×结构顺序 + 0.35×关键手法 + 0.15×行数吻合，给"一致度"和逐行 diff。
        </li>
        <li>所有计算都在你的浏览器里，代码不上传；进度存 localStorage。判得不对可以点"我确实是这个思路"申诉。</li>
      </ul>
    </section>
  </main>

  <script is:inline>
    (() => {
      const rows = Array.from(document.querySelectorAll('.qrow'));
      const catBtns = Array.from(document.querySelectorAll('.fb'));
      const todoBtn = document.querySelector('.fd');
      let cat = 'all';
      let onlyTodo = false;
      const apply = () => {
        rows.forEach((r) => {
          const okCat = cat === 'all' || r.dataset.cat === cat;
          const okTodo = !onlyTodo || r.dataset.status !== 'written';
          r.style.display = okCat && okTodo ? '' : 'none';
        });
        document.querySelectorAll('[data-group]').forEach((s) => {
          const any = Array.from(s.querySelectorAll('.qrow')).some((r) => r.style.display !== 'none');
          s.style.display = any ? '' : 'none';
        });
      };
      catBtns.forEach((b) =>
        b.addEventListener('click', () => {
          cat = b.dataset.cat;
          catBtns.forEach((x) => {
            const on = x === b;
            x.classList.toggle('bg-zhusoft', on);
            x.classList.toggle('text-zhu', on);
            x.classList.toggle('text-ink2', !on);
          });
          apply();
        })
      );
      todoBtn?.addEventListener('click', () => {
        onlyTodo = !onlyTodo;
        todoBtn.classList.toggle('bg-zhusoft', onlyTodo);
        todoBtn.classList.toggle('text-zhu', onlyTodo);
        apply();
      });
    })();
  </script>
</BaseLayout>
