---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { loadHot200, DIFF_LABEL, DIFF_COLOR } from '../../../lib/hot200';
import { highlightJava } from '../../../lib/highlight';

export function getStaticPaths() {
  return loadHot200().map((q) => ({ params: { slug: q.slug }, props: { q } }));
}

const { q } = Astro.props;
const drills = q.drill ?? {};
const fps = drills.fingerprint ?? [];
const blanks = drills.blanks ?? [];
const refCode = q.code.source ?? '';
const codeLineArr = refCode.split('\n');

// 挖空渲染：把该行按答案切三段
const blankRows = blanks.map((b, idx) => {
  const line = codeLineArr[b.line - 1] ?? '';
  const at = line.indexOf(b.answer);
  return {
    idx,
    line: b.line,
    before: at >= 0 ? line.slice(0, at) : line,
    after: at >= 0 ? line.slice(at + b.answer.length) : '',
    found: at >= 0,
    prompt: b.prompt,
    answer: b.answer,
    why: b.why ?? ''
  };
});

const payload = {
  slug: q.slug,
  keyTokens: drills.keyTokens ?? [],
  refCode,
  blanks: blanks.map((b) => ({ line: b.line, answer: b.answer, why: b.why ?? '' })),
  fps: fps.map((f, i) => ({ q: f.q, answer: f.answer, why: f.why ?? '' }))
};
---

<BaseLayout title={`默写 · ${q.title} · Hot200`}>
  <SiteHeader />
  <main class="mx-auto max-w-[900px] px-6 pb-28">
    <nav class="pt-8 text-[12px] text-ink3">
      <a href="/hot200" class="hover:text-ink">Hot200</a>
      <span class="mx-1.5">/</span>
      <a href={`/hot200/${q.slug}`} class="hover:text-ink">{q.title}</a>
      <span class="mx-1.5">/</span>
      <span>默写</span>
    </nav>

    <header class="border-b border-line pb-6 pt-4">
      <div class="flex flex-wrap items-center gap-3 text-[11.5px] text-ink3">
        {q.lc ? <span class="font-mono">LeetCode {q.lc}</span> : null}
        <span>{q.category}</span>
        {q.difficulty ? <span style={`color:${DIFF_COLOR[q.difficulty]}`}>{DIFF_LABEL[q.difficulty]}</span> : null}
        <span>· 判的是思路，不是 AC</span>
      </div>
      <h1 class="title-cn mt-2 text-[28px]">{q.title}</h1>
      {q.explain?.oneLiner ? (
        <p class="mt-2 text-[13px] text-ink3">提示：{q.explain.oneLiner}</p>
      ) : null}
    </header>

    {fps.length === 0 && blanks.length === 0 ? (
      <div class="mt-8 rounded-xl border border-dashed border-line px-5 py-6 text-[13.5px] text-ink3">
        这道题的默写素材还没配好（讲解待写或原稿缺代码）。
        <a href={`/hot200/${q.slug}`} class="text-zhu hover:underline">先看讲解 →</a>
      </div>
    ) : null}

    <!-- L1 -->
    {fps.length ? (
      <section class="mt-10" id="step-1">
        <div class="flex items-baseline gap-3 border-b border-line pb-2">
          <span class="tabular rounded bg-zhusoft px-2 py-0.5 font-mono text-[11.5px] text-zhu">L1</span>
          <h2 class="title-cn text-[18px]">思路指纹</h2>
          <span class="text-[12px] text-ink3">{fps.length} 题 · 只问思路不问代码</span>
        </div>

        <ol class="mt-4 space-y-4">
          {fps.map((f, i) => (
            <li class="card px-5 py-4" data-fp={i}>
              <p class="text-[14px] font-medium">
                <span class="tabular mr-2 text-ink3">{i + 1}.</span>{f.q}
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                {f.options.map((opt, k) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-line px-3 py-2 text-[13px] text-ink2 transition-colors hover:border-zhu/40 has-[:checked]:border-zhu has-[:checked]:bg-zhusoft">
                    <input type="radio" name={`fp-${i}`} value={k} class="accent-[var(--c-zhu)]" />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
              <p class="fp-why mt-2 hidden text-[12.5px] leading-relaxed text-ink3"></p>
            </li>
          ))}
        </ol>

        <div class="mt-4 flex items-center gap-3">
          <button id="check-l1" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
            检查思路
          </button>
          <span id="l1-result" class="text-[13px] text-ink3"></span>
        </div>
      </section>
    ) : null}

    <!-- L2 -->
    {blanks.length ? (
      <section class="mt-12" id="step-2">
        <div class="flex items-baseline gap-3 border-b border-line pb-2">
          <span class="tabular rounded bg-zhusoft px-2 py-0.5 font-mono text-[11.5px] text-zhu">L2</span>
          <h2 class="title-cn text-[18px]">关键行挖空</h2>
          <span class="text-[12px] text-ink3">{blanks.length} 空 · 忽略空格与分号差异</span>
        </div>

        <div class="mt-4 space-y-3">
          {blankRows.map((b) => (
            <div class="code-panel px-4 py-3" data-blank={b.idx}>
              <div class="mb-1.5 flex items-baseline gap-2 text-[11.5px] text-ink3">
                <span class="font-mono text-zhu">L{b.line}</span>
                <span>{b.prompt}</span>
              </div>
              {b.found ? (
                <div class="overflow-x-auto whitespace-pre font-mono text-[12.5px] leading-[2]">
                  <span class="text-ink2">{b.before}</span>
                  <input
                    type="text"
                    class="blank-in mx-1 inline-block w-[min(420px,60%)]"
                    data-answer={b.answer}
                    data-idx={b.idx}
                    spellcheck="false"
                    placeholder="填这里"
                  />
                  <span class="text-ink2">{b.after}</span>
                </div>
              ) : (
                <p class="text-[12.5px] text-sd">（该空在原代码里定位失败，跳过）</p>
              )}
              <p class="blank-fb mt-1.5 hidden text-[12px] leading-relaxed"></p>
            </div>
          ))}
        </div>

        <div class="mt-4 flex items-center gap-3">
          <button id="check-l2" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
            检查填空
          </button>
          <button id="reveal-l2" class="rounded-lg border border-line px-4 py-2 text-[13px] text-ink2 hover:text-ink">
            看答案
          </button>
          <span id="l2-result" class="text-[13px] text-ink3"></span>
        </div>
      </section>
    ) : null}

    <!-- L3 -->
    <section class="mt-12" id="step-3">
      <div class="flex items-baseline gap-3 border-b border-line pb-2">
        <span class="tabular rounded bg-surface2 px-2 py-0.5 font-mono text-[11.5px] text-ink3">L3</span>
        <h2 class="title-cn text-[18px]">整段默写<span class="ml-2 text-[12px] font-normal text-ink3">可选挑战</span></h2>
        <span class="text-[12px] text-ink3">凭记忆写完整方法，变量名随便起</span>
      </div>

      <details class="mt-4 rounded-lg border border-line px-4 py-3 text-[13px]">
        <summary class="cursor-pointer text-ink3 hover:text-ink">忘了？点开看参考代码（看过不计入连续通关）</summary>
        <pre class="mt-3 max-h-[340px] overflow-auto font-mono text-[12px] leading-[1.8] text-ink2">{refCode}</pre>
      </details>

      <textarea
        id="l3-input"
        class="mt-3 h-[320px] w-full resize-y rounded-xl border border-line bg-surface2 px-4 py-3 font-mono text-[12.5px] leading-[1.8] text-ink"
        spellcheck="false"
        placeholder={'class Solution {\n    public int[] method(...) {\n        // 凭记忆写，变量名不用和参考解一样\n    }\n}'}
      ></textarea>

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button id="check-l3" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
          判一下思路一致度
        </button>
        <button id="clear-l3" class="rounded-lg border border-line px-4 py-2 text-[13px] text-ink2 hover:text-ink">
          清空
        </button>
        <span class="text-[11.5px] text-ink3">只在本地计算，不上传</span>
      </div>

      <div id="l3-result" class="mt-4 hidden">
        <div class="flex flex-wrap items-center gap-5 rounded-xl border border-line bg-surface px-5 py-4">
          <div>
            <p class="text-[11px] uppercase tracking-wider text-ink3">思路一致度</p>
            <p id="l3-score" class="tabular text-[32px] font-semibold leading-none"></p>
          </div>
          <div id="l3-verdict" class="text-[13px] leading-relaxed"></div>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <p class="text-[12px] text-ink3">结构顺序 <span id="bar-s1" class="tabular text-ink2"></span></p>
          <p class="text-[12px] text-ink3">关键手法 <span id="bar-s2" class="tabular text-ink2"></span></p>
        </div>
        <div id="l3-missing" class="mt-2 text-[12px] text-ink3"></div>
        <div id="l3-diff" class="mt-3 space-y-1"></div>
        <div class="mt-3 flex items-center gap-3">
          <button id="appeal" class="hidden rounded-lg border border-line px-3 py-1.5 text-[12px] text-ink2 hover:text-ink">
            我确实是这个思路（记为误判）
          </button>
          <span id="appeal-note" class="hidden text-[12px] text-sa"></span>
        </div>
      </div>
    </section>

    <p class="mt-14 text-[11.5px] leading-relaxed text-ink3">
      判定口径：先把变量名按出现顺序归一、去掉注释与字符串内容，再算
      <span class="text-ink2">0.50×结构顺序 + 0.35×关键手法命中 + 0.15×行数吻合</span>。
      所以"你把 left/right 换成 l/r"不影响分数，"你换了另一种解法"会被判成偏离——这正是我们想要的效果。
    </p>
  </main>

  <script type="application/json" id="drill-data" set:html={JSON.stringify(payload)} />
  <script>
    import { judge, sameCodeAnswer } from '../../../lib/drill';

    const dataEl = document.getElementById('drill-data');
    const data = JSON.parse(dataEl?.textContent || '{}');
    const storeKey = 'hot200:prog:' + data.slug;

    const loadProg = () => {
      try {
        return JSON.parse(localStorage.getItem(storeKey) || '{}');
      } catch {
        return {};
      }
    };
    const saveProg = (patch) => {
      const p = { ...loadProg(), ...patch, updatedAt: Date.now() };
      try {
        localStorage.setItem(storeKey, JSON.stringify(p));
      } catch {}
      return p;
    };

    /* ---------- L1 ---------- */
    const l1Btn = document.getElementById('check-l1');
    l1Btn?.addEventListener('click', () => {
      let right = 0;
      const total = data.fps.length;
      data.fps.forEach((fp, i) => {
        const card = document.querySelector(`[data-fp="${i}"]`);
        const picked = card?.querySelector(`input[name="fp-${i}"]:checked`);
        const why = card?.querySelector('.fp-why');
        if (!picked) return;
        const ok = +picked.value === fp.answer;
        if (ok) right++;
        if (why) {
          why.classList.remove('hidden');
          why.innerHTML = '';
          const mark = document.createElement('span');
          mark.className = ok ? 'text-sa' : 'text-sd';
          mark.textContent = ok ? '✓ 对了。' : '✗ 不对。';
          why.appendChild(mark);
          const text = document.createElement('span');
          text.textContent = fp.why || '';
          why.appendChild(text);
        }
      });
      const res = document.getElementById('l1-result');
      if (res) {
        if (right === 0) res.textContent = '一题都没选';
        else if (right === total) res.textContent = `全对 ${right}/${total} —— 思路一致，可以直接进 L2`;
        else res.textContent = `答对 ${right}/${total} —— 错的题上方已给出理由，建议回讲解对应段落`;
      }
      if (right === total) saveProg({ l1: true });
    });

    /* ---------- L2 ---------- */
    const inputs = Array.from(document.querySelectorAll('.blank-in'));
    document.getElementById('check-l2')?.addEventListener('click', () => {
      let right = 0;
      inputs.forEach((inp) => {
        const answer = inp.dataset.answer || '';
        const ok = sameCodeAnswer(inp.value, answer);
        inp.dataset.ok = ok ? '1' : '0';
        if (ok) right++;
        const wrap = inp.closest('[data-blank]');
        const fb = wrap?.querySelector('.blank-fb');
        if (fb) {
          fb.classList.remove('hidden');
          fb.innerHTML = '';
          const b = data.blanks[+inp.dataset.idx];
          const head = document.createElement('span');
          head.className = ok ? 'text-sa' : 'text-sd';
          head.textContent = ok ? '✓ 对。' : `✗ 应为 ${answer}。`;
          fb.appendChild(head);
          if (b?.why) {
            const t = document.createElement('span');
            t.className = 'text-ink3';
            t.textContent = ' ' + b.why;
            fb.appendChild(t);
          }
        }
      });
      const res = document.getElementById('l2-result');
      if (res) res.textContent = `填对 ${right}/${inputs.length}`;
      if (right === inputs.length) saveProg({ l2: true });
    });

    document.getElementById('reveal-l2')?.addEventListener('click', () => {
      inputs.forEach((inp) => {
        inp.value = inp.dataset.answer || '';
        inp.dataset.ok = '1';
      });
      const res = document.getElementById('l2-result');
      if (res) res.textContent = '已填入答案（本次不计入通关）';
    });

    /* ---------- L3 ---------- */
    const l3Input = document.getElementById('l3-input');
    const savedL3 = loadProg().l3Draft;
    if (l3Input && savedL3) l3Input.value = savedL3;
    l3Input?.addEventListener('input', () => saveProg({ l3Draft: l3Input.value }));

    document.getElementById('clear-l3')?.addEventListener('click', () => {
      if (l3Input) l3Input.value = '';
      saveProg({ l3Draft: '' });
      document.getElementById('l3-result')?.classList.add('hidden');
    });

    document.getElementById('check-l3')?.addEventListener('click', () => {
      const code = l3Input?.value || '';
      if (code.trim().length < 20) {
        alert('至少写几行再来判吧');
        return;
      }
      const r = judge(code, data.refCode, data.keyTokens);
      const box = document.getElementById('l3-result');
      box?.classList.remove('hidden');

      const scoreEl = document.getElementById('l3-score');
      if (scoreEl) {
        scoreEl.textContent = r.score + '%';
        scoreEl.style.color = r.verdict === 'same' ? 'var(--c-a)' : r.verdict === 'close' ? 'var(--c-b)' : 'var(--c-d)';
      }

      const vEl = document.getElementById('l3-verdict');
      if (vEl) {
        const map = {
          same: ['思路一致', '结构和关键手法都对上了，剩下的是措辞差异。'],
          close: ['接近，但有缺口', '主干对了，红行是参考解里有、你没写出来的关键步骤。'],
          different: ['可能换思路了', '和参考解的结构差异较大。如果你用的是另一种解法，属于正常。']
        } as const;
        const [t, d] = map[r.verdict];
        vEl.innerHTML = `<p class="font-medium">${t}</p><p class="mt-1 text-ink3">${d}</p>`;
      }

      const s1 = document.getElementById('bar-s1');
      const s2 = document.getElementById('bar-s2');
      if (s1) s1.textContent = Math.round(r.s1 * 100) + '%';
      if (s2) s2.textContent = Math.round(r.s2 * 100) + '%';

      const miss = document.getElementById('l3-missing');
      if (miss) {
        miss.textContent = r.missing.length ? '没出现的关键手法：' + r.missing.join('、') : '';
      }

      const diff = document.getElementById('l3-diff');
      if (diff) {
        diff.innerHTML = '';
        const color: Record<string, string> = { hit: 'var(--c-a)', close: 'var(--c-b)', miss: 'var(--c-d)' };
        const mark: Record<string, string> = { hit: '✓', close: '≈', miss: '✗' };
        r.rows.forEach((row) => {
          const p = document.createElement('div');
          p.className = 'flex gap-2 font-mono text-[11.5px] leading-relaxed';
          p.style.color = color[row.state] || 'var(--c-ink-3)';
          p.textContent = `${mark[row.state] || ''} L${String(row.line).padStart(2, '0')}  ${row.text}`;
          diff.appendChild(p);
        });
        if (r.extraCount > 0) {
          const extra = document.createElement('p');
          extra.className = 'mt-1 text-[11.5px] text-ink3';
          extra.textContent = `你多写了 ${r.extraCount} 个记号（可能是你自己的写法，不一定是错）`;
          diff.appendChild(extra);
        }
      }

      const appeal = document.getElementById('appeal');
      appeal?.classList.toggle('hidden', r.verdict !== 'different');

      saveProg({ l3: r.score, verdict: r.verdict, lastAt: Date.now() });
    });

    document.getElementById('appeal')?.addEventListener('click', () => {
      const note = document.getElementById('appeal-note');
      if (note) {
        note.classList.remove('hidden');
        note.textContent = '已记为误判样本，本次按通过计算';
      }
      saveProg({ l3: 100, verdict: 'same', appealed: true });
    });
  </script>
</BaseLayout>
