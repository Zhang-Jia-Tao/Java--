---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { loadHot200, DIFF_LABEL, DIFF_COLOR } from '../../../lib/hot200';
import { highlightJava } from '../../../lib/highlight';
import { buildFrame } from '../../../lib/frame';

export function getStaticPaths() {
  return loadHot200().map((q) => ({ params: { slug: q.slug }, props: { q } }));
}

const { q } = Astro.props;
const drills = q.drill ?? {};
const fps = drills.fingerprint ?? [];
const blanks = drills.blanks ?? [];
const refCode = q.code.source ?? '';
const codeLineArr = refCode.split('\n');

// L3 骨架：类名/方法签名/收尾括号直接给，只默写方法体
const frame = buildFrame(refCode);
const headCode = frame.headText ? highlightJava(frame.headText) : [];
const tailCode = frame.tailText ? highlightJava(frame.tailText) : [];
const headCount = frame.headLines.length;

// 把一段源码高亮成 HTML（单行片段用）
const hl = (s: string) => highlightJava(s || ' ')[0]?.html ?? '';

// 挖空渲染：把该行按答案切三段，前后两段都上高亮
const blankRows = blanks.map((b, idx) => {
  const line = codeLineArr[b.line - 1] ?? '';
  const at = line.indexOf(b.answer);
  return {
    idx,
    line: b.line,
    beforeHtml: at >= 0 ? hl(line.slice(0, at)) : hl(line),
    afterHtml: at >= 0 ? hl(line.slice(at + b.answer.length)) : '',
    found: at >= 0,
    prompt: b.prompt,
    answer: b.answer,
    why: b.why ?? ''
  };
});

const payload = {
  slug: q.slug,
  keyTokens: drills.keyTokens ?? [],
  refCode,
  frame: { mode: frame.mode, headText: frame.headText, tailText: frame.tailText, headCount },
  blanks: blanks.map((b) => ({ line: b.line, answer: b.answer, why: b.why ?? '' })),
  fps: fps.map((f) => ({ q: f.q, answer: f.answer, why: f.why ?? '' }))
};
---

<BaseLayout title={`默写 · ${q.title} · Hot200`}>
  <SiteHeader />
  <main class="mx-auto max-w-[900px] px-6 pb-28">
    <nav class="pt-8 text-[12px] text-ink3">
      <a href="/hot200" class="hover:text-ink">Hot200</a>
      <span class="mx-1.5">/</span>
      <a href={`/hot200/${q.slug}`} class="hover:text-ink">{q.title}</a>
      <span class="mx-1.5">/</span>
      <span>默写</span>
    </nav>

    <header class="border-b border-line pb-6 pt-4">
      <div class="flex flex-wrap items-center gap-3 text-[11.5px] text-ink3">
        {q.lc ? <span class="font-mono">LeetCode {q.lc}</span> : null}
        <span>{q.category}</span>
        {q.difficulty ? <span style={`color:${DIFF_COLOR[q.difficulty]}`}>{DIFF_LABEL[q.difficulty]}</span> : null}
        <span>· 判的是思路，不是 AC</span>
      </div>
      <h1 class="title-cn mt-2 text-[28px]">{q.title}</h1>
      {q.explain?.oneLiner ? <p class="mt-2 text-[13px] text-ink3">提示：{q.explain.oneLiner}</p> : null}
    </header>

    {fps.length === 0 && blanks.length === 0 ? (
      <div class="mt-8 rounded-xl border border-dashed border-line px-5 py-6 text-[13.5px] text-ink3">
        这道题的默写素材还没配好（讲解待写或原稿缺代码）。
        <a href={`/hot200/${q.slug}`} class="text-zhu hover:underline">先看讲解 →</a>
      </div>
    ) : null}

    <!-- L1 -->
    {fps.length ? (
      <section class="mt-10" id="step-1">
        <div class="flex flex-wrap items-baseline gap-3 border-b border-line pb-2">
          <span class="tabular rounded bg-zhusoft px-2 py-0.5 font-mono text-[11.5px] text-zhu">L1</span>
          <h2 class="title-cn text-[18px]">思路指纹</h2>
          <span class="text-[12px] text-ink3">{fps.length} 题 · 只问思路不问代码</span>
        </div>

        <ol class="mt-4 space-y-4">
          {fps.map((f, i) => (
            <li class="card px-5 py-4" data-fp={i}>
              <p class="text-[14px] font-medium">
                <span class="tabular mr-2 text-ink3">{i + 1}.</span>{f.q}
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                {f.options.map((opt, k) => (
                  <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-line px-3 py-2 text-[13px] text-ink2 transition-colors hover:border-zhu/40 has-[:checked]:border-zhu has-[:checked]:bg-zhusoft">
                    <input type="radio" name={`fp-${i}`} value={k} class="accent-[var(--c-zhu)]" />
                    <span>{opt}</span>
                  </label>
                ))}
              </div>
              <p class="fp-why mt-2 hidden text-[12.5px] leading-relaxed text-ink3"></p>
            </li>
          ))}
        </ol>

        <div class="mt-4 flex items-center gap-3">
          <button id="check-l1" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
            检查思路
          </button>
          <span id="l1-result" class="text-[13px] text-ink3"></span>
        </div>
      </section>
    ) : null}

    <!-- L2 -->
    {blanks.length ? (
      <section class="mt-12" id="step-2">
        <div class="flex flex-wrap items-baseline gap-3 border-b border-line pb-2">
          <span class="tabular rounded bg-zhusoft px-2 py-0.5 font-mono text-[11.5px] text-zhu">L2</span>
          <h2 class="title-cn text-[18px]">关键行挖空</h2>
          <span class="text-[12px] text-ink3">{blanks.length} 空 · 忽略空格与分号差异</span>
        </div>

        <div class="mt-4 space-y-3">
          {blankRows.map((b) => (
            <div class="code-panel px-4 py-3" data-blank={b.idx}>
              <div class="mb-1.5 flex items-baseline gap-2 text-[11.5px] text-ink3">
                <span class="font-mono text-zhu">L{b.line}</span>
                <span>{b.prompt}</span>
              </div>
              {b.found ? (
                <div class="overflow-x-auto whitespace-pre font-mono text-[12.5px] leading-[2]">
                  <span set:html={b.beforeHtml} />
                  <input
                    type="text"
                    class="blank-in mx-1 inline-block w-[min(420px,60%)] align-middle"
                    data-answer={b.answer}
                    data-idx={b.idx}
                    spellcheck="false"
                    placeholder="填这里"
                  />
                  <span set:html={b.afterHtml} />
                </div>
              ) : (
                <p class="text-[12.5px] text-sd">（该空在原代码里定位失败，跳过）</p>
              )}
              <p class="blank-fb mt-1.5 hidden text-[12px] leading-relaxed"></p>
            </div>
          ))}
        </div>

        <div class="mt-4 flex items-center gap-3">
          <button id="check-l2" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
            检查填空
          </button>
          <button id="reveal-l2" class="rounded-lg border border-line px-4 py-2 text-[13px] text-ink2 hover:text-ink">
            看答案
          </button>
          <span id="l2-result" class="text-[13px] text-ink3"></span>
        </div>
      </section>
    ) : null}

    <!-- L3 -->
    <section class="mt-12" id="step-3">
      <div class="flex flex-wrap items-baseline gap-3 border-b border-line pb-2">
        <span class="tabular rounded bg-surface2 px-2 py-0.5 font-mono text-[11.5px] text-ink3">L3</span>
        <h2 class="title-cn text-[18px]">默写核心代码</h2>
        <span class="text-[12px] text-ink3">类名和方法签名已给出，只写方法体</span>
      </div>

      {frame.mode === 'body' ? (
        <>
          <p class="mt-3 text-[12.5px] leading-relaxed text-ink3">
            虚框里的内容<strong class="text-ink2">不用背</strong>，你要写的是中间那 {frame.bodyLines} 行左右的核心逻辑。
            行号连续、缩进已自动对好：回车跟着上一行的层级走，行尾打 <code class="font-mono text-[11.5px]">{</code> 会自动多一层，行首打 <code class="font-mono text-[11.5px]">}</code> 自动退回来。变量名可以随便起，缩进错一点也不扣分。
          </p>

          <div class="mt-3 overflow-hidden rounded-t-[10px] border border-b-0 border-line bg-surface2/50 pt-2">
            {headCode.map((l) => (
              <div
                class="code-line"
                data-line={l.n}
                set:html={`<span class="ln">${l.n}</span><span class="lc">${l.html}</span>`}
              />
            ))}
          </div>

          <div class="code-edit rounded-none border-t-0 border-b-0">
            <div class="ed-gutter" id="ed-gutter"><div>1</div></div>
            <div class="ed-wrap">
              <pre class="ed-highlight" id="ed-highlight" aria-hidden="true"></pre>
              <textarea
                id="l3-input"
                class="ed-input"
                spellcheck="false"
                wrap="off"
                rows="12"
                placeholder={'        // 从这里开始写方法体'}
              ></textarea>
            </div>
          </div>

          <div class="overflow-hidden rounded-b-[10px] border border-t-0 border-line bg-surface2/50 pb-2" id="tail-frame">
            {tailCode.map((l, i) => (
              <div class="code-line" data-line={headCount + i + 1}>
                <span class="ln" data-tail={i}>{headCount + i + 1}</span>
                <span class="lc" set:html={l.html} />
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="code-edit mt-3 py-2">
          <div class="ed-gutter" id="ed-gutter"><div>1</div></div>
          <div class="ed-wrap">
            <pre class="ed-highlight" id="ed-highlight" aria-hidden="true"></pre>
            <textarea
              id="l3-input"
              class="ed-input"
              spellcheck="false"
              wrap="off"
              rows="16"
              placeholder={'class Solution {\n    // 凭记忆写，变量名不用和参考解一样\n}'}
            ></textarea>
          </div>
        </div>
      )}

      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button id="check-l3" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white hover:opacity-90">
          判一下思路一致度
        </button>
        <button id="clear-l3" class="rounded-lg border border-line px-4 py-2 text-[13px] text-ink2 hover:text-ink">
          清空
        </button>
        <span class="text-[11.5px] text-ink3">只在本地计算，不上传</span>
      </div>

      <details class="mt-4 rounded-lg border border-line px-4 py-3 text-[13px]">
        <summary class="cursor-pointer text-ink3 hover:text-ink">
          忘了？看完整参考代码（看过不计入连续通关）
        </summary>
        <pre class="snippet mt-3 max-h-[340px] overflow-auto text-[12px]">{refCode}</pre>
      </details>

      <div id="l3-result" class="mt-4 hidden">
        <div class="flex flex-wrap items-center gap-5 rounded-xl border border-line bg-surface px-5 py-4">
          <div>
            <p class="text-[11px] uppercase tracking-wider text-ink3">思路一致度</p>
            <p id="l3-score" class="tabular text-[32px] font-semibold leading-none"></p>
          </div>
          <div id="l3-verdict" class="text-[13px] leading-relaxed"></div>
        </div>
        <div class="mt-3 flex flex-wrap gap-6">
          <p class="text-[12px] text-ink3">结构顺序 <span id="bar-s1" class="tabular text-ink2"></span></p>
          <p class="text-[12px] text-ink3">关键手法 <span id="bar-s2" class="tabular text-ink2"></span></p>
        </div>
        <div id="l3-missing" class="mt-2 text-[12px] text-ink3"></div>
        <div id="l3-diff" class="mt-3 space-y-1"></div>
        <div class="mt-3 flex items-center gap-3">
          <button id="appeal" class="hidden rounded-lg border border-line px-3 py-1.5 text-[12px] text-ink2 hover:text-ink">
            我确实是这个思路（记为误判）
          </button>
          <span id="appeal-note" class="hidden text-[12px] text-sa"></span>
        </div>
      </div>
    </section>

    <p class="mt-14 text-[11.5px] leading-relaxed text-ink3">
      判定口径：先按 token 序列归一化（变量名按首次出现顺序改名、数字归成 N、注释与字符串内容抹掉），
      再算 <span class="text-ink2">0.50×结构顺序 + 0.35×关键手法命中 + 0.15×篇幅吻合</span>。
      所以"left/right 换成 l/r""整个方法压成一行"都不掉分；"换了另一种解法"会被指出来。
      关键手法没凑齐时，最高只判"接近"。
    </p>
  </main>

  <script type="application/json" id="drill-data" set:html={JSON.stringify(payload)} />
  <script>
    import { judge, sameCodeAnswer } from '../../../lib/drill';
    import { highlightJava } from '../../../lib/highlight';

    const dataEl = document.getElementById('drill-data');
    const data = JSON.parse(dataEl?.textContent || '{}');
    const storeKey = 'hot200:prog:' + data.slug;
    const headCount: number = data.frame?.headCount ?? 0;

    const loadProg = () => {
      try {
        return JSON.parse(localStorage.getItem(storeKey) || '{}');
      } catch {
        return {};
      }
    };
    const saveProg = (patch: Record<string, unknown>) => {
      const p = { ...loadProg(), ...patch, updatedAt: Date.now() };
      try {
        localStorage.setItem(storeKey, JSON.stringify(p));
      } catch {}
      return p;
    };

    /* ---------- L1 ---------- */
    document.getElementById('check-l1')?.addEventListener('click', () => {
      let right = 0;
      const total = data.fps.length;
      data.fps.forEach((fp: any, i: number) => {
        const card = document.querySelector(`[data-fp="${i}"]`);
        const picked = card?.querySelector(`input[name="fp-${i}"]:checked`) as HTMLInputElement | null;
        const why = card?.querySelector('.fp-why') as HTMLElement | null;
        if (!picked) return;
        const ok = Number(picked.value) === fp.answer;
        if (ok) right++;
        if (why) {
          why.classList.remove('hidden');
          why.innerHTML = '';
          const mark = document.createElement('span');
          mark.className = ok ? 'text-sa' : 'text-sd';
          mark.textContent = ok ? '✓ 对了。' : '✗ 不对。';
          why.appendChild(mark);
          const text = document.createElement('span');
          text.textContent = fp.why || '';
          why.appendChild(text);
        }
      });
      const res = document.getElementById('l1-result');
      if (res) {
        if (right === 0) res.textContent = '一题都没选';
        else if (right === total) res.textContent = `全对 ${right}/${total} —— 思路一致，可以直接进 L2`;
        else res.textContent = `答对 ${right}/${total} —— 错的题上方已给出理由，建议回讲解对应段落`;
      }
      if (right === total) saveProg({ l1: true });
    });

    /* ---------- L2 ---------- */
    const inputs = Array.from(document.querySelectorAll('.blank-in')) as HTMLInputElement[];
    document.getElementById('check-l2')?.addEventListener('click', () => {
      let right = 0;
      inputs.forEach((inp) => {
        const answer = inp.dataset.answer || '';
        const ok = sameCodeAnswer(inp.value, answer);
        inp.dataset.ok = ok ? '1' : '0';
        if (ok) right++;
        const wrap = inp.closest('[data-blank]');
        const fb = wrap?.querySelector('.blank-fb') as HTMLElement | null;
        if (fb) {
          fb.classList.remove('hidden');
          fb.innerHTML = '';
          const b = data.blanks[Number(inp.dataset.idx)];
          const head = document.createElement('span');
          head.className = ok ? 'text-sa' : 'text-sd';
          head.textContent = ok ? '✓ 对。' : `✗ 应为 ${answer}。`;
          fb.appendChild(head);
          if (b?.why) {
            const t = document.createElement('span');
            t.className = 'text-ink3';
            t.textContent = ' ' + b.why;
            fb.appendChild(t);
          }
        }
      });
      const res = document.getElementById('l2-result');
      if (res) res.textContent = `填对 ${right}/${inputs.length}`;
      if (right === inputs.length) saveProg({ l2: true });
    });

    document.getElementById('reveal-l2')?.addEventListener('click', () => {
      inputs.forEach((inp) => {
        inp.value = inp.dataset.answer || '';
        inp.dataset.ok = '1';
      });
      const res = document.getElementById('l2-result');
      if (res) res.textContent = '已填入答案（本次不计入通关）';
    });

    /* ---------- L3 编辑器：高亮层 + 行号栏，和输入层逐行对齐 ---------- */
    const l3Input = document.getElementById('l3-input') as HTMLTextAreaElement | null;
    const hlLayer = document.getElementById('ed-highlight');
    const gutter = document.getElementById('ed-gutter');
    const tailFrame = document.getElementById('tail-frame');

    const paint = () => {
      if (!l3Input) return;
      const lines = highlightJava(l3Input.value);

      if (hlLayer) {
        hlLayer.innerHTML = lines.map((l) => `<div>${l.html}</div>`).join('') + '<div>&nbsp;</div>';
      }
      if (gutter) {
        const n = Math.max(lines.length, 1);
        gutter.innerHTML = Array.from({ length: n }, (_, i) => `<div>${headCount + i + 1}</div>`).join('');
      }
      // 骨架尾部行号跟着输入行数走，整段代码的行号保持连续
      if (tailFrame) {
        const start = headCount + Math.max(lines.length, 1) + 1;
        tailFrame.querySelectorAll<HTMLElement>('[data-tail]').forEach((el, i) => {
          el.textContent = String(start + i);
        });
      }
    };

    const syncScroll = () => {
      if (!l3Input) return;
      if (hlLayer) {
        hlLayer.scrollTop = l3Input.scrollTop;
        hlLayer.scrollLeft = l3Input.scrollLeft;
      }
      if (gutter) gutter.scrollTop = l3Input.scrollTop;
    };

    // 方法体应有的基础缩进：骨架最后一行（方法签名）的缩进 + 一个 tab
    const headText: string = (data.frame && data.frame.headText) || '';
    const lastHeadLine = headText.split('\n').filter((l: string) => l.trim()).pop() || '';
    const headIndent = (lastHeadLine.match(/^[ \t]*/) || [''])[0];
    const baseIndent = lastHeadLine ? headIndent + '    ' : '    ';

    if (l3Input) {
      const savedL3 = (loadProg().l3Draft as string | undefined) ?? '';
      // 没有草稿时，先把方法体的缩进填好，光标一开始就落在该写的地方
      l3Input.value = savedL3.trim() ? savedL3 : baseIndent;
      paint();
      if (!savedL3.trim()) l3Input.setSelectionRange(l3Input.value.length, l3Input.value.length);

      const onChange = () => {
        paint();
        syncScroll();
        saveProg({ l3Draft: l3Input.value });
      };
      const indentOf = (line: string) => (line.match(/^[ \t]*/) || [''])[0];
      const lineStartAt = (pos: number) => l3Input.value.lastIndexOf('\n', pos - 1) + 1;

      // 第一次点进来时如果光标落在 0，挪到方法体缩进之后
      l3Input.addEventListener('focus', function once() {
        l3Input.removeEventListener('focus', once);
        if (l3Input.selectionStart === 0 && l3Input.selectionEnd === 0) {
          const p = indentOf(l3Input.value).length;
          l3Input.setSelectionRange(p, p);
        }
      });

      l3Input.addEventListener('input', (ev) => {
        // 行首敲 } 自动回退一层，和代码编辑器一致
        const e = ev as InputEvent;
        if (e.inputType === 'insertText' && e.data === '}') {
          const pos = l3Input.selectionStart;
          const lineStart = lineStartAt(pos);
          const before = l3Input.value.slice(lineStart, pos - 1);
          if (/^[ \t]+$/.test(before) && before.length >= 4) {
            const from = lineStart + before.length - 4;
            l3Input.setRangeText('', from, from + 4, 'preserve');
            l3Input.setSelectionRange(pos - 4, pos - 4);
          }
        }
        onChange();
      });

      l3Input.addEventListener('scroll', syncScroll, { passive: true });

      l3Input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const pos = l3Input.selectionStart;
          const selEnd = l3Input.selectionEnd;
          const value = l3Input.value;
          const lineStart = lineStartAt(pos);
          const lineEnd = value.indexOf('\n', pos) === -1 ? value.length : value.indexOf('\n', pos);
          const before = value.slice(lineStart, pos);
          const after = value.slice(pos, lineEnd);
          const indent = indentOf(value.slice(lineStart, lineEnd));
          const opens = /\{\s*$/.test(before);
          const closesNext = /^[ \t]*[})]/.test(after);

          let insert: string;
          let caret: number;
          if (opens && closesNext) {
            // 空块 {|} → 光标退到中间那行，右括号让到下一行
            insert = '\n' + indent + '    ' + '\n' + indent;
            caret = pos + 1 + indent.length + 4;
          } else if (opens) {
            insert = '\n' + indent + '    ';
            caret = pos + insert.length;
          } else if (closesNext) {
            insert = '\n' + indent.slice(0, Math.max(0, indent.length - 4));
            caret = pos + insert.length;
          } else {
            insert = '\n' + indent;
            caret = pos + insert.length;
          }
          l3Input.setRangeText(insert, pos, selEnd, 'preserve');
          l3Input.setSelectionRange(caret, caret);
          onChange();
          return;
        }

        if (e.key === 'Tab') {
          e.preventDefault();
          const value = l3Input.value;
          const start = l3Input.selectionStart;
          const en = l3Input.selectionEnd;

          // 选中多行 → 整块缩进 / 反缩进
          if (start !== en && value.slice(start, en).includes('\n')) {
            const blockStart = lineStartAt(start + 1);
            const blockEnd = value.indexOf('\n', en) === -1 ? value.length : value.indexOf('\n', en);
            const lines = value.slice(blockStart, blockEnd).split('\n');
            const next = (e.shiftKey ? lines.map((l) => l.replace(/^ {1,4}/, '')) : lines.map((l) => '    ' + l)).join('\n');
            l3Input.setRangeText(next, blockStart, blockEnd, 'preserve');
            l3Input.setSelectionRange(blockStart, blockStart + next.length);
            onChange();
            return;
          }

          if (e.shiftKey) {
            const lineStart = lineStartAt(start);
            const cut = Math.min(4, indentOf(value.slice(lineStart, start)).length);
            if (cut > 0) {
              l3Input.setRangeText('', lineStart, lineStart + cut, 'preserve');
              l3Input.setSelectionRange(start - cut, en - cut);
              onChange();
            }
            return;
          }

          l3Input.setRangeText('    ', start, en, 'end');
          onChange();
        }
      });
    }

    document.getElementById('clear-l3')?.addEventListener('click', () => {
      if (l3Input) {
        l3Input.value = baseIndent;
        l3Input.setSelectionRange(baseIndent.length, baseIndent.length);
        paint();
        saveProg({ l3Draft: baseIndent });
      }
      document.getElementById('l3-result')?.classList.add('hidden');
    });

    document.getElementById('check-l3')?.addEventListener('click', () => {
      const body = l3Input?.value || '';
      if (body.trim().length < 10) {
        alert('至少写几行再来判吧');
        return;
      }
      // 把骨架拼回去再判，这样"只写方法体"也能算结构分
      const f = data.frame || { mode: 'whole', headText: '', tailText: '' };
      const full =
        f.headText || f.tailText
          ? [f.headText, body, f.tailText].filter((s: string) => s && s.trim()).join('\n')
          : body;

      const r = judge(full, data.refCode, data.keyTokens);
      const box = document.getElementById('l3-result');
      box?.classList.remove('hidden');

      const scoreEl = document.getElementById('l3-score');
      if (scoreEl) {
        scoreEl.textContent = r.score + '%';
        scoreEl.style.color = r.verdict === 'same' ? 'var(--c-a)' : r.verdict === 'close' ? 'var(--c-b)' : 'var(--c-d)';
      }

      const vEl = document.getElementById('l3-verdict');
      if (vEl) {
        const map: Record<string, [string, string]> = {
          same: ['思路一致', '结构和关键手法都对上了，剩下的是措辞差异。'],
          close: ['接近，但有缺口', '主干对了，红行是参考解里有、你没写出来的关键步骤。'],
          different: ['可能换思路了', '和参考解的结构差异较大。如果你用的是另一种解法，属于正常。']
        };
        const [t, d] = map[r.verdict];
        vEl.innerHTML = `<p class="font-medium">${t}</p><p class="mt-1 text-ink3">${d}</p>`;
      }

      const s1 = document.getElementById('bar-s1');
      const s2 = document.getElementById('bar-s2');
      if (s1) s1.textContent = Math.round(r.s1 * 100) + '%';
      if (s2) s2.textContent = Math.round(r.s2 * 100) + '%';

      const miss = document.getElementById('l3-missing');
      if (miss) miss.textContent = r.missing.length ? '没出现的关键手法：' + r.missing.join('、') : '';

      const diff = document.getElementById('l3-diff');
      if (diff) {
        diff.innerHTML = '';
        const color: Record<string, string> = { hit: 'var(--c-a)', close: 'var(--c-b)', miss: 'var(--c-d)' };
        const mark: Record<string, string> = { hit: '✓', close: '≈', miss: '✗' };
        r.rows.forEach((row: any) => {
          const p = document.createElement('div');
          p.className = 'flex gap-2 font-mono text-[11.5px] leading-relaxed';
          p.style.color = color[row.state] || 'var(--c-ink-3)';
          p.textContent = `${mark[row.state] || ''} L${String(row.line).padStart(2, '0')}  ${row.text}`;
          diff.appendChild(p);
        });
        if (r.extraCount > 0) {
          const extra = document.createElement('p');
          extra.className = 'mt-1 text-[11.5px] text-ink3';
          extra.textContent = `你多写了 ${r.extraCount} 个记号（可能是你自己的写法，不一定是错）`;
          diff.appendChild(extra);
        }
      }

      const appeal = document.getElementById('appeal');
      appeal?.classList.toggle('hidden', r.verdict !== 'different');

      saveProg({ l3: r.score, verdict: r.verdict, lastAt: Date.now() });
    });

    document.getElementById('appeal')?.addEventListener('click', () => {
      const note = document.getElementById('appeal-note');
      if (note) {
        note.classList.remove('hidden');
        note.textContent = '已记为误判样本，本次按通过计算';
      }
      saveProg({ l3: 100, verdict: 'same', appealed: true });
    });
  </script>
</BaseLayout>
