---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import overview from '../data/overview.json';
import chapters from '../data/chapters.json';
import { loadQuestions } from '../lib/questions';
import { loadHot200 } from '../lib/hot200';
import { aiStats, aiQuestions, projectOnlyStats } from '../lib/project';

const questions = loadQuestions();
const hot200All = loadHot200();
const hot200Total = hot200All.filter((q) => q.status === 'written').length;
const hot200Drill = hot200All.reduce(
  (s, q) => s + (q.drill?.fingerprint?.length ?? 0) + (q.drill?.blanks?.length ?? 0),
  0
);
const worst = [...questions].sort((a: any, b: any) => a.score.total - b.score.total).slice(0, 5);
const errorCount = questions.reduce((s: number, q: any) => s + (q.hardErrors?.length ?? 0), 0);
const ai = aiStats();
const pj = projectOnlyStats();
const aiPipes = aiQuestions.filter((q) => q.pipeline).length;
const aiFull = aiQuestions.filter((q) => q.fullAnswer).length;
---

<BaseLayout title="Java 终极笔记 · 58 题评审" description="58 道 Java 面试问答，逐题评分、硬伤与改法。">
  <SiteHeader />
  <main class="mx-auto max-w-[1280px] px-6 pb-24">
    <section class="border-b border-line py-16">
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">墨 · 朱 · 尺</p>
      <h1 class="title-cn mt-4 text-[38px] leading-[1.28] sm:text-[52px]">
        一份稿子最值钱的信息<br class="hidden sm:block" />
        不是正文，是它离满分差什么。
      </h1>
      <p class="mt-5 max-w-[36em] text-[15px] leading-[1.9] text-ink2">
        {questions.length} 道 Java 面试问答，先按 P8 面试官口径逐题评分，再把"原文 → 错在哪 → 怎么改"摊开。
        原文只是背景，批注才是主角。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`/notes/${worst[0]?.chapter}/${worst[0]?.id}`} class="rounded-lg bg-zhu px-5 py-2.5 text-[13.5px] font-medium text-white transition-opacity hover:opacity-90">
          从最低分 {worst[0]?.score.total} 分开始看 →
        </a>
        <a href="/notes" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          全部 {questions.length} 题
        </a>
        <a href="/roadmap" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          提分路线
        </a>
      </div>
    </section>

    <section class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none">{questions.length}</p>
        <p class="mt-2 text-[12.5px] text-ink3">题目总数</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none">{overview.avg}</p>
        <p class="mt-2 text-[12.5px] text-ink3">总平均分</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none text-sd">{overview.bands.perfect}</p>
        <p class="mt-2 text-[12.5px] text-ink3">满分 ≥96</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none text-zhu">{errorCount}</p>
        <p class="mt-2 text-[12.5px] text-ink3">硬伤条数</p>
      </div>
    </section>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <section>
        <h2 class="title-cn text-[22px]">章节强弱</h2>
        <p class="mt-2 text-[13px] text-ink3">JVM 是必答主科，72.0 分比"网络·常见 68.2"更危险。</p>
        <ul class="mt-6 space-y-3">
          {overview.chapterRank.map((c) => (
            <li class="flex items-center gap-4">
              <span class="w-24 shrink-0 text-[13.5px] text-ink2">{c.name}</span>
              <span class="h-2 flex-1 overflow-hidden rounded-full bg-surface2">
                <span
                  class="block h-full rounded-full"
                  style={`width: ${(c.avg / 100) * 100}%; background: ${c.avg >= 80 ? 'var(--c-a)' : c.avg >= 75 ? 'var(--c-c)' : 'var(--c-d)'}`}
                />
              </span>
              <span class="tabular w-12 shrink-0 text-right text-[13px] text-ink2">{c.avg}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="title-cn text-[22px]">最该先看的三题</h2>
        <p class="mt-2 text-[13px] text-ink3">分数最低，且缺口最"成块"——补起来收益最大。</p>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {worst.slice(0, 3).map((q: any) => (
            <li>
              <a href={`/notes/${q.chapter}/${q.id}`} class="group flex items-center gap-3 py-3">
                <span class="tabular w-12 shrink-0 font-mono text-[12px] text-ink3">{q.id}</span>
                <span class="min-w-0 flex-1 truncate text-[14px] group-hover:text-zhu">{q.title}</span>
                <span class="tabular shrink-0 text-[13px] text-sd">{q.score.total}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/errors" class="mt-4 inline-block text-[12.5px] text-zhu hover:underline">
          看全部 {errorCount} 条硬伤 →
        </a>
      </section>
    </div>

    <section class="mt-16">
      <a
        href="/hot200"
        class="group block rounded-xl border border-line bg-surface px-7 py-6 transition-colors hover:border-zhu/40"
      >
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">新 · HOT 200 手撕题</p>
            <h2 class="title-cn mt-2 text-[22px]">手撕题：先讲明白，再默写一遍</h2>
            <p class="mt-1.5 max-w-[42em] text-[13px] leading-relaxed text-ink3">
              滑动窗口 / 双指针 / 链表 / 二叉树 {hot200Total} 题，每题五段式讲解 + 三层默写自测。
              判的是"思路是否同一条路"——变量名随便改，换了另一种解法会指出来。
            </p>
          </div>
          <div class="flex items-center gap-8">
            <div>
              <p class="tabular text-[30px] font-semibold leading-none">{hot200Total}</p>
              <p class="mt-1 text-[11.5px] text-ink3">题已讲解</p>
            </div>
            <div>
              <p class="tabular text-[30px] font-semibold leading-none text-zhu">{hot200Drill}</p>
              <p class="mt-1 text-[11.5px] text-ink3">条判定题</p>
            </div>
            <span class="text-[13px] text-zhu opacity-60 transition-opacity group-hover:opacity-100">进入 →</span>
          </div>
        </div>
      </a>
    </section>


    <section class="mt-16">
      <a
        href="/ai"
        class="group block rounded-xl border border-line bg-surface px-7 py-6 transition-colors hover:border-qing/50"
        data-tone="qing"
      >
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-accent">新 · RAGENT AI 专区</p>
            <h2 class="title-cn mt-2 text-[22px]">AI 项目：七阶段流水线 + 意图树 + MCP</h2>
            <p class="mt-1.5 max-w-[44em] text-[13px] leading-relaxed text-ink3">
              AI 底座 / Ragent 项目题 / 评测体系三块共 {ai.total} 题，每题带源码锚点{aiPipes > 0 ? `、${aiPipes} 条流水线拆解` : ''}
              {aiFull > 0 ? `、${aiFull} 篇满分回答` : ''}；另有流水线点读、Prompt 解剖器、检索漏斗与术语表。
            </p>
          </div>
          <div class="flex items-center gap-8">
            <div>
              <p class="tabular text-[30px] font-semibold leading-none">{ai.total}</p>
              <p class="mt-1 text-[11.5px] text-ink3">AI 题</p>
            </div>
            <div>
              <p class="tabular text-[30px] font-semibold leading-none text-accent">{ai.avg}</p>
              <p class="mt-1 text-[11.5px] text-ink3">平均分</p>
            </div>
            <div>
              <p class="tabular text-[30px] font-semibold leading-none">{pj.total}</p>
              <p class="mt-1 text-[11.5px] text-ink3">项目题</p>
            </div>
            <span class="text-[13px] text-accent opacity-60 transition-opacity group-hover:opacity-100">进入 →</span>
          </div>
        </div>
      </a>
    </section>

    <section class="mt-16">
      <h2 class="title-cn text-[22px]">全部章节</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {chapters.map((c) => (
          <a href={`/notes/${c.key}`} class="card group px-5 py-5 transition-all hover:-translate-y-px hover:shadow-[var(--shadow-card-hover)]">
            <p class="text-[13.5px] font-medium">{c.name}</p>
            <p class="mt-0.5 text-[11.5px] text-ink3">{c.sub || String(c.count) + ' 题'}</p>
            <p class="tabular mt-3 text-[26px] font-semibold leading-none">{c.avg}</p>
            <p class="mt-1 text-[11.5px] text-ink3">{c.count} 题 · 最高 {c.max} / 最低 {c.min}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
