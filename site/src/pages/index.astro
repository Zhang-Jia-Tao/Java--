---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import chapters from '../data/chapters.json';
import { loadQuestions } from '../lib/questions';
import { loadHot200 } from '../lib/hot200';
import { stats } from '../lib/stats';
import { aiStats } from '../lib/project';
import { stats as internStats } from '../lib/intern';
import ModuleGraph from '../components/ModuleGraph.astro';

const questions = loadQuestions();
const hot200All = loadHot200();
const hot200Total = hot200All.filter((q: any) => q.status === 'written').length;
const hot200Drill = hot200All.reduce(
  (s: number, q: any) => s + (q.drill?.fingerprint?.length ?? 0) + (q.drill?.blanks?.length ?? 0),
  0
);
const ai = aiStats();
const s = stats;

const groupName = { java: 'Java 基础', project: '项目经历', ai: 'Ragent AI', train: '训练场' } as const;
const groups = (['java', 'project', 'ai', 'train'] as const).map((g) => ({
  key: g,
  name: groupName[g],
  ...(g === 'java' ? s.java : g === 'project' ? s.project : g === 'ai' ? s.ai : s.train),
  rows: s.moduleRows.filter((r) => r.group === g)
}));

const topWorst = s.worst.slice(0, 3);

/**
 * 今日复习的候选池：全库已评分题。
 * 只带渲染需要的字段，压成短键内联进页面，客户端按日期算队列、并叠加服务端的复习记录。
 */
const REVIEW_PER_DAY = 12;
const reviewPool = s.items
  .filter((i) => i.total > 0)
  .map((i) => ({ i: i.id, t: i.title, g: i.group, m: i.moduleName, h: i.href, s: i.total }))
  .sort((a, b) => a.s - b.s);
const reviewGroupName: Record<string, string> = {
  java: 'Java',
  project: '项目',
  db: 'MySQL',
  mw: '中间件',
  ai: 'AI',
  train: '训练场'
};
const docCount = 181;
---

<BaseLayout
  title={`面试笔记 · ${s.total} 题逐题评审与原文`}
  description={`${s.total} 道面试问答（Java 58 · 项目 70 · AI 38），逐题评分、硬伤、改法，外加 ${docCount} 篇原文全文。`}
>
  <SiteHeader />
  <main class="mx-auto max-w-[1280px] px-6 pb-24">
    <section class="border-b border-line py-16">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_452px]">
        <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">墨 · 朱 · 尺</p>
      <h1 class="title-cn mt-4 text-[36px] leading-[1.28] sm:text-[48px]">
        一份稿子最值钱的信息<br class="hidden sm:block" />
        不是正文，是它离满分差什么。
      </h1>
      <p class="mt-5 max-w-[38em] text-[15px] leading-[1.9] text-ink2">
        {s.total} 道面试问答——Java 基础 {s.java.count}、项目经历 {s.project.count}、MySQL {s.db.count}、中间件 {s.mw.count}、Ragent AI {s.ai.count}、训练场 {s.train.count}。
        每道题先按面试官口径评分、列出硬伤与改法，再拆成三层读：
        <strong class="text-ink">L1 背诵</strong>（一句话 + 60 秒）→
        <strong class="text-ink">L2 展开</strong>（深挖 + 满分回答）→
        <strong class="text-ink">L3 原文</strong>（{docCount} 篇全文，逐字保留）。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={topWorst[0]?.href} class="rounded-lg bg-zhu px-5 py-2.5 text-[13.5px] font-medium text-white transition-opacity hover:opacity-90">
          从最低分 {topWorst[0]?.total} 分开始看 →
        </a>
        <a href="/notes" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          Java {s.java.count} 题
        </a>
        <a href="/project" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          项目 {s.project.count} 题
        </a>
        <a href="/mysql" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          MySQL {s.db.count} 题
        </a>
        <a href="/mw" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          中间件 {s.mw.count} 题
        </a>
        <a href="/ai" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink" data-tone="qing">
          AI {s.ai.count} 题
        </a>
        <a href="/review#roadmap" class="rounded-lg border border-line px-5 py-2.5 text-[13.5px] text-ink2 transition-colors hover:text-ink">
          提分路线
        </a>
      </div>
        </div>
        <aside class="lg:pt-2">
          <div class="rounded-xl border border-line bg-surface px-4 pb-2 pt-3">
            <div class="flex items-baseline justify-between">
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">模块交互图</p>
              <span class="text-[10.5px] tracking-[0.14em] text-ink3">MODULE GRAPH</span>
            </div>
            <div id="module-graph-slot" class="mt-1">
              <ModuleGraph />
            </div>
          </div>
          <p class="mt-2 text-[11px] leading-relaxed text-ink3">
            节点之间是真实的引用关系：评审判出的硬伤回到基础章、项目的瓶颈落到 MySQL 与中间件、实习经历与项目互为佐证。
          </p>
        </aside>
      </div>
    </section>

    <section class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none">{s.total}</p>
        <p class="mt-2 text-[12.5px] text-ink3">题目总数 · 其中 {s.scored} 题已评分</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none">{s.avg}</p>
        <p class="mt-2 text-[12.5px] text-ink3">综合均分（满分 100）</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none text-sd">{s.bands[0].count}</p>
        <p class="mt-2 text-[12.5px] text-ink3">90 分以上</p>
      </div>
      <div class="bg-surface px-6 py-7">
        <p class="tabular text-[34px] font-semibold leading-none text-zhu">{s.hardErrors}</p>
        <p class="mt-2 text-[12.5px] text-ink3">硬伤条数（一/二/三级）</p>
      </div>
    </section>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <section>
        <h2 class="title-cn text-[22px]">评分分布</h2>
        <p class="mt-2 text-[13px] text-ink3">
          四档口径：90+ 可直接拿去面 · 85–89 小改 · 78–84 要补一两块 · 78 以下先别背。
          分数只做横向比较，同一题改完可以再评一次。中间件 {s.mw.count} 题已按重写后的三层口述稿逐题复评（Redis / RocketMQ / Kafka / Elasticsearch 四组，均分 {s.mw.avg}）；MySQL {s.db.count} 题的分仍是重写前的口径（均分 {s.db.avg}），与中间件不可直接比较，下一轮需按同样口径复评；训练场与各专区 AI 新增题暂不评分，不参与均分。
        </p>
        <ul class="mt-6 space-y-3">
          {s.bands.map((b) => (
            <li class="flex items-center gap-4">
              <span class="w-16 shrink-0 text-[13px] text-ink2">{b.label}</span>
              <span class="h-2 flex-1 overflow-hidden rounded-full bg-surface2">
                <span
                  class="block h-full rounded-full"
                  style={`width: ${s.scored ? (b.count / s.scored) * 100 : 0}%; background: ${b.key === 'great' ? 'var(--c-a)' : b.key === 'good' ? 'var(--c-c)' : b.key === 'pass' ? 'var(--c-d)' : 'var(--c-zhu)'}`}
                />
              </span>
              <span class="tabular w-10 shrink-0 text-right text-[13px] text-ink2">{b.count}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-[11.5px] text-ink3">
          硬伤分三级：{s.hardByLevel[0]} 条会被当场判定理解错 · {s.hardByLevel[1]} 条版本/口径过时 · {s.hardByLevel[2]} 条是承诺了没兑现的结构缺口。
        </p>
      </section>

      <section>
        <h2 class="title-cn text-[22px]">最该先看的三题</h2>
        <p class="mt-2 text-[13px] text-ink3">全库最低分，且缺口最成块——补起来收益最大。</p>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {topWorst.map((q) => (
            <li>
              <a href={q.href} class="group flex items-center gap-3 py-3">
                <span class="tabular w-12 shrink-0 font-mono text-[12px] text-ink3">{q.id}</span>
                <span class="min-w-0 flex-1 truncate text-[14px] group-hover:text-zhu">{q.title}</span>
                <span class="shrink-0 text-[11.5px] text-ink3">{q.moduleName}</span>
                <span class="tabular shrink-0 text-[13px] text-sd">{q.total}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/review#errors" class="mt-4 inline-block text-[12.5px] text-zhu hover:underline">
          看全部 {s.hardErrors} 条硬伤 →
        </a>
      </section>
    </div>

    <section class="mt-16" id="today-review">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div class="flex flex-wrap items-baseline gap-3">
          <h2 class="title-cn text-[22px]">今日复习</h2>
          <span class="text-[11.5px] text-ink3" id="review-date">全库已评分题 · 每天 {REVIEW_PER_DAY} 题</span>
        </div>
        <p class="text-[12px] text-ink3" id="review-progress">读取复习记录中…</p>
      </div>
      <p class="mt-2 max-w-[54em] text-[13px] leading-relaxed text-ink3">
        队列按分数从低到高排，每天往后挪 {REVIEW_PER_DAY} 位，同一模块最多 3 题——每天换一批，又不会 12 题全砸在一个模块里。
        点「已复习」把记录写到本地服务
        <code class="font-mono text-[12px]">site/server-data/review-log.json</code>，没起服务就只记在浏览器里。
      </p>
      <ol id="review-list" class="mt-5 divide-y divide-line border-y border-line"></ol>
      <script type="application/json" id="review-pool" set:html={JSON.stringify({ items: reviewPool, perDay: REVIEW_PER_DAY, groups: reviewGroupName })} />
      <script is:inline>
        (() => {
          const dataEl = document.getElementById('review-pool');
          const listEl = document.getElementById('review-list');
          const progEl = document.getElementById('review-progress');
          const dateEl = document.getElementById('review-date');
          if (!dataEl || !listEl || !progEl) return;

          let payload;
          try {
            payload = JSON.parse(dataEl.textContent || '{}');
          } catch {
            return;
          }
          const items = payload.items || [];
          const perDay = payload.perDay || 12;
          const GROUPS = payload.groups || {};
          if (!items.length) {
            listEl.innerHTML = '<li class="py-3 text-[13px] text-ink3">还没有已评分的题目，复习队列是空的。</li>';
            return;
          }

          const SYNC = 'http://127.0.0.1:4400';
          const LSK = 'review-log-v1';
          const DAY = 86400000;
          const now = new Date();
          const dayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
          const dayIndex = Math.floor(dayStart / DAY);
          const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
          if (dateEl) {
            dateEl.textContent = `${todayKey} · 每天 ${perDay} 题 · 候选 ${items.length} 题`;
          }

          let log = {};
          try {
            log = JSON.parse(localStorage.getItem(LSK) || '{}') || {};
          } catch {
            log = {};
          }

          /**
           * 今日队列（确定性，同一天刷新结果不变）：
           * 1) 没复习过的题优先，按分数从低到高；
           * 2) 只取最低分那一档（3 天量），再按天号轮换，保证每天换一批又不至于全是最低分；
           * 3) 复习过的题按时间从旧到新排在最后兜底；
           * 4) 同一模块最多 3 题。
           */
          const buildQueue = () => {
            const never = [];
            const older = [];
            for (const it of items) {
              const rec = log[it.i];
              if (rec && rec.at) older.push({ ...it, _at: rec.at });
              else never.push(it);
            }
            older.sort((a, b) => a._at - b._at);
            const bandSize = Math.min(never.length, perDay * 3);
            const band = never.slice(0, bandSize);
            const off = band.length ? (dayIndex * perDay) % band.length : 0;
            const rotated = [...band.slice(off), ...band.slice(0, off)];
            const bandIds = new Set(band.map((x) => x.i));
            const tail = never.filter((x) => !bandIds.has(x.i));
            const ordered = [...rotated, ...tail, ...older];

            const out = [];
            const cap = {};
            for (const it of ordered) {
              if (out.length >= perDay) break;
              const key = it.m || it.g || 'other';
              if ((cap[key] || 0) >= 3) continue;
              cap[key] = (cap[key] || 0) + 1;
              out.push(it);
            }
            return out;
          };

          let queue = buildQueue();
          let touched = false;

          const saveLocal = () => {
            try {
              localStorage.setItem(LSK, JSON.stringify(log));
            } catch {}
          };

          const doneToday = (id) => {
            const rec = log[id];
            return !!rec && rec.at >= dayStart;
          };

          const agoLabel = (at) => {
            if (!at) return '没复习过';
            const d = Math.round((Date.now() - at) / 60000);
            if (d < 1) return '刚刚';
            if (d < 60) return d + ' 分钟前';
            const h = Math.round(d / 60);
            if (h < 24) return h + ' 小时前';
            return Math.round(h / 24) + ' 天前';
          };

          const pushServer = (id, undo) => {
            const body = JSON.stringify({ id, at: Date.now(), undo: !!undo });
            fetch(`${SYNC}/api/review/log`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body
            }).catch(() => {});
          };

          const render = () => {
            const doneCount = queue.filter((q) => doneToday(q.i)).length;
            progEl.innerHTML =
              `<strong class="text-ink">${doneCount}/${queue.length}</strong> 已复习` +
              (doneCount === queue.length ? ' · 今天这批清完了' : '');
            progEl.style.color = doneCount === queue.length ? 'var(--c-a)' : '';

            listEl.innerHTML = queue
              .map((q) => {
                const done = doneToday(q.i);
                const rec = log[q.i];
                const tone = q.s >= 85 ? 'var(--c-a)' : q.s >= 78 ? 'var(--c-c)' : 'var(--c-d)';
                return (
                  `<li class="flex items-center gap-3 py-2.5 ${done ? 'opacity-55' : ''}" data-id="${q.i}">` +
                  `<span class="w-11 shrink-0 rounded-sm bg-surface2 py-0.5 text-center text-[10px] text-ink3">${GROUPS[q.g] || q.g || '—'}</span>` +
                  `<span class="tabular w-7 shrink-0 text-[12.5px]" style="color:${tone}">${q.s}</span>` +
                  `<a href="${q.h}" class="min-w-0 flex-1 truncate text-[13px] text-ink2 hover:text-ink" title="${q.t.replace(/"/g, '')}">${q.t}</a>` +
                  `<span class="hidden w-16 shrink-0 text-right text-[11px] text-ink3 sm:block">${done ? '今天已复习' : agoLabel(rec && rec.at)}</span>` +
                  `<button type="button" data-done="${q.i}" class="shrink-0 rounded-md border px-2 py-1 text-[11px] transition-colors ${
                    done
                      ? 'border-line text-ink3 hover:text-ink'
                      : 'border-zhu/40 text-zhu hover:bg-zhusoft/60'
                  }">${done ? '撤销' : '已复习'}</button>` +
                  `</li>`
                );
              })
              .join('');
          };

          listEl.addEventListener('click', (ev) => {
            const btn = ev.target.closest('[data-done]');
            if (!btn) return;
            touched = true;
            const id = btn.getAttribute('data-done');
            const undo = doneToday(id);
            if (undo) delete log[id];
            else log[id] = { at: Date.now(), ok: true };
            saveLocal();
            pushServer(id, undo);
            render();
          });

          render();

          // 合并服务端记录（跨浏览器一致）；服务没起就静默用本地
          fetch(`${SYNC}/api/review/log`)
            .then((r) => (r.ok ? r.json() : null))
            .then((remote) => {
              if (!remote || !remote.items) return;
              let changed = false;
              for (const [id, rec] of Object.entries(remote.items)) {
                if (!log[id] || (rec.at || 0) > (log[id].at || 0)) {
                  log[id] = rec;
                  changed = true;
                }
              }
              if (changed) {
                saveLocal();
                // 用户还没开始点就重算一遍队列（服务端记录会把复习过的题放到后面）
                if (!touched) queue = buildQueue();
                render();
              }
            })
            .catch(() => {});
        })();
      </script>
    </section>

    <section class="mt-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="title-cn text-[22px]">模块强弱</h2>
        <p class="text-[12px] text-ink3">{s.moduleRows.length} 个模块 · 按均分从高到低</p>
      </div>
      <div class="mt-6 grid gap-x-10 gap-y-2.5 lg:grid-cols-2">
        {[...s.moduleRows]
          .sort((a, b) => b.avg - a.avg)
          .map((m) => (
            <a href={m.href} class="group flex items-center gap-3">
              <span class="w-6 shrink-0 rounded-sm bg-surface2 py-0.5 text-center text-[10px] text-ink3">
                {m.group === 'java' ? 'J' : m.group === 'ai' ? 'A' : m.group === 'train' ? 'T' : m.group === 'db' ? 'D' : m.group === 'mw' ? 'M' : 'P'}
              </span>
              <span class="w-32 shrink-0 truncate text-[13px] text-ink2 group-hover:text-ink">{m.name}</span>
              <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-surface2">
                <span
                  class="block h-full rounded-full"
                  style={`width: ${(m.avg / 100) * 100}%; background: ${m.avg >= 88 ? 'var(--c-a)' : m.avg >= 83 ? 'var(--c-c)' : 'var(--c-d)'}`}
                />
              </span>
              <span class="tabular w-8 shrink-0 text-right text-[12.5px] text-ink2">{m.avg}</span>
              <span class="tabular w-14 shrink-0 text-right text-[11px] text-ink3">{m.count} 题</span>
            </a>
          ))}
      </div>
    </section>

    <section class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/notes" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">Java 基础</p>
        <p class="title-cn mt-2 text-[20px]">{s.java.count} 题 · 均分 {s.java.avg}</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">七章：集合 / 并发 / JVM / Spring / 语言基础 / 网络 / 操作系统，逐题评分 + 硬伤 + 改法。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/project" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">项目经历 · OneCoupon</p>
        <p class="title-cn mt-2 text-[20px]">{s.project.count} 题 · 均分 {s.project.avg}</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">分片 / 缓存 / MQ / 幂等 / 分布式 ID 等真实链路，每题源码锚点可查。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/intern" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">实习经历 · 两家公司</p>
        <p class="title-cn mt-2 text-[20px]">{internStats.tasks} 张任务卡 · {internStats.commits} 提交</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">需求 / 实现 / 缺陷返工逐块拆开，{internStats.defects} 起缺陷按根因归类，每张卡配三层口述稿。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/mysql" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">MySQL</p>
        <p class="title-cn mt-2 text-[20px]">{s.db.count} 题 · 未评分</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">基础 / 索引 / 事务 / 锁 / 日志 / 调优，六块主线一次讲透。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/mw" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">中间件</p>
        <p class="title-cn mt-2 text-[20px]">{s.mw.count} 题 · 未评分</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">Redis 与 RocketMQ：数据结构、缓存三兄弟、消息可靠性。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/ai" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-qing/50" data-tone="qing">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">Ragent AI</p>
        <p class="title-cn mt-2 text-[20px]">{s.ai.count} 题 · 均分 {s.ai.avg}</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">七阶段流水线 / 意图树 / MCP / 评测体系，另配点读、Prompt 解剖器与原文层。</p>
        <span class="mt-3 inline-block text-[12.5px] text-accent opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
    </section>

    <section class="mt-6 grid gap-4 lg:grid-cols-2">
      <a href="/train" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink3">TRAIN</p>
        <p class="title-cn mt-2 text-[20px]">训练场 · 手写 / 分布式 / 行为面</p>
        <p class="mt-2 text-[12.5px] leading-relaxed text-ink3">8 个模块，{s.train.count} 题，全部 AI 新增，带追问与满分回答。</p>
        <span class="mt-3 inline-block text-[12.5px] text-zhu opacity-60 group-hover:opacity-100">进入 →</span>
      </a>
      <a href="/hot200" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-zhu/40">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">HOT 200 手撕题</p>
        <p class="title-cn mt-2 text-[20px]">{hot200Total} 题 · {hot200Drill} 条默写判据</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">滑动窗口 / 双指针 / 链表 / 二叉树，五段式讲解 + 三层默写自测。</p>
      </a>
      <a href="/ai/read" class="group block rounded-xl border border-line bg-surface px-6 py-5 transition-colors hover:border-qing/50" data-tone="qing">
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-accent">原文层 · L3</p>
        <p class="title-cn mt-2 text-[20px]">{docCount} 篇全文 · 逐字保留</p>
        <p class="mt-1.5 text-[12px] leading-relaxed text-ink3">三份 AI 原文 + 项目经历 + 框架补充，按小节折叠，可以逐行核对是否原样。</p>
        <span class="mt-2 inline-block gap-3 text-[12px] text-accent opacity-60 group-hover:opacity-100">
          AI 原文 <span class="mx-2">·</span> 项目原文 <span class="mx-2">·</span> 全部 {docCount} 篇 →
        </span>
      </a>
    </section>

    <section class="mt-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="title-cn text-[22px]">各模块使用情况</h2>
        <span class="text-[11.5px] text-ink3" id="usage-total">统计中…</span>
      </div>
      <p class="mt-2 max-w-[46em] text-[13px] leading-relaxed text-ink3">
        每次进入模块都会记一条：访问次数、累计停留时长、最近一次打开。数据存在本机
        <code class="font-mono text-[12px]">site/server-data/usage.json</code>，
        <code class="font-mono text-[12px]">node scripts/anno-server.mjs</code> 没起时只在浏览器里攒着，不会报错。
      </p>
      <div id="usage-board" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-dashed border-line px-4 py-3 text-[12px] text-ink3">正在读取使用记录…</div>
      </div>
    </section>

    <section class="mt-16">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="title-cn text-[22px]">全部章节</h2>
        <span class="text-[11.5px] text-ink3">章节卡片右上角是这一章的访问次数与停留时长</span>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {chapters.map((c: any) => (
          <a href={`/notes/${c.key}`} class="card group px-5 py-5 transition-all hover:-translate-y-px hover:shadow-[var(--shadow-card-hover)]">
            <div class="flex items-start justify-between gap-2">
              <p class="text-[13.5px] font-medium">{c.name}</p>
              <span class="shrink-0 rounded border border-line px-1.5 py-0.5 text-[10px] text-ink3" data-usage-chapter={`/notes/${c.key}`}>—</span>
            </div>
            <p class="mt-0.5 text-[11.5px] text-ink3">{c.sub || String(c.count) + ' 题'}</p>
            <p class="tabular mt-3 text-[26px] font-semibold leading-none">{c.avg}</p>
            <p class="mt-1 text-[11.5px] text-ink3">{c.count} 题 · 最高 {c.max} / 最低 {c.min}</p>
          </a>
        ))}
      </div>
    </section>

    <script is:inline>
      (() => {
        const MODULES = [
          { key: 'java', label: 'Java 基础', href: '/notes' },
          { key: 'hot200', label: 'Hot200 手撕', href: '/hot200' },
          { key: 'project', label: '项目经历', href: '/project' },
          { key: 'mysql', label: 'MySQL', href: '/mysql' },
          { key: 'mw', label: '中间件', href: '/mw' },
          { key: 'ai', label: 'RAG · AI', href: '/ai' },
          { key: 'train', label: '训练场', href: '/train' },
          { key: 'review', label: '评审', href: '/review' },
          { key: 'intern', label: '实习经历', href: '/intern' }
        ];
        const fmtMs = (ms) => {
          if (!ms) return '—';
          const m = Math.round(ms / 60000);
          if (m < 1) return '<1 分';
          if (m < 60) return m + ' 分';
          const h = Math.floor(m / 60);
          return h + ' 时 ' + (m % 60) + ' 分';
        };
        const fmtAgo = (at) => {
          if (!at) return '—';
          const d = Math.round((Date.now() - at) / 60000);
          if (d < 1) return '刚刚';
          if (d < 60) return d + ' 分钟前';
          if (d < 1440) return Math.round(d / 60) + ' 小时前';
          return Math.round(d / 1440) + ' 天前';
        };
        const board = document.getElementById('usage-board');
        const totalEl = document.getElementById('usage-total');
        const render = (summary) => {
          if (!board) return;
          if (!summary) {
            board.innerHTML =
              '<div class="rounded-xl border border-dashed border-line px-4 py-3 text-[12px] leading-relaxed text-ink3 sm:col-span-2 lg:col-span-3">还读不到使用记录：先在本目录跑 <code class="font-mono">node scripts/anno-server.mjs</code>（端口 4400），刷新本页即可看到访问次数与停留时长。</div>';
            if (totalEl) totalEl.textContent = '本地服务未启动';
            return;
          }
          const mods = summary.modules || {};
          const maxMs = Math.max(1, ...MODULES.map((m) => mods[m.key]?.ms || 0));
          const sumMs = summary.totalMs || 0;
          const sumVisits = summary.totalVisits || 0;
          if (totalEl) {
            totalEl.textContent = '累计 ' + fmtMs(sumMs) + ' · ' + sumVisits + ' 次进入 · ' + (summary.updatedAt ? '更新于 ' + fmtAgo(summary.updatedAt) : '');
          }
          board.innerHTML = MODULES.map((m) => {
            const d = mods[m.key] || { visits: 0, ms: 0, lastAt: 0 };
            const pct = Math.round(((d.ms || 0) / maxMs) * 100);
            return (
              '<a href="' + m.href + '" class="group rounded-xl border border-line bg-surface px-4 py-3 transition-colors hover:border-zhu/40">' +
              '<div class="flex items-baseline justify-between gap-2">' +
              '<span class="text-[13px] text-ink">' + m.label + '</span>' +
              '<span class="font-mono text-[11px] text-ink3">' + (d.visits || 0) + ' 次</span>' +
              '</div>' +
              '<div class="mt-2 h-1.5 overflow-hidden rounded-full bg-surface2">' +
              '<span class="block h-full rounded-full" style="width:' + pct + '%;background:var(--c-zhu);opacity:.75"></span>' +
              '</div>' +
              '<div class="mt-1.5 flex items-baseline justify-between text-[11px] text-ink3">' +
              '<span>' + fmtMs(d.ms) + '</span><span>' + fmtAgo(d.lastAt) + '</span>' +
              '</div></a>'
            );
          }).join('');

          // 章节卡片：按 /notes/<chapter> 前缀聚合
          document.querySelectorAll('[data-usage-chapter]').forEach((el) => {
            const prefix = el.getAttribute('data-usage-chapter');
            const paths = (mods.java && mods.java.paths) || {};
            let visits = 0;
            let ms = 0;
            for (const [p, v] of Object.entries(paths)) {
              if (p === prefix || p.startsWith(prefix + '/')) {
                visits += v.visits || 0;
                ms += v.ms || 0;
              }
            }
            el.textContent = visits ? visits + ' 次 · ' + fmtMs(ms) : '未访问';
            if (visits) {
              el.style.color = 'var(--c-zhu)';
              el.style.borderColor = 'color-mix(in srgb, var(--c-zhu) 35%, transparent)';
            }
          });
        };
        const load = async () => {
          const w = window;
          if (w.__usage && typeof w.__usage.summary === 'function') {
            render(await w.__usage.summary());
            return;
          }
          try {
            const ctrl = new AbortController();
            const t = setTimeout(() => ctrl.abort(), 1500);
            const res = await fetch('http://127.0.0.1:4400/api/usage/summary', { signal: ctrl.signal });
            clearTimeout(t);
            render(res.ok ? await res.json() : null);
          } catch {
            render(null);
          }
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load);
        else setTimeout(load, 60);
      })();
    </script>
  </main>
</BaseLayout>
