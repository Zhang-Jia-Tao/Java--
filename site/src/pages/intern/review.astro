---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { internTasks, projects, codeLines } from '../../lib/intern';

const items = internTasks.map((t) => {
  const codeTotal = t.code.reduce((a, c) => a + codeLines(c), 0);
  return {
    id: t.id,
    title: t.title,
    project: projects[t.project]?.alias ?? t.project,
    company: t.company,
    star: t.difficulty,
    oneLine: t.oneLiner,
    href: `/intern/${t.id}`,
    codeCount: t.code.length,
    codeTotal,
    defects: t.defects.length,
    follow: t.followUps.length
  };
});
const payload = JSON.stringify({ items }).replace(/</g, '\\u003c');
const ids = items.map((i) => i.id);
---

<BaseLayout title="复习队列 · 实习经历" description="Leitner 五盒：实习卡今天该复哪几张，点一下就知道">
  <SiteHeader />
  <main class="mx-auto max-w-[900px] px-6 pb-24">
    <div class="pt-8 text-[12px] text-ink3">
      <a href="/intern" class="hover:text-zhu">实习经历</a><span class="mx-1.5">/</span><span class="text-ink2">复习队列</span>
    </div>

    <header class="mt-4 border-b border-line pb-6">
      <h1 class="title-cn text-[26px]">复习队列</h1>
      <p class="mt-2 max-w-[44em] text-[13px] leading-relaxed text-ink3">
        Leitner 五盒，间隔 1 / 2 / 4 / 7 / 15 天。答「会」进下一盒，答「不会」回到第 1 盒明天再来。
        卡片按核心代码的体量排，代码少的先过；记录只存在本机浏览器，和项目经历的复习记录共用一套（同一个 key，互不覆盖）。
      </p>
    </header>

    <section class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-line bg-surface p-4">
        <p class="text-[11px] text-ink3">今日到期</p>
        <p class="mt-1 font-mono text-[26px] text-zhu" id="stat-due">–</p>
      </div>
      <div class="rounded-xl border border-line bg-surface p-4">
        <p class="text-[11px] text-ink3">尚未开始</p>
        <p class="mt-1 font-mono text-[26px] text-ink2" id="stat-fresh">–</p>
      </div>
      <div class="rounded-xl border border-line bg-surface p-4">
        <p class="text-[11px] text-ink3">已进入循环</p>
        <p class="mt-1 font-mono text-[26px] text-lv" id="stat-learned">–</p>
      </div>
      <div class="rounded-xl border border-line bg-surface p-4">
        <p class="text-[11px] text-ink3">卡片总数</p>
        <p class="mt-1 font-mono text-[26px] text-ink2" id="stat-total">–</p>
      </div>
    </section>

    <section class="mt-4 rounded-xl border border-line bg-surface p-4">
      <div class="flex items-baseline justify-between">
        <p class="text-[12px] text-ink2">五盒分布</p>
        <p class="text-[11px] text-ink3" id="box-hint">新卡 → 1 天 → 2 天 → 4 天 → 7 天 → 15 天</p>
      </div>
      <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-faint" id="box-bar"></div>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-ink3" id="box-legend"></div>
    </section>

    <section class="mt-4 rounded-xl border border-line bg-surface p-4">
      <div class="flex items-baseline justify-between">
        <p class="text-[12px] text-ink2">未来 7 天到期预测</p>
        <p class="text-[11px] text-ink3">按当前盒号推算，不含今天</p>
      </div>
      <div class="mt-3 flex items-end gap-2" id="forecast"></div>
    </section>

    <div class="mt-6 flex flex-wrap items-center gap-2">
      <a href="/intern/flashcards" class="rounded-lg bg-zhu px-3 py-1.5 text-[12.5px] text-white hover:opacity-90">开始闪卡</a>
      <a href="/intern/drills" class="rounded-lg border border-line px-3 py-1.5 text-[12.5px] text-ink2 hover:border-zhu/40 hover:text-zhu">追问演练</a>
      <a href="/intern/playbook" class="rounded-lg border border-line px-3 py-1.5 text-[12.5px] text-ink2 hover:border-zhu/40 hover:text-zhu">代码讲解总表</a>
      <button id="export" class="rounded-lg border border-line px-3 py-1.5 text-[12.5px] text-ink2 hover:border-zhu/40 hover:text-zhu">
        导出今日清单
      </button>
      <button id="reset" class="ml-auto rounded-lg border border-line px-3 py-1.5 text-[11.5px] text-ink3 hover:border-zhu/40 hover:text-zhu">
        重置实习卡记录
      </button>
    </div>

    <section class="mt-6">
      <div class="border-b border-line pb-2">
        <h2 class="title-cn text-[18px]">今日待复习 <span class="font-mono text-[13px] text-ink3" id="due-count"></span></h2>
      </div>
      <ul class="mt-3 divide-y divide-line" id="list"></ul>
      <p class="mt-6 hidden rounded-xl border border-line bg-surface p-6 text-center text-[13px] text-ink3" id="empty">
        今天没有到期的实习卡。可以去 <a class="text-zhu hover:underline" href="/intern/flashcards">闪卡</a> 随便抽几张，
        或者回 <a class="text-zhu hover:underline" href="/intern">总览</a> 挑一张没背过的。
      </p>
    </section>
  </main>

  <script type="application/json" id="review-data" set:html={payload}></script>
  <script type="application/json" id="review-ids" set:html={JSON.stringify(ids)}></script>
  <script>
    import { load, save, grade, cardOf, dueQueue, stats, boxLabel, today, addDays } from '../../lib/leitner';

    type Item = {
      id: string;
      title: string;
      project: string;
      company: string;
      star: number;
      oneLine: string;
      href: string;
      codeCount: number;
    codeTotal: number;
      sec: number;
      defects: number;
      follow: number;
    };
    const data = JSON.parse(document.getElementById('review-data')!.textContent || '{"items":[]}') as { items: Item[] };
    const ids = JSON.parse(document.getElementById('review-ids')!.textContent || '[]') as string[];
    const items = data.items;
    let state = load();

    const el = (id: string) => document.getElementById(id)!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function render() {
      const s = stats(items, state);
      el('stat-due').textContent = String(s.due);
      el('stat-fresh').textContent = String(s.fresh);
      el('stat-learned').textContent = String(s.learned);
      el('stat-total').textContent = String(s.total);

      const segs = [
        { n: s.fresh, c: 'var(--c-ink-3)', label: '新卡' },
        ...s.buckets.map((n, i) => ({
          n,
          c: ['var(--hl-4)', 'var(--hl-3)', 'var(--hl-2)', 'var(--hl-5)', 'var(--hl-1)'][i],
          label: `${i + 1} 盒`
        }))
      ];
      const total = segs.reduce((a, x) => a + x.n, 0) || 1;
      el('box-bar').innerHTML = segs
        .filter((x) => x.n > 0)
        .map((x) => `<div style="width:${(x.n / total) * 100}%;background:${x.c}" title="${x.label} ${x.n} 张"></div>`)
        .join('');
      el('box-legend').innerHTML = segs
        .map((x) => `<span class="inline-flex items-center gap-1.5"><i class="inline-block h-2 w-2 rounded-full" style="background:${x.c}"></i>${x.label} ${x.n}</span>`)
        .join('');

      const due = dueQueue(items, state);
      el('due-count').textContent = `（${due.length} 张 · ${today()}）`;
      el('empty').classList.toggle('hidden', due.length > 0);

      el('list').innerHTML = due
        .map((it) => {
          const c = cardOf(state, it.id);
          const tag = state[it.id] ? boxLabel(c.box) : '新卡';
          const holes = [
            it.defects === 0 ? '<span class="text-ink3">无缺陷素材</span>' : '',
            it.follow < 4 ? '<span class="text-ink3">追问偏少</span>' : ''
          ].filter(Boolean).join(' · ');
          return `<li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-start">
            <div class="min-w-0 flex-1">
              <a href="${it.href}" class="text-[13.5px] font-medium text-ink hover:text-zhu">${esc(it.title)}</a>
              <p class="mt-1 line-clamp-2 text-[12px] leading-relaxed text-ink3">${esc(it.oneLine)}</p>
              <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] text-ink3">
                <span>${esc(it.project)}</span><span>·</span>
                <span class="text-zhu">${'★'.repeat(it.star)}</span><span>·</span>
                <span class="font-mono">${it.codeCount} 段代码 / ${it.codeTotal} 行</span><span>·</span>
                <span>${tag}</span><span>·</span>
                <span>已复习 ${c.seen} 次</span>${holes ? '<span>·</span>' + holes : ''}
              </p>
            </div>
            <div class="flex shrink-0 gap-1.5">
              <a href="/intern/flashcards?card=${it.id}" class="rounded-md border border-line px-2.5 py-1 text-[11.5px] text-ink2 hover:border-zhu/40 hover:text-zhu">背</a>
              <button data-repeat="${it.id}" class="rounded-md border border-line px-2.5 py-1 text-[11.5px] text-ink2 hover:border-jin/50 hover:text-jin">不会</button>
              <button data-know="${it.id}" class="rounded-md bg-lv/10 px-2.5 py-1 text-[11.5px] text-lv hover:bg-lv/20">会</button>
            </div>
          </li>`;
        })
        .join('');

      const days: { label: string; n: number }[] = [];
      for (let k = 1; k <= 7; k++) {
        const d = addDays(today(), k);
        const n = items.filter((it) => state[it.id]?.due === d).length;
        days.push({ label: d.slice(5).replace('-', '/'), n });
      }
      const maxN = Math.max(1, ...days.map((x) => x.n));
      el('forecast').innerHTML = days
        .map(
          (x) => `<div class="flex flex-1 flex-col items-center gap-1">
            <span class="font-mono text-[11px] ${x.n ? 'text-ink2' : 'text-ink3/60'}">${x.n}</span>
            <div class="w-full rounded-sm bg-zhu/70" style="height:${Math.max(3, Math.round((x.n / maxN) * 48))}px"></div>
            <span class="text-[10px] text-ink3">${x.label}</span>
          </div>`
        )
        .join('');

      el('list').querySelectorAll<HTMLButtonElement>('[data-know]').forEach((b) =>
        b.addEventListener('click', () => {
          state = grade(state, b.dataset.know!, true);
          render();
        })
      );
      el('list').querySelectorAll<HTMLButtonElement>('[data-repeat]').forEach((b) =>
        b.addEventListener('click', () => {
          state = grade(state, b.dataset.repeat!, false);
          render();
        })
      );
    }

    el('export').addEventListener('click', () => {
      const due = dueQueue(items, state);
      const lines = [`# 今日实习卡复习清单 ${today()}（${due.length} 张）`, ''];
      for (const it of due) {
        lines.push(`## ${it.title}`);
        lines.push(`- 项目：${it.project} · 难度 ${it.star} · ${boxLabel(cardOf(state, it.id).box)} · 核心代码 ${it.codeCount} 段`);
        lines.push(`- 一句话：${it.oneLine}`);
        lines.push(`- 链接：${it.href}`);
        lines.push('');
      }
      const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `intern-review-${today()}.md`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    el('reset').addEventListener('click', () => {
      if (!confirm('重置 26 张实习卡的 Leitner 记录？项目经历的记录不受影响。')) return;
      for (const id of ids) delete state[id];
      save(state);
      state = load();
      render();
    });

    render();
  </script>
</BaseLayout>
