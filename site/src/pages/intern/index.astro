---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import InternEditor from '../../components/InternEditor.astro';
import TopicGraph from '../../components/TopicGraph.astro';
import { internTasks, companies, projects, projectsOfCompany, stats, speakStat, mmss } from '../../lib/intern';

const groups = ['A', 'B'].map((c) => ({
  company: c as 'A' | 'B',
  info: companies[c as 'A' | 'B'],
  projects: projectsOfCompany(c as 'A' | 'B').map((p) => ({
    ...p,
    tasks: internTasks.filter((t) => t.project === p.key)
  }))
}));

const allDates = internTasks.flatMap((t) => t.dateRange).sort();
const span = { from: allDates[0], to: allDates[allDates.length - 1] };

/** 日期 → 天序号，用于算甘特条的百分比位置 */
const dayNum = (d: string) => Math.round(Date.parse(d + 'T00:00:00Z') / 86400000);

/** 区间内的月份刻度（左边界百分比） */
const monthTicks = (from: number, to: number) => {
  const out: { label: string; left: number }[] = [];
  const span0 = Math.max(1, to - from);
  const end = new Date(to * 86400000);
  let y = new Date(from * 86400000).getUTCFullYear();
  let m = new Date(from * 86400000).getUTCMonth();
  while (y < end.getUTCFullYear() || (y === end.getUTCFullYear() && m <= end.getUTCMonth())) {
    const start = Date.UTC(y, m, 1) / 86400000;
    // 区间起点可能落在月中，第一个刻度要夹到 0，否则标签会溢出卡片左边界
    const left = Math.max(0, ((start - from) / span0) * 100);
    out.push({ label: `${y}-${String(m + 1).padStart(2, '0')}`, left });
    m += 1;
    if (m > 11) {
      m = 0;
      y += 1;
    }
  }
  return out;
};

/** 项目 → 甘特条颜色（总览卡用空心条，避免和阶段卡抢视觉） */
// 注意：键名不要直接在对象字面量里写 export: ，Astro 编译器会把它当导出语句切开
const projectColor = Object.fromEntries([
  ['spr', 'var(--hl-4)'],
  ['menu', 'var(--hl-2)'],
  ['export', 'var(--c-zhu)'],
  ['mail', 'var(--c-qing)']
]) as Record<string, string>;
const legend = [
  ...Object.entries(projects).map(([key, p]) => ({
    label: p.alias,
    style: `background:${projectColor[key] ?? 'var(--c-ink-3)'}`
  })),
  { label: '项目总览卡（跨整段）', style: 'box-shadow:inset 0 0 0 1px var(--c-ink-3)' }
];

/** 每家公司一条泳道，任务按开始日排序 */
const lanes = ['A', 'B'].map((c) => {
  const info = companies[c as 'A' | 'B'];
  const tasks = internTasks
    .filter((t) => t.company === c)
    .slice()
    .sort((x, y) => x.dateRange[0].localeCompare(y.dateRange[0]) || x.seq - y.seq);
  const from = Math.min(...tasks.map((t) => dayNum(t.dateRange[0])));
  const to = Math.max(...tasks.map((t) => dayNum(t.dateRange[1])));
  const total = Math.max(1, to - from);
  return {
    company: c,
    info,
    months: monthTicks(from, to),
    spanLabel: `${tasks[0]?.dateRange[0] ?? ''} → ${tasks[tasks.length - 1]?.dateRange[1] ?? ''}`,
    rows: tasks.map((t) => {
      const left = ((dayNum(t.dateRange[0]) - from) / total) * 100;
      const width = Math.max(1.2, ((dayNum(t.dateRange[1]) - dayNum(t.dateRange[0])) / total) * 100);
      const overview = t.nature === '总览';
      const color = overview ? 'transparent' : projectColor[t.project] ?? 'var(--c-ink-3)';
      const shadow = overview ? 'inset 0 0 0 1px var(--c-ink-3)' : 'none';
      return {
        id: t.id,
        title: t.title,
        project: t.project,
        start: t.dateRange[0],
        end: t.dateRange[1],
        overview,
        // 直接给成品 style，模板里就不用再拼字符串
        barStyle: `left:${left}%;width:${width}%;background:${color};box-shadow:${shadow}`
      };
    })
  };
});

const capability = [
  { k: '跨服务字段一致性', v: '一次需求改 5 个服务、3 张表，字段与分组口径必须同时落地', ev: 'hv-menu-model / hv-backfill' },
  { k: '灰度与开关设计', v: '白名单从组件维度迭代到版本号、型号、框架类型四代', ev: 'hv-gray' },
  { k: '存量数据兼容', v: 'c_menu_group 为 null 的历史菜单走权威服务补齐，不靠本地规则猜', ev: 'hv-backfill' },
  { k: '导入导出双向一致', v: '导出再导入可回环，壳不落库、格式契约不改', ev: 'hv-pkg-shell' },
  { k: '大结果集流式处理', v: '游标分页 + SAX 写入，峰值内存与数据总量解耦', ev: 'ss-stream' },
  { k: '缓存与一致性', v: 'L1 Caffeine + L2 Redis，指纹校验解决脏数据窗口', ev: 'ss-cache' },
  { k: '分布式任务可靠性', v: '分布式锁 + 指数退避 + 死信队列三层兜底', ev: 'ss-mail-retry' },
  { k: '线上故障定位', v: '从日志与位点差切分「能力不足」与「等太久」', ev: 'hv-sps-sync' },
  { k: '调度防重', v: '锁粒度按业务日而非触发标识，调度框架重发也不会重复执行', ev: 'ss-mail-job' },
  { k: '配置化边界', v: '模板只做占位符替换，能力换稳定性，并有发送日志兜底可查', ev: 'ss-mail-render' },
  { k: 'SQL 安全与慢查询归因', v: '参数走绑定、结构走正则，慢 SQL 按归一化骨架聚合定位', ev: 'ss-sql' }
];
---

<BaseLayout title="实习经历 · 两家公司四个项目" description="安防厂商配单平台与菜单平台、托管银行查询导出与报表推送：需求、实现、缺陷修复逐块拆解">
  <SiteHeader />
  <main class="mx-auto max-w-[1100px] px-6 pb-24" data-intern-root>
    <header class="border-b border-line pt-10 pb-7">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">INTERNSHIP · 实习经历</p>
          <h1 class="title-cn mt-3 text-[32px]">两段实习，四个项目，把需求、实现、缺陷摊开讲</h1>
          <p class="mt-3 max-w-[48em] text-[13.5px] leading-relaxed text-ink3">
            共 <strong class="text-ink2">{stats.tasks}</strong> 张任务卡、<strong class="text-ink2">{stats.commits}</strong> 个提交、
            <strong class="text-ink2">{stats.add}</strong> 行新增、<strong class="text-ink2">{stats.defects}</strong> 起缺陷与返工。
            每张卡都按<strong class="text-ink2">需求 → 实现（含关键决策）→ 缺陷与返工 → 三层口述稿 → 追问预案</strong>组织，
            代码细节保留原样，公司名按约定脱敏。
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-2 text-[12px]">
            <a href="/intern/defects" class="chip border border-zhu/40 bg-zhusoft/50 text-zhu transition-colors hover:border-zhu">缺陷复盘集</a>
            <a href="/intern/playbook" class="chip border border-line text-ink2 transition-colors hover:text-ink">话术总表</a>
            <a href="/project" class="chip border border-line text-ink2 transition-colors hover:text-ink">个人项目</a>
            <a href="/review" class="chip border border-line text-ink2 transition-colors hover:text-ink">评审</a>
          </div>
        </div>
        <aside class="lg:pt-2">
          <TopicGraph topic="intern" caption="四个项目取自 intern/_alias.json，缺陷与话术是两个真实专页" />
        </aside>
      </div>
    </header>

    <section class="mt-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {[
        { k: '公司 / 项目', v: `${stats.companies} / ${stats.projects}` },
        { k: '任务卡', v: `${stats.tasks}` },
        { k: '提交', v: `${stats.commits}` },
        { k: '新增行', v: `${stats.add}` },
        { k: '缺陷与返工', v: `${stats.defects}` },
        { k: '覆盖服务', v: `${stats.repos}` }
      ].map((s) => (
        <div class="rounded-xl border border-line bg-surface px-4 py-3">
          <p class="text-[11px] text-ink3">{s.k}</p>
          <p class="mt-1 font-mono text-[18px] text-ink">{s.v}</p>
        </div>
      ))}
    </section>

    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-2">
        <h2 class="title-cn text-[18px]">时间轴</h2>
        <span class="text-[11.5px] text-ink3">{span.from} → {span.to} · 按任务开始日排序</span>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-3 text-[10.5px] text-ink3">
        {legend.map((lg) => (
          <span class="inline-flex items-center gap-1.5">
            <i class="inline-block h-2 w-2 rounded-full" style={lg.style}></i>
            {lg.label}
          </span>
        ))}
      </div>

      <div class="mt-4 space-y-4">
        {lanes.map((l) => (
          <div class="rounded-xl border border-line bg-surface px-4 py-3">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-[12.5px] text-ink2">{l.info.alias} · {l.info.role} · {l.info.period}</p>
              <span class="font-mono text-[10.5px] text-ink3">{l.rows.length} 个任务块 · {l.spanLabel}</span>
            </div>

            <!-- 月份刻度：只在大屏显示，窄屏退回日期文本 -->
            <div class="relative mt-3 hidden h-4 sm:block">
              {l.months.map((m) => (
                <span class="absolute top-0 border-l border-line pl-1 font-mono text-[10px] leading-4 text-ink3" style={`left:${m.left}%`}>{m.label}</span>
              ))}
            </div>

            <ul class="mt-1 divide-y divide-line/60">
              {l.rows.map((r) => (
                <li>
                  <a
                    href={`/intern/${r.id}`}
                    class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 py-1.5 sm:grid-cols-[minmax(0,250px)_minmax(0,1fr)]"
                  >
                    <span class="flex min-w-0 items-baseline gap-1.5">
                      <span class="shrink-0 font-mono text-[10.5px] text-ink3">{r.start.slice(5)}</span>
                      <span class="truncate text-[12px] text-ink2 transition-colors group-hover:text-zhu">{r.title}</span>
                    </span>
                    <!-- 甘特条：left/width 按公司区间百分比计算 -->
                    <span class="relative hidden h-3 sm:block">
                      <span class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-line"></span>
                      <span
                        class="absolute top-1/2 h-2 -translate-y-1/2 rounded-full transition-opacity group-hover:opacity-80"
                        style={r.barStyle}
                        title={`${r.start} → ${r.end}`}
                      ></span>
                    </span>
                    <span class="shrink-0 font-mono text-[10.5px] text-ink3 sm:hidden">{r.start.slice(5)} → {r.end.slice(5)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {groups.map((g) => (
      <section class="mt-12">
        <div class="flex items-baseline justify-between border-b border-line pb-2">
          <div>
            <h2 class="title-cn text-[20px]">{g.info.alias}</h2>
            <p class="mt-1 text-[12px] text-ink3">{g.info.full} · {g.info.role} · {g.info.period}</p>
          </div>
          <span class="text-[11.5px] text-ink3">{g.projects.reduce((a, p) => a + p.tasks.length, 0)} 个任务块</span>
        </div>

        {g.projects.map((p) => (
          <div class="mt-6">
            <div class="flex items-baseline gap-3">
              <h3 class="text-[15px] font-semibold text-ink">{p.alias}</h3>
              <span class="text-[11.5px] text-ink3">{p.desc}</span>
            </div>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {p.tasks.map((t) => {
                const s = speakStat(t.speak.s60);
                return (
                  <li class="rounded-xl border border-line bg-surface p-4 transition-shadow hover:shadow-[var(--shadow-card-hover)]">
                    <a href={`/intern/${t.id}`} class="block">
                      <div class="flex items-baseline gap-2">
                        <span class="font-mono text-[11px] text-ink3">{String(t.seq).padStart(2, '0')}</span>
                        <h4 class="flex-1 text-[14px] font-semibold text-ink">{t.title}</h4>
                        <span class="shrink-0 text-[11px] text-zhu">{'★'.repeat(t.difficulty)}</span>
                      </div>
                      <p class="mt-2 text-[12px] leading-relaxed text-ink3 line-clamp-3">{t.oneLiner}</p>
                      <div class="mt-3 flex flex-wrap items-center gap-2 text-[10.5px] text-ink3">
                        <span class="chip border border-line px-1.5 py-0.5">{t.nature}</span>
                        <span class="chip border border-line px-1.5 py-0.5">{t.commits.length} 提交</span>
                        {t.defects.length > 0 && (
                          <span class="chip border border-zhu/30 bg-zhusoft/40 px-1.5 py-0.5 text-zhu">{t.defects.length} 起缺陷</span>
                        )}
                        <span class="font-mono">{s.cjk} 字 · {mmss(s.sec)}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section class="mt-12">
      <div class="border-b border-line pb-2">
        <h2 class="title-cn text-[18px]">这些经历能对上什么能力</h2>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {capability.map((c) => (
          <div class="rounded-xl border border-line bg-surface px-4 py-3">
            <p class="text-[13px] font-semibold text-ink">{c.k}</p>
            <p class="mt-1 text-[12px] leading-relaxed text-ink3">{c.v}</p>
            <p class="mt-2 font-mono text-[10.5px] text-zhu">{c.ev}</p>
          </div>
        ))}
      </div>
    </section>

    <footer class="mt-10 rounded-xl border border-dashed border-line px-5 py-4 text-[12px] leading-relaxed text-ink3">
      页面内容全部由本地提交记录与工作文档整理而来：公司名按约定换成别名，类名、表名、字段名、配置项、提交 hash 保留原样，
      方便面试时被追问细节能立刻对上。当前页支持编辑：双击任意正文即可修改，保存状态在右下角，详见
      <a href="/intern/playbook" class="text-zhu hover:underline">话术总表</a> 页底部的编辑说明。
    </footer>
  </main>
  <InternEditor />
</BaseLayout>
