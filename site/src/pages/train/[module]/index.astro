---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { trainModules, moduleQuestions, statusLabel, starText } from '../../../lib/project';

export function getStaticPaths() {
  return trainModules.map((m) => ({ params: { module: m.en }, props: { mod: m } }));
}

const { mod } = Astro.props as any;
const items = moduleQuestions(mod.key);
---

<BaseLayout title={`${mod.name} · 训练场`} description={mod.desc}>
  <SiteHeader />
  <main class="mx-auto max-w-[1000px] px-6 pb-24">
    <div class="pt-8 text-[12px] text-ink3">
      <a href="/train" class="hover:text-ink">训练场</a><span class="mx-2">/</span><span class="text-ink2">{mod.name}</span>
    </div>
    <header class="mt-4 border-b border-line pb-6">
      <h1 class="title-cn text-[26px]">{mod.name}</h1>
      <p class="mt-2 max-w-[44em] text-[13px] leading-relaxed text-ink3">{mod.desc}</p>
      <p class="mt-3 text-[12px] text-ink3">{items.length} 题 · 全部 AI 新增（无 md 原文）</p>
    </header>
    <ul class="mt-2 divide-y divide-line">
      {items.map((q) => (
        <li>
          <a href={`/train/${mod.en}/${q.id}`} class="block py-4 transition-colors hover:bg-zhusoft/40">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[11.5px] text-ink3">{q.id}</span>
              <h2 class="flex-1 text-[14.5px] text-ink">{q.title}</h2>
              <span class="shrink-0 text-[11.5px] text-zhu">{starText(q.star)}</span>
              <span class="shrink-0 text-[11px] text-ink3">{q.aiAdded ? 'AI 新增' : statusLabel[q.status]}</span>
            </div>
            {q.oneLine && <p class="mt-1.5 pl-[52px] pr-4 text-[12px] leading-relaxed text-ink3">{q.oneLine}</p>}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
