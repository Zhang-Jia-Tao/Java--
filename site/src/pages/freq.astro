---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FreqBadge from '../components/FreqBadge.astro';
import freqJson from '../data/freq.json';
import { chainIndex } from '../lib/chain';

interface Item {
  id: string;
  domain: 'java' | 'ai' | 'proj' | 'hot';
  module: string;
  href: string;
  title: string;
  tier: 'S' | 'A' | 'B' | '-';
  why: string;
}

const freq = freqJson as { note: string; generated: string; stats: any; items: Item[] };
const chainIds = new Set(chainIndex.map((c) => c.id));

const domainLabel: Record<string, string> = {
  java: 'Java 后端',
  ai: 'AI 应用',
  proj: '个人项目',
  hot: '手撕'
};

// 主视图只放参与考频的两条线；个人项目 / 手撕单独说明
const scoped = freq.items.filter((i) => i.domain === 'java' || i.domain === 'ai');
const sJava = scoped.filter((i) => i.domain === 'java' && i.tier === 'S');
const sAi = scoped.filter((i) => i.domain === 'ai' && i.tier === 'S');
const sList = [...sJava, ...sAi];

const payload = JSON.stringify({ items: scoped, chains: [...chainIds] }).replace(/</g, '\\u003c');
---

<BaseLayout
  title="考频榜 · Java 终极笔记"
  description="516 道题按「面试考不考」分档：S 必背、A 常考、B 会问；S 级配连问链。"
>
  <SiteHeader />
  <main class="mx-auto max-w-[1080px] px-6 pb-24">
    <div class="pt-9">
      <h1 class="title-cn text-[26px] leading-snug text-ink">考频榜</h1>
      <p class="mt-2 max-w-[640px] text-[12.5px] leading-relaxed text-ink3">
        背书的顺序比背书的数量重要。这里把 516 题按「面试考不考」分三档：
        <b class="text-zhu">S 必背 {sList.length} 题</b>（配连问链）、
        <b class="text-accent">A 常考 {scoped.filter((i) => i.tier === 'A').length} 题</b>（至少背答案）、
        B 会问 {scoped.filter((i) => i.tier === 'B').length} 题。
        个人项目 90 题与手撕 103 题不参与考频（前者看简历、后者按 Hot200 精刷）。
      </p>
      <p class="mt-2 max-w-[640px] text-[11.5px] leading-relaxed text-ink3">
        分档方式：{freq.note}
      </p>
    </div>

    <div class="sticky top-14 z-20 -mx-2 mt-5 bg-paper/90 px-2 py-3 backdrop-blur">
      <input
        id="f-q"
        type="search"
        autocomplete="off"
        placeholder="搜题目 / 关键词，例如「索引」「线程池」「MVCC」"
        class="w-full rounded-xl border border-line bg-surface px-4 py-2.5 text-[13.5px] text-ink outline-none placeholder:text-ink3 focus:border-zhu/50"
      />
      <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
        <button type="button" data-t="S" class="fchip is-on">S 必背</button>
        <button type="button" data-t="A" class="fchip">A 常考</button>
        <button type="button" data-t="B" class="fchip">B 会问</button>
        <button type="button" data-t="all" class="fchip">全部</button>
        <span class="mx-1 h-3 w-px bg-line"></span>
        <button type="button" data-d="java" class="fchip">Java 后端</button>
        <button type="button" data-d="ai" class="fchip">AI 应用</button>
        <button type="button" data-d="all" class="fchip is-on">两条线</button>
        <span class="mx-1 h-3 w-px bg-line"></span>
        <label class="flex cursor-pointer items-center gap-1.5 text-[11.5px] text-ink2">
          <input id="f-chain" type="checkbox" class="h-3 w-3 accent-[var(--c-zhu)]" />
          只显示有连问链
        </label>
        <span id="f-count" class="ml-auto text-[11.5px] text-ink3"></span>
      </div>
    </div>

    <ul id="f-list" class="mt-2 divide-y divide-line/70"></ul>

    <section class="mt-10 rounded-xl border border-line bg-surface/60 px-5 py-4">
      <h2 class="title-cn text-[14px] text-ink">怎么用这张榜</h2>
      <ol class="mt-2 space-y-1 text-[12.5px] leading-relaxed text-ink2">
        <li>1. 投递前 4 周：先把 S 级 30 多题过一遍，每题做一次连问链（点行尾的「链」）；</li>
        <li>2. 面试前 1 周：只看 S 级的「满分总答」，A 级扫标题确认能说三句；</li>
        <li>3. 面挂了立刻回来：把被问住的那题标进批注待办（详情页选中文字即可），下次优先。</li>
      </ol>
      <p class="mt-3 text-[11.5px] text-ink3">
        连问链目前覆盖 S 级的一部分，剩下的会陆续补；没有链的题先背本页的答案与追问（详情页「面试官追问」区）。
      </p>
    </section>
  </main>

  <style>
    .fchip {
      border: 1px solid var(--c-line);
      border-radius: 999px;
      padding: 3px 10px;
      font-size: 11.5px;
      color: var(--c-ink-2);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .fchip:hover {
      color: var(--c-ink);
      border-color: color-mix(in srgb, var(--c-zhu) 40%, var(--c-line));
    }
    .fchip.is-on {
      color: var(--c-zhu);
      border-color: color-mix(in srgb, var(--c-zhu) 50%, transparent);
      background: color-mix(in srgb, var(--c-zhu) 8%, transparent);
    }
  </style>

  <script type="application/json" id="freq-data" set:html={payload}></script>

  <script>
    (() => {
      type Item = { id: string; domain: string; module: string; href: string; title: string; tier: string; why: string };
      const el = document.getElementById('freq-data');
      if (!el) return;
      const { items, chains } = JSON.parse(el.textContent || '{"items":[],"chains":[]}') as {
        items: Item[];
        chains: string[];
      };
      const chainSet = new Set(chains);
      const input = document.getElementById('f-q') as HTMLInputElement;
      const list = document.getElementById('f-list') as HTMLElement;
      const count = document.getElementById('f-count') as HTMLElement;
      const chainOnly = document.getElementById('f-chain') as HTMLInputElement;
      const tierBtns = [...document.querySelectorAll<HTMLElement>('[data-t]')];
      const domainBtns = [...document.querySelectorAll<HTMLElement>('[data-d]')];
      let tier = 'S';
      let domain = 'all';

      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
      const badge = (t: string) => {
        const c =
          t === 'S'
            ? 'border-zhu/45 bg-zhu/10 text-zhu'
            : t === 'A'
              ? 'border-accent/35 bg-accent/10 text-accent'
              : 'border-line bg-surface2/60 text-ink2';
        return `<span class="inline-flex h-[18px] min-w-[18px] items-center justify-center rounded border px-1 font-mono text-[10.5px] font-semibold ${c}">${t}</span>`;
      };

      const render = () => {
        const q = input.value.trim().toLowerCase();
        const rows = items
          .filter((i) => (tier === 'all' ? true : i.tier === tier))
          .filter((i) => (domain === 'all' ? true : i.domain === domain))
          .filter((i) => (chainOnly.checked ? chainSet.has(i.id) : true))
          .filter((i) => (q ? (i.title + i.module + i.why).toLowerCase().includes(q) : true));

        count.textContent = `${rows.length} 题`;
        if (!rows.length) {
          list.innerHTML = '<li class="py-6 text-center text-[12.5px] text-ink3">没有匹配的题；换个关键词或切到「全部」。</li>';
          return;
        }
        list.innerHTML = rows
          .map(
            (i) => `<li class="flex items-start gap-3 py-2.5">
              ${badge(i.tier)}
              <a href="${i.href}" class="min-w-0 flex-1">
                <span class="text-[13.5px] text-ink hover:text-zhu">${esc(i.title)}</span>
                <span class="ml-2 text-[11px] text-ink3">${esc(i.module)}${i.domain === 'ai' ? ' · AI' : ''}</span>
                <span class="mt-0.5 block text-[11.5px] leading-relaxed text-ink3">${esc(i.why)}</span>
              </a>
              ${
                chainSet.has(i.id)
                  ? `<a href="/chain/${i.id}" class="shrink-0 rounded-full border border-zhu/40 px-2 py-0.5 text-[11px] text-zhu hover:bg-zhu/10">连问链 ${'→'}</a>`
                  : ''
              }
            </li>`
          )
          .join('');
      };

      tierBtns.forEach((b) =>
        b.addEventListener('click', () => {
          tier = b.dataset.t || 'S';
          tierBtns.forEach((x) => x.classList.toggle('is-on', x === b));
          render();
        })
      );
      domainBtns.forEach((b) =>
        b.addEventListener('click', () => {
          domain = b.dataset.d || 'all';
          domainBtns.forEach((x) => x.classList.toggle('is-on', x === b));
          render();
        })
      );
      input.addEventListener('input', render);
      chainOnly.addEventListener('change', render);
      render();
    })();
  </script>
</BaseLayout>
