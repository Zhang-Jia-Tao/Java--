---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { aiStats, aiModules } from '../../lib/project';

const s = aiStats();
const stack = [
  { group: '框架', items: ['Spring Boot 4', 'MyBatis-Plus', 'Sa-Token', 'Redisson', 'RocketMQ'] },
  { group: 'AI', items: ['AgentScope（ReAct）', 'OpenAI 风格协议', 'Milvus / PgVector', 'Elasticsearch', 'Apache Tika'] },
  { group: '前端', items: ['React 18', 'Vite', 'shadcn/ui', 'AntV G6（意图树）'] },
  { group: '工程', items: ['七阶段流水线', '两级线程池隔离', 'SSE 流式', 'Trace 全链路', '评测旁路接口'] }
];
const pipeline = [
  { no: 1, name: '加载会话记忆', key: '滑动窗口 + 摘要压缩', short: false },
  { no: 2, name: '问题改写与拆分', key: '一次 LLM 双输出', short: false },
  { no: 3, name: '意图识别', key: '三级意图树 + 节点打分', short: false },
  { no: 4, name: '歧义引导', key: '多品类高分 → 反问', short: true },
  { no: 5, name: '系统直答', key: 'SYSTEM 意图不检索', short: true },
  { no: 6, name: '多通道检索 / MCP', key: '向量 + 关键词 + 图谱 / 工具', short: false },
  { no: 7, name: '空结果兜底', key: '全通道无结果', short: true },
  { no: 8, name: '组装 Prompt + 流式生成', key: '按场景拼 system/user', short: false }
];
const facts = [
  { k: 'Java 源文件', v: '945 个', note: 'rag 511 / agent 136 / mcp-server 73 / infra-ai 57 / framework 34 / system 41 / bootstrap 少量' },
  { k: '主流水线', v: 'StreamChatPipeline 215 行', note: 'execute L82 串联八个阶段方法' },
  { k: '检索通道', v: '3 条（向量 / 关键词 / 图谱）', note: 'MultiChannelRetrievalEngine 两阶段执行' },
  { k: '模型供应商', v: '6 家适配', note: 'DeepSeek / 百炼 / Ollama / SiliconFlow / AIHubMix / OpenAI 风格' },
  { k: '工具集', v: 'MCP Server 70+ 文件', note: '电商域：订单 / 商品 / 售后 / 物流 / 优惠券 / 购物车' }
];
---

<BaseLayout title="Ragent 总览 · AI 专区" description="Ragent 的分层架构、技术栈与八阶段流水线全景">
  <SiteHeader />
  <main class="mx-auto max-w-[1000px] px-6 pb-24" data-tone="qing">
    <div class="pt-8 text-[12px] text-ink3">
      <a href="/ai" class="hover:text-ink">Ragent AI</a><span class="mx-2">/</span><span class="text-ink2">总览</span>
    </div>

    <header class="mt-4 border-b border-line pb-6">
      <h1 class="title-cn text-[26px]">Ragent：Agentic RAG 平台的骨架</h1>
      <p class="mt-3 max-w-[46em] text-[13.5px] leading-relaxed text-ink2">
        它解决的是「企业内部有 20 个知识库、文档天天变、大模型还爱编」这件事：先把文档切成能检索的块，
        再让一次提问经过记忆、改写、意图、检索、工具、生成六道加工，最后流式吐字并给出引用。
        下面是模块分层、技术栈和主流水线——面试先讲这三张，再往下讲细节。
      </p>
      <div class="mt-4 flex flex-wrap gap-5 text-[12px] text-ink3">
        <span>{s.total} 道 AI 题</span>
        <span>平均 {s.avg} 分</span>
        <span>{s.anchors} 条锚点</span>
        <span>硬伤 {s.hardErrors}</span>
      </div>
    </header>

    <section class="mt-8">
      <figure class="overflow-hidden rounded-xl border border-line bg-card p-3">
        <img src="/diagrams/ai-overview.svg" alt="Ragent 分层架构" class="mx-auto block w-full max-w-[880px]" loading="lazy" decoding="async" />
        <figcaption class="mt-3 border-t border-line pt-2 text-[11.5px] leading-relaxed text-ink3">
          接入与治理 → 七阶段流水线 → 检索 / 工具 → 模型层 → 存储。每个方框在代码里都有对应的包，下面「模块」一节给了入口类。
        </figcaption>
      </figure>
    </section>

    <section class="mt-10">
      <h2 class="title-cn text-[18px]">模块与入口</h2>
      <div class="mt-3 overflow-hidden rounded-xl border border-line">
        <table class="w-full text-[12.5px]">
          <thead class="bg-surface2/60 text-[11px] text-ink3">
            <tr><th class="px-4 py-2 text-left font-normal">模块</th><th class="px-4 py-2 text-left font-normal">职责</th><th class="px-4 py-2 text-left font-normal">入口类</th></tr>
          </thead>
          <tbody class="divide-y divide-line bg-card">
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">rag</td><td class="px-4 py-2 text-ink2">解析、分块、入库、检索、意图、生成</td><td class="px-4 py-2 font-mono text-[11px] text-accent">StreamChatPipeline</td></tr>
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">agent</td><td class="px-4 py-2 text-ink2">ReAct 智能体、记忆、工具、人工确认</td><td class="px-4 py-2 font-mono text-[11px] text-accent">ReActAgentProvider</td></tr>
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">infra-ai</td><td class="px-4 py-2 text-ink2">模型接入、路由、首包探测、Embedding、Rerank</td><td class="px-4 py-2 font-mono text-[11px] text-accent">RoutingLLMService</td></tr>
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">mcp-server</td><td class="px-4 py-2 text-ink2">电商域 MCP 工具集与 Schema</td><td class="px-4 py-2 font-mono text-[11px] text-accent">McpServerConfig</td></tr>
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">framework</td><td class="px-4 py-2 text-ink2">缓存、幂等、MQ、分布式 ID、trace、取消</td><td class="px-4 py-2 font-mono text-[11px] text-accent">Cancellation 包</td></tr>
            <tr><td class="px-4 py-2 font-mono text-[11.5px]">system</td><td class="px-4 py-2 text-ink2">用户与权限、业务审计、评测样本</td><td class="px-4 py-2 font-mono text-[11px] text-accent">SampleQuestionService</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="title-cn text-[18px]">技术栈</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {stack.map((g) => (
          <div class="rounded-xl border border-line bg-card p-4">
            <p class="text-[11px] uppercase tracking-[0.16em] text-accent">{g.group}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {g.items.map((i) => <span class="rounded border border-line px-2 py-0.5 text-[11.5px] text-ink2">{i}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <div class="flex items-baseline justify-between border-b border-line pb-2">
        <h2 class="title-cn text-[18px]">八阶段流水线（一眼版）</h2>
        <span class="flex items-center gap-3"><a href="/ai/pipeline" class="text-[11.5px] text-accent hover:underline">点开逐段看 →</a><a href="/ai/intent" class="text-[11.5px] text-ink3 hover:text-accent">意图树模拟 →</a></span>
      </div>
      <ol class="ai-flow mt-5 space-y-2">
        {pipeline.map((p) => (
          <li class="relative">
            <span class="ai-dot" data-active={p.short ? 'true' : 'false'}></span>
            <div class="flex flex-wrap items-baseline gap-2 px-1">
              <span class="font-mono text-[11px] text-ink3">{String(p.no).padStart(2, '0')}</span>
              <span class="text-[13px] text-ink">{p.name}</span>
              {p.short && <span class="ai-tag">短路点</span>}
              <span class="text-[11.5px] text-ink3">· {p.key}</span>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-10">
      <h2 class="title-cn text-[18px]">几个能张口就报的数</h2>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        {facts.map((f) => (
          <div class="rounded-lg border border-line bg-card px-3 py-2.5">
            <p class="flex items-baseline gap-2"><span class="text-[11.5px] text-ink3">{f.k}</span><span class="font-mono text-[12.5px] text-accent">{f.v}</span></p>
            <p class="mt-1 text-[11.5px] leading-relaxed text-ink3">{f.note}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <h2 class="title-cn text-[18px]">往下看哪块</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        {aiModules.map((m) => (
          <a href={`/ai/${m.en}`} class="rounded-xl border border-line bg-card p-4 transition-colors hover:border-accent/40">
            <p class="text-[13.5px] text-ink">{m.name}</p>
            <p class="mt-1 text-[11.5px] leading-relaxed text-ink3">{m.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
