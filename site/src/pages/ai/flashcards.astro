---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { aiQuestions, aiModules } from '../../lib/project';

const modOf = (k: string) => aiModules.find((m) => m.key === k);
const cards = aiQuestions.map((q) => ({
  id: q.id,
  title: q.title,
  question: q.question,
  moduleName: modOf(q.module)?.name ?? q.module,
  en: modOf(q.module)?.en ?? 'engine',
  star: q.star,
  score: q.review?.total ?? 0,
  oneLine: q.oneLine,
  s60: q.speak?.s60 ?? '',
  keywords: q.drill?.keywords ?? [],
  metrics: (q.metrics ?? []).slice(0, 3).map((m: { k: string; v: string }) => `${m.k}：${m.v}`)
}));

const payload = JSON.stringify({ cards }).replace(/</g, '\\u003c');
---

<BaseLayout title="闪卡 · Ragent AI" description="先想，再翻；会的进下一盒">
  <SiteHeader />
  <main data-tone="qing" class="mx-auto max-w-[820px] px-6 pb-24">
    <div class="pt-8 text-[12px] text-ink3">
      <a href="/ai" class="hover:text-ink">Ragent AI</a><span class="mx-2">/</span>
      <a href="/ai/review" class="hover:text-ink">复习队列</a><span class="mx-2">/</span>
      <span class="text-ink2">闪卡</span>
    </div>

    <header class="mt-4 flex items-baseline justify-between border-b border-line pb-4">
      <h1 class="title-cn text-[24px]">闪卡</h1>
      <p class="text-[12px] text-ink3">先在心里答一遍，再翻面</p>
    </header>

    <div class="mt-5 flex items-center gap-3 text-[11.5px] text-ink3">
      <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-faint">
        <div class="h-full bg-accent transition-all" id="progress" style="width:0%"></div>
      </div>
      <span class="font-mono" id="progress-text">0 / 0</span>
    </div>

    <section class="mt-5 rounded-2xl border border-line bg-card p-6" id="card">
      <p class="text-[11px] uppercase tracking-wide text-ink3" id="card-mod"></p>
      <h2 class="mt-2 text-[17px] font-medium leading-snug text-ink" id="card-title"></h2>
      <p class="mt-3 text-[13.5px] leading-relaxed text-ink2" id="card-q"></p>

      <div class="mt-6 hidden border-t border-line pt-5" id="answer">
        <p class="text-[11px] text-ink3">一句话</p>
        <p class="mt-1 text-[13.5px] leading-relaxed text-ink" id="card-one"></p>
        <p class="mt-4 text-[11px] text-ink3">60 秒口述</p>
        <p class="mt-1 whitespace-pre-line text-[13px] leading-[1.85] text-ink2" id="card-s60"></p>
        <div class="mt-4 hidden rounded-lg bg-accentsoft/50 p-3 text-[12px] leading-relaxed text-ink2" id="card-metrics-wrap">
          <p class="text-[11px] text-ink3">关键数字</p>
          <ul class="mt-1 space-y-0.5" id="card-metrics"></ul>
        </div>
        <p class="mt-4 text-[12px] text-ink3" id="card-kw"></p>
      </div>
    </section>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <button id="reveal" class="rounded-lg bg-accent px-4 py-2 text-[13px] text-white hover:opacity-90">看答案</button>
      <button id="again" class="hidden rounded-lg border border-line px-4 py-2 text-[13px] text-ink2 hover:border-jin/50 hover:text-jin">不会</button>
      <button id="know" class="hidden rounded-lg bg-lv/10 px-4 py-2 text-[13px] text-lv hover:bg-lv/20">会</button>
      <button id="skip" class="rounded-lg border border-line px-4 py-2 text-[13px] text-ink3 hover:border-accent/40 hover:text-accent">跳过</button>
      <a href="/ai/review" class="ml-auto text-[12px] text-ink3 hover:text-accent">队列 →</a>
    </div>

    <p class="mt-8 hidden rounded-xl border border-line bg-card p-6 text-center text-[13px] text-ink3" id="done">
      这一轮过完了。回 <a class="text-accent hover:underline" href="/ai/review">队列</a> 看明天到期多少。
    </p>
  </main>

  <script type="application/json" id="card-data" set:html={payload}></script>
  <script>
    import { load, grade, cardOf, dueQueue } from '../../lib/leitner';

    type Card = {
      id: string; title: string; question: string; moduleName: string; en: string;
      star: number; score: number; oneLine: string; s60: string; keywords: string[]; metrics: string[];
    };
    const data = JSON.parse(document.getElementById('card-data')!.textContent || '{"cards":[]}') as { cards: Card[] };
    let state = load();

    // 顺序：先今日到期（生疏优先），再其余（乱序），避免总从 ma-01 开始
    const due = dueQueue(data.cards, state);
    const dueIds = new Set(due.map((c) => c.id));
    const rest = data.cards.filter((c) => !dueIds.has(c.id)).sort(() => Math.random() - 0.5);
    let queue = [...due, ...rest];
    let i = 0;

    const el = (id: string) => document.getElementById(id)!;
    const cur = () => queue[i];

    function paint() {
      const c = cur();
      const total = queue.length;
      el('progress').style.width = `${total ? (i / total) * 100 : 0}%`;
      el('progress-text').textContent = `${Math.min(i + 1, total)} / ${total}`;
      if (!c) {
        el('card').classList.add('hidden');
        el('done').classList.remove('hidden');
        ['reveal', 'again', 'know', 'skip'].forEach((x) => el(x).classList.add('hidden'));
        return;
      }
      const box = cardOf(state, c.id).box;
      el('card-mod').textContent = `${c.moduleName} · ${c.star} 星 · 评分 ${c.score} · ${box === 0 ? '新题' : `第 ${box} 盒`}`;
      el('card-title').textContent = c.title;
      el('card-q').textContent = c.question;
      el('answer').classList.add('hidden');
      el('reveal').classList.remove('hidden');
      el('again').classList.add('hidden');
      el('know').classList.add('hidden');
      el('skip').classList.remove('hidden');
    }

    function reveal() {
      const c = cur();
      if (!c) return;
      el('card-one').textContent = c.oneLine;
      el('card-s60').textContent = c.s60;
      el('card-kw').textContent = c.keywords.length ? `关键词：${c.keywords.join(' · ')}` : '';
      const mw = el('card-metrics-wrap');
      if (c.metrics.length) {
        mw.classList.remove('hidden');
        el('card-metrics').innerHTML = c.metrics.map((m) => `<li>${m.replace(/[<>&]/g, '')}</li>`).join('');
      } else {
        mw.classList.add('hidden');
      }
      el('answer').classList.remove('hidden');
      el('reveal').classList.add('hidden');
      el('again').classList.remove('hidden');
      el('know').classList.remove('hidden');
    }

    function next() {
      i += 1;
      paint();
    }

    el('reveal').addEventListener('click', reveal);
    el('know').addEventListener('click', () => {
      state = grade(state, cur().id, true);
      next();
    });
    el('again').addEventListener('click', () => {
      state = grade(state, cur().id, false);
      next();
    });
    el('skip').addEventListener('click', next);

    document.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        if (!el('answer').classList.contains('hidden')) return;
        reveal();
      } else if (e.key === 'j') {
        if (!el('know').classList.contains('hidden')) el('know').click();
      } else if (e.key === 'k') {
        if (!el('again').classList.contains('hidden')) el('again').click();
      }
    });

    paint();
  </script>
</BaseLayout>
