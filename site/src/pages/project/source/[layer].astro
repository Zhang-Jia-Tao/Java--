---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { graphMeta, layerHref, graphDate } from '../../../lib/graph';

export function getStaticPaths() {
  return graphMeta.layers.map((l) => ({ params: { layer: l.id }, props: { layer: l } }));
}

const { layer } = Astro.props as { layer: (typeof graphMeta.layers)[number] };
const others = graphMeta.layers.filter((l) => l.id !== layer.id);

/** 9 个层各给一个色：直接复用朱批色板（--hl-N），深色模式自动跟着变 */
const layerColors: Record<string, string> = Object.fromEntries(
  graphMeta.layers.map((l, i) => [l.id, `var(--hl-${(i % 9) + 1})`])
);
const typeNames = { file: '文件', class: '类', function: '方法', table: '表', config: '配置', document: '文档' };
/** 单层页按「节点类型」上色：一页里 9 层只剩 1 色的话，画布等于没有配色信息 */
const typeColors: Record<string, string> = {
  file: 'var(--hl-4)',
  class: 'var(--hl-1)',
  function: 'var(--hl-3)',
  table: 'var(--hl-6)',
  config: 'var(--hl-2)',
  document: 'var(--hl-9)'
};
const types = ['file', 'class', 'function', 'table', 'config', 'document'];
const cmplx: [string, string][] = [
  ['simple', '简单'],
  ['moderate', '中等'],
  ['complex', '复杂']
];
---

<BaseLayout
  title={`${layer.name} · 源码图谱`}
  description={`${layer.name}：${layer.files} 个文件、${layer.classes} 个类、${layer.functions} 个方法；可平移缩放的依赖画布 + 节点详情`}
>
  <SiteHeader />
  <main class="mx-auto max-w-[1280px] px-4 pb-20 sm:px-6" id="g-root" data-layer={layer.id}>
    <div class="pt-6 text-[12px] text-ink3">
      <a href="/project" class="hover:text-ink">项目经历</a><span class="mx-2">/</span>
      <a href="/project/source" class="hover:text-ink">源码图谱</a><span class="mx-2">/</span><span class="text-ink2">{layer.name}</span>
    </div>

    <header class="mt-3 border-b border-line pb-4">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-zhu">{layer.id}</p>
          <h1 class="title-cn mt-1 text-[24px]">{layer.name}</h1>
          <p class="mt-1 max-w-[46em] text-[12.5px] leading-relaxed text-ink3">{layer.desc || '（这一层没有描述）'}</p>
        </div>
        <div class="flex flex-wrap gap-1.5 text-[11px]">
          <span class="chip border border-line text-ink2">{layer.files} 文件</span>
          <span class="chip border border-line text-ink2">{layer.classes} 类</span>
          <span class="chip border border-line text-ink2">{layer.functions} 方法</span>
          <span class="chip border border-line bg-surface2 text-ink3">{layer.edges} 依赖</span>
          <a href="/project/source/graph" class="chip border border-qing/40 bg-qingsoft/50 text-qing hover:border-qing">看全图 →</a>
        </div>
      </div>
    </header>

    <div class="mt-4 grid gap-3 lg:grid-cols-[220px_minmax(0,1fr)_300px]">
      <!-- 左：过滤 -->
      <aside class="order-2 space-y-3 rounded-xl border border-line bg-card p-3 text-[12px] lg:order-1">
        <div>
          <label for="g-search" class="text-[10.5px] font-semibold uppercase tracking-wider text-ink3">搜索</label>
          <input
            id="g-search"
            type="search"
            placeholder="类名 / 标签 / 摘要"
            class="mt-1 h-8 w-full rounded-lg border border-line bg-paper px-2 text-[12px] text-ink outline-none focus:border-zhu/50"
          />
        </div>
        <fieldset>
          <legend class="text-[10.5px] font-semibold uppercase tracking-wider text-ink3">类型</legend>
          <div class="mt-1 space-y-1">
            {types.map((t) => (
              <label class="flex items-center gap-1.5 text-[12px] text-ink2">
                <input type="checkbox" data-filter-type={t} checked class="h-3 w-3 accent-[var(--c-zhu)]" />
                {typeNames[t as keyof typeof typeNames]}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-[10.5px] font-semibold uppercase tracking-wider text-ink3">复杂度</legend>
          <div class="mt-1 space-y-1">
            {cmplx.map(([k, label]) => (
              <label class="flex items-center gap-1.5 text-[12px] text-ink2">
                <input type="checkbox" data-filter-cmplx={k} checked class="h-3 w-3 accent-[var(--c-zhu)]" />
                {label}
              </label>
            ))}
          </div>
        </fieldset>
        <div class="flex flex-wrap gap-1">
          <button type="button" id="g-layout" class="chip border border-line text-ink2 hover:border-zhu/40 hover:text-zhu">切换：分层泳道</button>
        </div>
        <p class="text-[10.5px] leading-relaxed text-ink3">滚轮缩放 · 拖拽平移 · 双击居中 · Esc 取消 · 悬停看名字</p>
      </aside>

      <!-- 中：画布 -->
      <section class="order-1 min-w-0 lg:order-2">
        <div class="flex items-center justify-between rounded-t-xl border border-line bg-card px-3 py-1.5 text-[11px] text-ink3">
          <span id="g-stats" class="g-loading">正在布局…</span>
          <span class="hidden items-center gap-1.5 sm:flex">
            <span class="text-ink3">节点越大 = 依赖越多</span>
          </span>
        </div>
        <div class="relative">
          <div
            id="g-canvas"
            class="h-[52vh] min-h-[320px] w-full overflow-hidden border-x border-line bg-card sm:h-[62vh] lg:h-[68vh]"
            role="application"
            aria-label={`${layer.name}依赖图画布`}
          >
          </div>
          <!-- 画布内的悬浮控制：比塞在左栏更符合「图上的操作在图边上」 -->
          <div class="absolute bottom-2 right-2 flex flex-col gap-1">
            <button type="button" id="g-zoom-in" aria-label="放大" class="flex h-7 w-7 items-center justify-center rounded-lg border border-line bg-card/95 text-[13px] text-ink2 shadow-sm backdrop-blur transition-colors hover:border-zhu/40 hover:text-zhu">＋</button>
            <button type="button" id="g-zoom-out" aria-label="缩小" class="flex h-7 w-7 items-center justify-center rounded-lg border border-line bg-card/95 text-[13px] text-ink2 shadow-sm backdrop-blur transition-colors hover:border-zhu/40 hover:text-zhu">－</button>
            <button type="button" id="g-reset" aria-label="适应画布" class="flex h-7 w-7 items-center justify-center rounded-lg border border-line bg-card/95 text-[12px] text-ink2 shadow-sm backdrop-blur transition-colors hover:border-zhu/40 hover:text-zhu">⤢</button>
          </div>
        </div>
        <!-- 图例：颜色 = 节点类型，大小 = 依赖数 -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-b-xl border border-line bg-card px-3 py-1.5 text-[10.5px] text-ink3">
          {types.map((t) => (
            <span class="inline-flex items-center gap-1">
              <i class="inline-block h-2 w-2 rounded-full" style={`background:${typeColors[t]}`}></i>
              {typeNames[t as keyof typeof typeNames]}
            </span>
          ))}
          <span class="ml-auto text-ink3/80">曲线箭头 = 依赖方向 · 虚线 = 继承/实现 · 点线 = 包含</span>
        </div>
        <noscript><p class="p-6 text-[12px] text-ink3">这个画布需要 JavaScript。关掉脚本时，可以改用 <a class="text-zhu underline" href="/project/source/tour">14 步导读</a> 或 <a class="text-zhu underline" href="/project/source/find">搜索</a> 浏览。</p></noscript>
        <div id="g-pathbar" class="mt-2 hidden items-center gap-2 rounded-lg border border-qing/30 bg-qingsoft/40 px-3 py-1.5 text-[11.5px] text-ink2">
          <span id="g-path-text" class="flex-1"></span>
          <button type="button" id="g-path-clear" class="text-qing hover:underline">清除路径</button>
        </div>
      </section>

      <!-- 右：详情 -->
      <aside class="order-3 rounded-xl border border-line bg-card p-3">
        <div id="g-detail">
          <p class="text-[12px] leading-relaxed text-ink3">点画布上的节点看摘要、依赖与相关面试题；拖拽空白处平移，滚轮缩放。</p>
        </div>
      </aside>
    </div>

    <section class="mt-4 flex flex-wrap gap-2 text-[11.5px]">
      {others.map((l) => (
        <a href={layerHref(l.id)} class="chip border border-line bg-card text-ink2 transition-colors hover:border-zhu/40 hover:text-zhu">
          {l.name} <span class="text-ink3">· {l.nodes}</span>
        </a>
      ))}
    </section>

    <p class="mt-6 border-t border-line pt-3 text-[10.5px] leading-relaxed text-ink3">
      快照 {graphDate(graphMeta.sourceMtime)} · AI 摘要（非逐行核对）· 数据由 oneCoupon 的 .ua/knowledge-graph.json 生成，代码改动后 <span class="font-mono">pnpm graph:build</span>
    </p>
  </main>

  <script
    type="application/json"
    id="g-config"
    set:html={JSON.stringify({
      dataUrl: `/data/graph/layer-${layer.id}.json`,
      layerNames: Object.fromEntries(graphMeta.layers.map((l) => [l.id, l.name])),
      layerColors,
      typeNames,
      typeColors,
      colorMode: 'type',
      mode: 'layer'
    })}
  />
  <script>
    import { bootGraphPage } from '../../../lib/graph-page';

    const cfg = document.getElementById('g-config');
    if (cfg) {
      const opts = JSON.parse(cfg.textContent || '{}');
      const focus = new URLSearchParams(location.search).get('focus') || undefined;
      bootGraphPage({ ...opts, initialFocus: focus });
    }
  </script>
</BaseLayout>
