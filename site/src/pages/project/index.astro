---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TopicGraph from '../../components/TopicGraph.astro';
import { projectMeta, projectOnlyModules, projectModules, moduleQuestions, projectOnlyStats, statusLabel, starText } from '../../lib/project';

const stats = projectOnlyStats();
const byModule = projectOnlyModules.map((m) => ({ ...m, items: moduleQuestions(m.key) }));
const pending = byModule.reduce((s, m) => s + m.items.filter((q) => q.status === 'pending').length, 0);
---

<BaseLayout title="项目经历 · 券享购 OneCoupon" description="秋招项目复盘：源码锚点 + 三层口述稿 + 评审">
  <SiteHeader />
  <main class="mx-auto max-w-[1100px] px-6 pb-24">
    <header class="border-b border-line pt-10 pb-7">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-zhu">PROJECT · 券享购 OneCoupon</p>
          <h1 class="title-cn mt-3 text-[32px]">项目经历：先对着源码讲清楚，再背下来</h1>
          <p class="mt-3 max-w-[46em] text-[13.5px] leading-relaxed text-ink3">
            {stats.total} 题（第一批主线）· 已评审 {stats.scoredCount} 题 · 平均 {stats.avg} 分 · 待撰写 {pending} 题。
            每题都带<strong class="text-ink2">源码锚点</strong>（文件 + 符号 + 行号）与<strong class="text-ink2">三层口述稿</strong>（60 秒 / 3 分钟 / 深挖），
            评审用的是项目类 Rubric：源码一致性 30 + 技术准确 25 + 面试完整 20 + 深度取舍 15 + 可背性 10。
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-2 text-[12px]">
            <a href="/project/review" class="chip border border-zhu/40 bg-zhusoft/50 text-zhu transition-colors hover:border-zhu">今日复习</a>
            <a href="/project/flashcards" class="chip border border-line text-ink2 transition-colors hover:text-ink">闪卡</a>
            <a href="/project/drill" class="chip border border-line text-ink2 transition-colors hover:text-ink">关键词默写</a>
            <a href="/project/sheet" class="chip border border-line text-ink2 transition-colors hover:text-ink">一页纸</a>
            <a href="/project/diagrams" class="chip border border-line text-ink2 transition-colors hover:text-ink">架构图</a>
            <a href="/project/find" class="chip border border-line text-ink2 transition-colors hover:text-ink">搜索</a>
            <a href="/project/guide" class="chip border border-line text-ink2 transition-colors hover:text-ink">怎么用</a>
            <a href="/project/map" class="chip border border-line text-ink2 transition-colors hover:text-ink">源码地图</a>
            <a href="/project/numbers" class="chip border border-line text-ink2 transition-colors hover:text-ink">数字总表</a>
            <a href="/project/read" class="chip border border-zhu/40 bg-zhusoft/50 text-zhu transition-colors hover:border-zhu">原文全文</a>
          </div>
        </div>
        <aside class="lg:pt-2">
          <TopicGraph topic="project" caption="七个模块取自 project-meta.json，题数来自实际题库统计" />
        </aside>
      </div>
    </header>

    <section class="mt-8">
      <figure class="overflow-hidden rounded-xl border border-line bg-card p-3">
        <img
          src="/diagrams/project-overview.svg"
          alt="OneCoupon 项目总览：六个模块与中间件"
          class="mx-auto block w-full max-w-[860px]"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="mt-3 border-t border-line pt-2 text-[11.5px] leading-relaxed text-ink3">
          项目总览：接入层 → 业务服务 → 异步与调度 → 存储 → 底座。每道题页里还有该题自己的结构图或执行链路图。
        </figcaption>
      </figure>
    </section>

    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      {byModule.map((m) => (
        <a href={`/project/${m.en}`} class="group rounded-xl border border-line bg-card p-5 transition-colors hover:border-zhu/40">
          <div class="flex items-baseline justify-between">
            <h2 class="title-cn text-[17px] group-hover:text-zhu">{m.name}</h2>
            <span class="text-[11px] tracking-wide text-ink3">{m.en}</span>
          </div>
          <p class="mt-2 text-[12.5px] leading-relaxed text-ink3">{m.desc}</p>
          <div class="mt-4 flex items-center gap-3 text-[11.5px] text-ink3">
            <span class="text-zhu">{m.items.length} 题</span>
            <span class="h-3 w-px bg-line"></span>
            <span>已评审 {m.items.filter((q) => q.review.total > 0).length}</span>
          </div>
        </a>
      ))}
    </section>

    <section class="mt-12">
      <div class="flex items-baseline justify-between border-b border-line pb-2">
        <h2 class="title-cn text-[18px]">全部题目</h2>
        <span class="text-[12px] text-ink3">按模块顺序</span>
      </div>
      <ul class="divide-y divide-line">
        {byModule.flatMap((m) => m.items.map((q) => (
          <li>
            <a href={`/project/${m.en}/${q.id}`} class="flex items-baseline gap-4 py-3 transition-colors hover:bg-zhusoft/40">
              <span class="w-[62px] shrink-0 font-mono text-[11.5px] text-ink3">{q.id}</span>
              <span class="flex-1 text-[14px] text-ink">{q.title}</span>
              <span class="shrink-0 text-[11.5px] text-zhu">{starText(q.star)}</span>
              <span class="w-[86px] shrink-0 text-right text-[11.5px] text-ink3">
                {q.review.total > 0 ? `${q.review.total} 分` : statusLabel[q.status]}
              </span>
            </a>
          </li>
        )))}
      </ul>
    </section>

    <section class="mt-12 rounded-xl border border-line bg-card p-6">
      <h2 class="title-cn text-[16px]">怎么用这个站</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-3 text-[12.5px] leading-relaxed text-ink2">
        <div>
          <p class="text-zhu">背诵</p>
          <p class="mt-1 text-ink3">从 60 秒稿开始，只背关键词锚；能不看稿说完整段再进 3 分钟稿。</p>
        </div>
        <div>
          <p class="text-zhu">查阅</p>
          <p class="mt-1 text-ink3">做题前先看「源码锚点」，对照真实类名与行号，别背成别人项目的东西。</p>
        </div>
        <div>
          <p class="text-zhu">解惑</p>
          <p class="mt-1 text-ink3">看不懂就看「追问」和「坑」两节，那里写了面试官会从哪打断。</p>
        </div>
      </div>
      <p class="mt-5 border-t border-line pt-4 text-[11.5px] leading-relaxed text-ink3">
        内容源：{projectMeta.sourceDoc} · 评审口径：_review/project_rubric.md · 源码基准：E:\Project\onecoupon
      </p>
    </section>
  </main>
</BaseLayout>
