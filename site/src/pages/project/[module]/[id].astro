---
import QuestionDetail from '../../../components/QuestionDetail.astro';
import { allProjectQuestions, projectModules, AI_MODULE_KEYS, MW_MODULE_KEYS } from '../../../lib/project';

export function getStaticPaths() {
  return allProjectQuestions
    .filter((q) => !(AI_MODULE_KEYS as readonly string[]).includes(q.module) && !(MW_MODULE_KEYS as readonly string[]).includes(q.module))
    .map((q) => {
      const mod = projectModules.find((m) => m.key === q.module)!;
      return { params: { module: mod.en, id: q.id }, props: { q, mod } };
    });
}

const { q, mod } = Astro.props as { q: any; mod: any };
---

<QuestionDetail q={q} mod={mod} base="/project" sectionLabel="项目经历" tone="zhu" repo="E:\Project\onecoupon" />
