---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const links = [
  { href: '/notes', label: 'Java 基础 58 题', note: 'JVM / 并发 / 集合' },
  { href: '/hot200', label: 'Hot200 手撕', note: '103 题 · 带参考代码与默写' },
  { href: '/project', label: '项目 355 题', note: '8 个真实项目拷打' },
  { href: '/mysql', label: 'MySQL 46 题', note: '索引 / 事务 / 调优' },
  { href: '/mw', label: '中间件 48 题', note: 'Redis / MQ / ES / Kafka' },
  { href: '/ai', label: 'AI 68 题', note: 'Ragent / RAG / 评测' },
  { href: '/train', label: '训练场 103 题', note: 'Java 进阶 / 手写 / 场景' },
  { href: '/search', label: '全站搜索', note: '按标题、模块、标签找题' }
];
---

<BaseLayout title="页面不存在 · Java 终极笔记" description="404：这个地址没有内容，可以从下面的入口重新找。">
  <SiteHeader />
  <main class="mx-auto max-w-[880px] px-6 py-20">
    <p class="font-mono text-[13px] text-ink3">404 / NOT FOUND</p>
    <h1 class="title-cn mt-3 text-[30px] leading-snug text-ink sm:text-[36px]">这一页不在笔记里</h1>
    <p class="mt-3 text-[13.5px] leading-relaxed text-ink2">
      可能是地址拼错、或者是旧链接（题库改过一次路径）。下面挑一个入口，或者直接搜：
    </p>

    <form action="/search" method="get" class="mt-6 flex max-w-[520px] gap-2">
      <input
        name="q"
        type="search"
        placeholder="搜题目 / 关键词，例如「接雨水」「索引下推」"
        class="min-w-0 flex-1 rounded-lg border border-line bg-surface px-3 py-2 text-[13px] text-ink outline-none focus:border-zhu/50"
      />
      <button type="submit" class="rounded-lg bg-zhu px-4 py-2 text-[13px] font-medium text-white">搜索</button>
    </form>

    <div class="mt-10 grid gap-3 sm:grid-cols-2">
      {links.map((l) => (
        <a
          href={l.href}
          class="group flex items-baseline justify-between gap-3 rounded-xl border border-line bg-surface/60 px-4 py-3 transition-colors hover:border-zhu/40"
        >
          <span class="text-[13.5px] text-ink group-hover:text-zhu">{l.label}</span>
          <span class="shrink-0 text-[11.5px] text-ink3">{l.note}</span>
        </a>
      ))}
    </div>

    <p class="mt-10 text-[12.5px] text-ink3">
      也可以回 <a href="/" class="text-zhu hover:underline">首页</a>，那里有评分分布和今日复习。
    </p>
  </main>
</BaseLayout>
