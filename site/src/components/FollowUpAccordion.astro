---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="space-y-2.5">
  {items.map((it, i) => (
    <details class="fu card group px-5 py-3">
      <summary class="flex cursor-pointer list-none items-start gap-3 text-[14px] font-medium">
        <span class="fu-chev mt-[3px] text-ink3">▸</span>
        <span class="flex-1">Q{i + 1}：{it.q}</span>
      </summary>
      <div class="mt-3 border-l-2 border-zhu/30 pl-4">
        <p class="fu-a text-[14px] leading-relaxed text-ink2">{it.a}</p>
        <button
          type="button"
          class="fu-btn mt-2 text-[12px] text-zhu underline-offset-2 hover:underline"
          data-target={`fu-${i}`}
        >
          揭开标准答法
        </button>
      </div>
    </details>
  ))}
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('.fu-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const box = btn.parentElement?.querySelector('.fu-a');
        if (!box) return;
        const on = box.classList.toggle('revealed');
        btn.textContent = on ? '再遮住' : '揭开标准答法';
      });
    });
  })();
</script>
