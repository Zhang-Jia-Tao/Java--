/**
 * TopicGraph.astro — 模块首页的「模块主题图」
 *
 * 自包含：纯 SVG + CSS 动画 + 一小段原生 JS（inline，不 import 任何包）。
 * 与首页那张全站交互图（ModuleGraph.astro）用同一套视觉与动画手法，只是更小、更聚焦：
 * - 一个中心节点（本模块自己，点击回模块首页）+ 5–7 个主题节点环绕
 * - 颜色只取站点 CSS 变量，深色模式自动跟随；组件内零十六进制 / rgb 字面量
 * - 所有坐标（环形角度、贝塞尔控制点、箭头顶点）都在 frontmatter 用 Math.cos/sin 算好
 * - 尊重 prefers-reduced-motion：关掉虚线流动与粒子，只留静态连线（粒子层由脚本整层移除）
 * - topic 不存在时什么都不渲染，不抛错
 */

interface Props {
  topic: string;
  caption?: string;
}

const { topic, caption } = Astro.props;

/** 站点调色板里的四种语气（对应 --c-* 变量，不出现任何颜色字面量） */
type Tone = 'zhu' | 'qing' | 'accent' | 'ink' | 'ink2';

interface NodeSeed {
  id: string;
  /** 圆内短标签：2–4 个汉字最佳，最多 6 个（长标签会溢出圆，别写长） */
  label: string;
  /** 悬停时在图表下方那一行显示的说明 */
  summary: string;
  color: Tone;
  /** 有落地页才可点；没有就只做悬停说明 */
  href?: string;
}

interface TopicSeed {
  /** 中心节点：本模块自己 */
  center: string;
  href: string;
  nodes: NodeSeed[];
  /** [from, to, 悬停说明]；from 用 '__center' 表示中心节点 */
  edges: [string, string, string][];
}

/* ──────────────────────────────────────────────────────────────
 * TOPICS：九张图的内容，逐条对着数据核过，没有一条是编的
 *  - notes  ← src/data/chapters.json（章名 / 题量 / 均分）
 *  - hot200 ← src/lib/hot200.ts 的分组顺序 + 题目 category 统计
 *  - project / mysql / mw / ai / train ← src/data/project-meta.json + 每题的 tags
 *  - intern ← src/data/intern/_alias.json 的四个项目 + 两个专页
 *  - review ← src/pages/review.astro 的三个区块 + 两个批注页
 * ────────────────────────────────────────────────────────────── */
