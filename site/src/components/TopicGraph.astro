const CY = 104;
const RX = 126;
const RY = 68;
const R_C = 24; // 中心节点半径
const DEG = Math.PI / 180;

const TONES: Record<Tone, { c: string; soft: string }> = {
  zhu: { c: 'var(--c-zhu)', soft: 'var(--c-zhu-soft)' },
  qing: { c: 'var(--c-qing)', soft: 'var(--c-qing-soft)' },
  accent: { c: 'var(--c-accent)', soft: 'var(--c-accent-soft)' },
  ink: { c: 'var(--c-ink)', soft: 'var(--c-line)' },
  ink2: { c: 'var(--c-ink-2)', soft: 'var(--c-line)' }
};

const round2 = (n: number): number => Math.round(n * 100) / 100;
const unit = (x: number, y: number): [number, number] => {
  const len = Math.hypot(x, y) || 1;
  return [x / len, y / len];
};

const seed: TopicSeed | undefined = TOPICS[topic];
const t: TopicSeed = seed ?? { center: '', href: '', nodes: [], edges: [] };

const count = Math.max(1, t.nodes.length);
/* 7 个外周节点时收紧半径，免得标签互相压到；测过 9 张图里最宽的 4 字标签仍能装下 */
const R_OUT = t.nodes.length >= 7 ? 15.2 : 16;

interface GNode {
  id: string;
  label: string;
  summary: string;
  href: string;
  x: number;
  y: number;
  vars: string;
  delay: string;
}

const outer: GNode[] = t.nodes.map((node, slot) => {
  const angle = (-90 + (360 / count) * slot) * DEG;
  const tone = TONES[node.color];
  return {
    id: node.id,
    label: node.label,
    summary: node.summary,
    href: node.href ?? '',
    x: round2(CX + Math.cos(angle) * RX),
    y: round2(CY + Math.sin(angle) * RY),
    vars: `--tg-c:${tone.c};--tg-soft:${tone.soft}`,
    delay: (slot * 0.42).toFixed(2)
  };
});

/** 坐标表：'__center' 是中心节点 */
interface Pos {
  x: number;
  y: number;
  r: number;
}
const pos: Record<string, Pos> = { __center: { x: CX, y: CY, r: R_C } };
for (const node of outer) pos[node.id] = { x: node.x, y: node.y, r: R_OUT };

const toneOf: Record<string, Tone> = {};
for (const node of t.nodes) toneOf[node.id] = node.color;

/* ── 箭头：尖端贴着目标节点外沿 2px，指向节点圆心 ───────────────── */
const arrowHead = (tipX: number, tipY: number, dirX: number, dirY: number): string => {
  const [ux, uy] = unit(dirX, dirY);
  const baseX = tipX - ux * 7.5;
  const baseY = tipY - uy * 7.5;
  const [nx, ny] = unit(-uy, ux);
  const w = 3.1;
  return [
    `M ${round2(tipX)} ${round2(tipY)}`,
    `L ${round2(baseX + nx * w)} ${round2(baseY + ny * w)}`,
    `L ${round2(baseX - nx * w)} ${round2(baseY - ny * w)}`,
    'Z'
  ].join(' ');
};

interface GEdge {
  key: string;
  from: string;
  to: string;
  desc: string;
  title: string;
  d: string;
  arrow: string;
  color: string;
  vars: string;
  dur: number;
  begin: number;
}

const edges: GEdge[] = t.edges.flatMap(([from, to, desc], i) => {
  const a = pos[from];
  const b = pos[to];
  if (!a || !b) return [];

  const isSpoke = from === '__center';
  const chord = Math.hypot(b.x - a.x, b.y - a.y) || 1;
  const [px, py] = unit(-(b.y - a.y), b.x - a.x);
  const midX = (a.x + b.x) / 2;
  const midY = (a.y + b.y) / 2;

  // 辐条：统一朝一个旋向弓 9px，形成轻微漩涡；跨节点连线：背向中心弓，避免压在中心节点上
  let sign = 1;
  if (!isSpoke) {
    const towardCenter = (CX - midX) * px + (CY - midY) * py;
    sign = towardCenter === 0 ? 1 : -Math.sign(towardCenter);
  }
  const bow = isSpoke ? 9 : Math.min(18, Math.max(9, chord * 0.14));
  const cX = round2(midX + px * bow * sign);
  const cY = round2(midY + py * bow * sign);

  // 起点/终点都退到圆外，按曲线切线方向算，箭头才贴得住
  const [t0x, t0y] = unit(cX - a.x, cY - a.y);
  const [t1x, t1y] = unit(b.x - cX, b.y - cY);
  const sx = round2(a.x + t0x * a.r);
  const sy = round2(a.y + t0y * a.r);
  const tipX = round2(b.x - t1x * (b.r + 2));
  const tipY = round2(b.y - t1y * (b.r + 2));

  const colorTone = isSpoke ? toneOf[to] : toneOf[from];
  const color = TONES[colorTone ?? 'ink2'].c;
  const dur = round2(2.9 + ((i * 29) % 21) / 10); // 2.9 – 4.9s
  const begin = round2(-(((i * 17) % 35) / 10));

  const fromLabel = from === '__center' ? t.center : (outer.find((n) => n.id === from)?.label ?? from);
  const toLabel = to === '__center' ? t.center : (outer.find((n) => n.id === to)?.label ?? to);

  return [
    {
      key: `${from}-${to}`,
      from,
      to,
      desc,
      title: `${fromLabel} → ${toLabel} · ${desc}`,
      d: `M ${sx} ${sy} Q ${cX} ${cY} ${tipX} ${tipY}`,
      arrow: arrowHead(tipX, tipY, t1x, t1y),
      color,
      vars: `--tg-c:${color};--tg-delay:${(-i * 0.55).toFixed(2)}s;--tg-dur:${dur.toFixed(1)}s`,
      dur,
      begin
    }
  ];
});

/* 流动粒子层：字符串生成，保证 <animateMotion> 大小写在任意渲染路径下都正确 */
const particleMarkup: string = edges
  .map(
    (edge) =>
      `<circle class="tg-particle" r="2" style="--tg-c:${edge.color}">` +
      `<animateMotion dur="${edge.dur.toFixed(1)}s" begin="${edge.begin.toFixed(1)}s" repeatCount="indefinite" path="${edge.d}">` +
      `</animateMotion></circle>`
  )
  .join('');

const centerLines: string[] = t.center.split(/\s+/).filter(Boolean);
const centerSummary = `${t.center} · 本模块首页，点这里回到入口`;
const DEFAULT_NOTE = '悬停任意节点或连线：高亮它的相邻关系，并在这一行给出说明';
const ariaLabel = seed
  ? `${t.center}主题图：中心是本模块，周围是 ${t.nodes.map((n) => n.label).join('、')} ${t.nodes.length} 个主题`
  : '模块主题图';
---

{
  seed ? (
    <div class="w-full max-w-[400px]" data-tg>
      <div class="rounded-xl border border-line bg-surface px-4 py-3">
        <div class="flex items-baseline justify-between">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-zhu">模块主题图</p>
          <span class="text-[10.5px] tracking-[0.14em] text-ink3">TOPIC GRAPH</span>
        </div>

        <svg class="tg mt-1" viewBox="0 0 380 210" role="img" aria-label={ariaLabel}>
          <title>{ariaLabel}</title>

          {/* 连线层 */}
          <g class="tg-edges" aria-hidden="true">
            {edges.map((edge) => (
              <g
                class="tg-edge"
                data-tg-edge
                data-from={edge.from}
                data-to={edge.to}
                data-desc={edge.title}
                style={edge.vars}
              >
                <path class="tg-path" d={edge.d} />
                <path class="tg-arrow" d={edge.arrow} />
                <path class="tg-hit" d={edge.d} />
              </g>
            ))}
          </g>

          {/* 流动粒子层（reduced-motion 下由脚本整层移除） */}
          <g data-tg-particles aria-hidden="true" set:html={particleMarkup} />

          {/* 节点层 */}
          <g class="tg-nodes">
            <a
              class="tg-node is-center is-link"
              href={t.href}
              data-tg-node="__center"
              data-summary={centerSummary}
              style={`--tg-c:${TONES.ink.c};--tg-soft:${TONES.ink.soft};--tg-pd:0s`}
            >
              <title>{t.center}</title>
              <circle class="tg-pulse" cx={CX} cy={CY} r={R_C} />
              <circle class="tg-halo" cx={CX} cy={CY} r={R_C * 1.4} />
              <circle class="tg-dot" cx={CX} cy={CY} r={R_C} />
              {centerLines.length > 1 ? (
                <text class="tg-label" x={CX} y={CY}>
                  <tspan x={CX} dy="-4.6">{centerLines[0]}</tspan>
                  <tspan x={CX} dy="9.4">{centerLines[1]}</tspan>
                </text>
              ) : (
                <text class="tg-label" x={CX} y={CY}>{t.center}</text>
              )}
            </a>

            {outer.map((node) =>
              node.href ? (
                <a
                  class="tg-node is-link"
                  href={node.href}
                  data-tg-node={node.id}
                  data-summary={node.summary}
                  style={`${node.vars};--tg-pd:${node.delay}s`}
                >
                  <title>{node.label}</title>
                  <circle class="tg-halo" cx={node.x} cy={node.y} r={R_OUT * 1.45} />
                  <circle class="tg-dot" cx={node.x} cy={node.y} r={R_OUT} />
                  <text class="tg-label" x={node.x} y={node.y}>{node.label}</text>
                </a>
              ) : (
                <g
                  class="tg-node"
                  data-tg-node={node.id}
                  data-summary={node.summary}
                  style={`${node.vars};--tg-pd:${node.delay}s`}
                >
                  <title>{node.label}</title>
                  <circle class="tg-halo" cx={node.x} cy={node.y} r={R_OUT * 1.45} />
                  <circle class="tg-dot" cx={node.x} cy={node.y} r={R_OUT} />
                  <text class="tg-label" x={node.x} y={node.y}>{node.label}</text>
                </g>
              )
            )}
          </g>
        </svg>

        {caption ? (
          <p class="mt-1 text-[10.5px] leading-[1.5] text-ink3 opacity-80">{caption}</p>
        ) : null}
        <p class="mt-1 min-h-[35px] text-[11.5px] leading-[1.5] text-ink3" data-tg-note aria-live="polite">
          {DEFAULT_NOTE}
        </p>
      </div>
    </div>
  ) : null
}

<style is:global>
  /* ── 画布 ─────────────────────────────────────────────── */
  .tg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    -webkit-tap-highlight-color: transparent;
  }

  /* ── 连线：流动虚线 ───────────────────────────────────── */
  .tg-edge {
    opacity: 0.6;
    transition: opacity 0.18s ease;
  }
  .tg-edge .tg-path {
    fill: none;
    stroke: var(--tg-c);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 12 5;
    animation: tg-flow var(--tg-dur, 4s) linear infinite;
    animation-delay: var(--tg-delay, 0s);
  }
  .tg-edge .tg-arrow {
    fill: var(--tg-c);
    opacity: 0.9;
  }
  .tg-edge .tg-hit {
    fill: none;
    stroke: transparent;
    stroke-width: 13;
    pointer-events: stroke;
  }

  /* ── 流动粒子 ─────────────────────────────────────────── */
  .tg-particle {
    fill: var(--tg-c);
    opacity: 0.9;
    pointer-events: none;
  }

  /* ── 节点 ─────────────────────────────────────────────── */
  .tg-node {
    text-decoration: none;
  }
  .tg-node.is-link {
    cursor: pointer;
  }
  .tg-node .tg-dot {
    fill: var(--c-surface);
    stroke: var(--tg-c);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.18s ease;
  }
  .tg-node .tg-halo {
    fill: var(--tg-soft);
    opacity: 0;
    pointer-events: none;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.18s ease;
  }
  .tg-node .tg-pulse {
    fill: none;
    stroke: var(--tg-c);
    stroke-width: 0.9;
    opacity: 0;
    pointer-events: none;
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-pulse 5s ease-out infinite;
    animation-delay: var(--tg-pd, 0s);
  }
  .tg-node.is-center .tg-dot {
    stroke-width: 1.8;
  }
  .tg-node .tg-label {
    font-family: var(--font-sans, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-anchor: middle;
    dominant-baseline: central;
    fill: var(--c-ink);
    pointer-events: none;
    user-select: none;
  }
  .tg-node.is-center .tg-label {
    font-size: 9.5px;
  }
  .tg-node:hover .tg-dot,
  .tg-node:focus-visible .tg-dot {
    transform: scale(1.18);
  }
  .tg-node:hover .tg-halo,
  .tg-node:focus-visible .tg-halo {
    opacity: 1;
  }
  .tg-node:focus {
    outline: none;
  }
  .tg-node:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
    border-radius: 999px;
  }

  /* ── 聚焦：该节点与相邻连线亮，其余降噪到 0.18 ─────────── */
  .tg[data-focus] .tg-edge {
    opacity: 0.18;
  }
  .tg[data-focus] .tg-edge.is-hot {
    opacity: 1;
  }
  .tg[data-focus] .tg-node {
    opacity: 0.18;
  }
  .tg[data-focus] .tg-node.is-hot {
    opacity: 1;
  }

  /* ── 动画 ─────────────────────────────────────────────── */
  @keyframes tg-flow {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -34;
    }
  }
  @keyframes tg-pulse {
    0% {
      transform: scale(0.94);
      opacity: 0.45;
    }
    65% {
      opacity: 0;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* ── 尊重系统「减少动态效果」：关掉流动与粒子，只留静态连线 ── */
  @media (prefers-reduced-motion: reduce) {
    .tg-edge .tg-path,
    .tg-particle {
      animation: none !important;
    }
    .tg-particle {
      display: none !important;
    }
    .tg-node .tg-pulse {
      animation: none !important;
      opacity: 0 !important;
    }
    .tg-edge,
    .tg-node .tg-dot,
    .tg-node .tg-halo {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  // 原生 JS：交互高亮 + reduced-motion（不依赖任何框架）
  (() => {
    const DEFAULT_NOTE = '悬停任意节点或连线：高亮它的相邻关系，并在这一行给出说明';
    const roots = Array.from(document.querySelectorAll('[data-tg]'));

    roots.forEach((root) => {
      if (root.dataset.tgReady === '1') return;
      root.dataset.tgReady = '1';

      const svg = root.querySelector('svg.tg');
      const note = root.querySelector('[data-tg-note]');
      const nodes = Array.from(root.querySelectorAll('[data-tg-node]'));
      const edges = Array.from(root.querySelectorAll('[data-tg-edge]'));
      if (!svg) return;

      const setNote = (text) => {
        if (note && text) note.textContent = text;
      };

      const clear = () => {
        svg.removeAttribute('data-focus');
        root.querySelectorAll('.is-hot').forEach((el) => el.classList.remove('is-hot'));
        setNote(DEFAULT_NOTE);
      };

      const highlight = (id, summary) => {
        svg.setAttribute('data-focus', id);
        nodes.forEach((n) => n.classList.toggle('is-hot', n.dataset.tgNode === id));
        edges.forEach((e) => e.classList.toggle('is-hot', e.dataset.from === id || e.dataset.to === id));
        setNote(summary);
      };

      const highlightEdge = (edge) => {
        const from = edge.dataset.from;
        const to = edge.dataset.to;
        svg.setAttribute('data-focus', 'edge');
        nodes.forEach((n) => {
          const id = n.dataset.tgNode;
          n.classList.toggle('is-hot', id === from || id === to);
        });
        edges.forEach((e) => e.classList.toggle('is-hot', e === edge));
        setNote(edge.dataset.desc);
      };

      const leavingGraph = (ev) => {
        const next = ev.relatedTarget;
        if (!next || !next.closest || !next.closest('[data-tg-node],[data-tg-edge]')) clear();
      };

      nodes.forEach((node) => {
        const id = node.dataset.tgNode;
        const summary = node.dataset.summary || '';
        node.addEventListener('pointerenter', () => highlight(id, summary));
        node.addEventListener('pointerleave', leavingGraph);
        node.addEventListener('focus', () => highlight(id, summary));
        node.addEventListener('blur', () => clear());
      });

      edges.forEach((edge) => {
        const hit = edge.querySelector('.tg-hit');
        if (!hit) return;
        hit.addEventListener('pointerenter', () => highlightEdge(edge));
        hit.addEventListener('pointerleave', leavingGraph);
      });

      svg.addEventListener('pointerleave', clear);

      /* ── prefers-reduced-motion：整层移除流动粒子 ────────── */
      const layer = root.querySelector('[data-tg-particles]');
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      let particleMarkup = '';

      const syncMotion = () => {
        if (!layer) return;
        if (motionQuery.matches) {
          if (layer.childElementCount) particleMarkup = layer.innerHTML;
          layer.innerHTML = '';
        } else if (!layer.childElementCount && particleMarkup) {
          layer.innerHTML = particleMarkup;
          layer.querySelectorAll('animateMotion').forEach((motion) => {
            if (typeof motion.beginElement === 'function') {
              try {
                motion.beginElement();
              } catch (_err) {
                /* 忽略：动画重启失败不影响静态连线 */
              }
            }
          });
        }
      };

      syncMotion();
      if (typeof motionQuery.addEventListener === 'function') {
        motionQuery.addEventListener('change', syncMotion);
      } else if (typeof motionQuery.addListener === 'function') {
        motionQuery.addListener(syncMotion);
      }
    });
  })();
</script>
