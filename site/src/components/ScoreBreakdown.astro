---
interface Props {
  score: { A: number; B: number; C: number; D: number; E: number };
}
const { score } = Astro.props;

const dims = [
  { k: 'A', name: '准确性', max: 40, color: 'var(--c-a)' },
  { k: 'B', name: '完整性', max: 25, color: 'var(--c-b)' },
  { k: 'C', name: '深度原理', max: 20, color: 'var(--c-b)' },
  { k: 'D', name: '结构表达', max: 10, color: 'var(--c-a)' },
  { k: 'E', name: '项目结合', max: 5, color: 'var(--c-c)' }
] as const;

const totalMax = 100;
const values = dims.map((d) => ({ ...d, got: (score as any)[d.k] as number }));
---

<div class="space-y-4">
  <div class="flex h-3 w-full overflow-hidden rounded-full bg-surface2">
    {values.map((v) => (
      <div style={`width: ${(v.max / totalMax) * 100}%; background: ${v.color}; opacity: ${0.2 + (v.got / v.max) * 0.8}`}></div>
    ))}
  </div>

  <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
    {values.map((v) => (
      <li class="flex items-center gap-3 text-[13px]">
        <span class="w-4 shrink-0 font-mono text-ink3">{v.k}</span>
        <span class="w-16 shrink-0 text-ink2">{v.name}</span>
        <span class="h-1.5 flex-1 overflow-hidden rounded-full bg-surface2">
          <span
            class="block h-full rounded-full"
            style={`width: ${(v.got / v.max) * 100}%; background: ${v.color}`}
          />
        </span>
        <span class="tabular w-14 shrink-0 text-right text-ink2">
          {v.got}<span class="text-ink3">/{v.max}</span>
        </span>
      </li>
    ))}
  </ul>
</div>
