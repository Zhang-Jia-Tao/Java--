---
interface Props {
  prev?: { id: string; title: string; href: string };
  next?: { id: string; title: string; href: string };
}
const { prev, next } = Astro.props;
---

<nav class="mt-14 flex items-stretch justify-between gap-4 border-t border-line pt-6 text-[13px]">
  {prev ? (
    <a href={prev.href} class="group flex-1 rounded-lg px-3 py-2 transition-colors hover:bg-surface2">
      <span class="block text-[11px] text-ink3">← 上一题 {prev.id}</span>
      <span class="mt-0.5 block truncate text-ink2 group-hover:text-ink">{prev.title}</span>
    </a>
  ) : (
    <span class="flex-1"></span>
  )}
  {next ? (
    <a href={next.href} class="group flex-1 rounded-lg px-3 py-2 text-right transition-colors hover:bg-surface2">
      <span class="block text-[11px] text-ink3">下一题 {next.id} →</span>
      <span class="mt-0.5 block truncate text-ink2 group-hover:text-ink">{next.title}</span>
    </a>
  ) : (
    <span class="flex-1"></span>
  )}
</nav>
