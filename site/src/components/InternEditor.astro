---
/**
 * 实习经历页的内联编辑 + 保存。
 * - 只在内含 [data-intern-root] 的页面生效
 * - 修改先落 localStorage，再同步到本地服务（scripts/anno-server.mjs，默认 4400）
 * - 支持变更记录、导出 JSON / Markdown、回写脚本（scripts/intern-apply.mjs）
 */
---

<style is:inline>
  [data-edit] {
    position: relative;
  }
  [data-edit][data-editing='1'] {
    outline: 1.5px dashed color-mix(in srgb, var(--c-zhu) 55%, transparent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  [data-edit][data-dirty='1']::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--c-zhu) 55%, transparent);
  }
  body[data-intern-editmode='1'] [data-edit] {
    cursor: text;
    outline: 1px dashed color-mix(in srgb, var(--c-line) 90%, transparent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  body[data-intern-editmode='1'] [data-edit]:hover {
    outline-color: color-mix(in srgb, var(--c-zhu) 45%, transparent);
    background: color-mix(in srgb, var(--c-zhu-soft) 35%, transparent);
  }
  .intern-edit-area {
    width: 100%;
    min-height: 2.2em;
    resize: none;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--c-zhu) 45%, transparent);
    border-radius: 6px;
    padding: 6px 8px;
    background: var(--c-surface);
    color: var(--c-ink);
    font: inherit;
    line-height: 1.85;
    outline: none;
  }
  #intern-bar {
    position: fixed;
    right: 18px;
    bottom: 70px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-card);
    font-size: 12px;
  }
  #intern-bar button {
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid transparent;
    color: var(--c-ink-2);
    transition: all 0.15s;
  }
  #intern-bar button:hover {
    border-color: var(--c-line);
    color: var(--c-ink);
  }
  #intern-bar button[data-on='1'] {
    border-color: color-mix(in srgb, var(--c-zhu) 45%, transparent);
    background: color-mix(in srgb, var(--c-zhu-soft) 60%, transparent);
    color: var(--c-zhu);
  }
  #intern-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--c-ink-3);
    margin: 0 2px 0 6px;
  }
  #intern-panel {
    position: fixed;
    right: 18px;
    bottom: 118px;
    z-index: 61;
    width: min(420px, calc(100vw - 36px));
    max-height: 52vh;
    overflow: auto;
    padding: 12px 14px;
    border: 1px solid var(--c-line);
    border-radius: 12px;
    background: var(--c-surface);
    box-shadow: var(--shadow-card);
    font-size: 12px;
    line-height: 1.75;
    color: var(--c-ink-2);
  }
  #intern-panel h4 {
    font-size: 12px;
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: 6px;
  }
  #intern-panel li {
    padding: 5px 0;
    border-bottom: 1px dashed var(--c-line);
  }
  #intern-panel li:last-child {
    border-bottom: none;
  }
  #intern-panel code {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--c-zhu);
  }
  #intern-panel button[data-rollback] {
    font-size: 11px;
    color: var(--c-zhu);
    text-decoration: underline;
  }
  #intern-toast {
    position: fixed;
    right: 18px;
    bottom: 122px;
    z-index: 62;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-ink) 88%, transparent);
    color: var(--c-bg);
    font-size: 12px;
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.2s;
    pointer-events: none;
  }
  #intern-toast[data-show='1'] {
    opacity: 1;
    transform: none;
  }
</style>

<div id="intern-bar" hidden>
  <span id="intern-dot" title="同步状态"></span>
  <button type="button" data-act="mode" title="切换编辑态（快捷键 E）">编辑</button>
  <button type="button" data-act="history" title="变更记录">记录</button>
  <button type="button" data-act="json" title="导出 JSON">JSON</button>
  <button type="button" data-act="md" title="导出 Markdown">MD</button>
</div>
<div id="intern-panel" hidden></div>
<div id="intern-toast"></div>

<script>
  const LSK = 'intern-edits-v1';
  const SYNC = 'http://127.0.0.1:4400';

  type Entry = { value: unknown; updatedAt: number; history?: { at: number; before: unknown; after: unknown }[] };
  type Store = { tasks: Record<string, Record<string, Entry>>; updatedAt?: number };

  const root = document.querySelector('[data-intern-root]');
  const bar = document.getElementById('intern-bar') as HTMLElement | null;
  const panel = document.getElementById('intern-panel') as HTMLElement | null;
  const dot = document.getElementById('intern-dot') as HTMLElement | null;
  const toastEl = document.getElementById('intern-toast') as HTMLElement | null;

  if (root && bar) {
    bar.hidden = false;

    const readLS = (): Store => {
      try {
        return JSON.parse(localStorage.getItem(LSK) || '{"tasks":{}}');
      } catch {
        return { tasks: {} };
      }
    };
    let store: Store = readLS();
    if (!store.tasks) store.tasks = {};

    const writeLS = () => {
      try {
        localStorage.setItem(LSK, JSON.stringify(store));
      } catch (e) {
        console.warn('localStorage 写入失败', e);
      }
    };

    const toast = (msg: string) => {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.dataset.show = '1';
      setTimeout(() => (toastEl.dataset.show = '0'), 1600);
    };

    const setDot = (state: 'clean' | 'local' | 'synced') => {
      if (!dot) return;
      dot.style.background =
        state === 'synced' ? 'var(--c-qing)' : state === 'local' ? 'var(--c-zhu)' : 'var(--c-ink-3)';
      dot.title = state === 'synced' ? '已同步到本地服务' : state === 'local' ? '只存在浏览器本地' : '无修改';
    };

    const entryOf = (task: string, path: string): Entry | undefined => store.tasks[task]?.[path];

    /** 从内嵌 JSON 里取原始值，用于导出与 type 推断 */
    const pageData: Record<string, any> =
      (() => {
        const el = document.getElementById('intern-data');
        if (!el) return {};
        try {
          return JSON.parse(el.textContent || '{}');
        } catch {
          return {};
        }
      })();

    const getByPath = (obj: any, path: string) => {
      let cur = obj;
      for (const seg of path.split('.')) {
        if (cur == null) return undefined;
        cur = cur[seg];
      }
      return cur;
    };

    /** 把值渲染回元素：保留首个已有子节点的 class，保证样式一致 */
    const renderText = (el: HTMLElement, value: string) => {
      const paras = String(value).split(/\n+/).filter((x) => x.trim());
      if (el.tagName === 'P' || el.tagName === 'DD' || el.tagName === 'H1' || el.tagName === 'H3') {
        el.textContent = String(value).trim();
        return;
      }
      const sample = el.querySelector('p') as HTMLElement | null;
      const cls = sample?.className ?? 'text-[13px] leading-[1.95] text-ink2';
      el.innerHTML = '';
      for (const p of paras) {
        const node = document.createElement('p');
        node.className = cls;
        node.textContent = p;
        el.appendChild(node);
      }
    };

    const renderLines = (el: HTMLElement, value: string[]) => {
      const isUl = el.tagName === 'UL';
      const sample = el.querySelector('li') as HTMLElement | null;
      const cls = sample?.className ?? 'text-[12.5px] leading-[1.8] text-ink2';
      const inner = sample?.innerHTML ?? '';
      el.innerHTML = '';
      for (const line of value) {
        const li = document.createElement('li');
        if (isUl && inner) {
          li.className = cls;
          li.innerHTML = inner.replace(/>([^<]*)</, `>${escapeHtml(String(line))}<`);
          if (!li.textContent?.includes(String(line).slice(0, 12))) {
            li.className = cls;
            li.textContent = String(line);
          }
        } else {
          li.className = cls;
          li.textContent = String(line);
        }
        el.appendChild(li);
      }
    };

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const applyAll = () => {
      document.querySelectorAll<HTMLElement>('[data-edit]').forEach((el) => {
        const task = el.dataset.task || '';
        const path = el.dataset.edit || '';
        const entry = entryOf(task, path);
        if (!entry) {
          el.dataset.dirty = '0';
          return;
        }
        const type = el.dataset.type === 'lines' ? 'lines' : 'text';
        if (type === 'lines' && Array.isArray(entry.value)) renderLines(el, entry.value as string[]);
        else renderText(el, String(entry.value ?? ''));
        el.dataset.dirty = '1';
      });
      const dirty = Object.values(store.tasks).some((m) => Object.keys(m).length > 0);
      setDot(dirty ? 'local' : 'clean');
    };

    const currentText = (el: HTMLElement, type: 'text' | 'lines') => {
      const items = [...el.querySelectorAll('li, p, dd, h3')].map((n) => (n.textContent || '').trim()).filter(Boolean);
      if (type === 'lines') return items;
      if (el.tagName === 'P' || el.tagName === 'DD' || el.tagName === 'H3') return el.textContent || '';
      return items;
    };

    const beginEdit = (el: HTMLElement) => {
      if (el.dataset.editing === '1') return;
      const task = el.dataset.task || '';
      const path = el.dataset.edit || '';
      const type = el.dataset.type === 'lines' ? 'lines' : 'text';
      const before = currentText(el, type);
      const raw = Array.isArray(before) ? before.join('\n') : String(before);
      const original = el.innerHTML;

      el.dataset.editing = '1';
      const ta = document.createElement('textarea');
      ta.className = 'intern-edit-area';
      ta.value = Array.isArray(before) ? before.join('\n') : raw.split(/\n+/).filter(Boolean).join('\n\n');
      el.innerHTML = '';
      el.appendChild(ta);

      const fit = () => {
        ta.style.height = 'auto';
        ta.style.height = ta.scrollHeight + 'px';
      };
      fit();
      ta.focus();
      ta.setSelectionRange(ta.value.length, ta.value.length);
      ta.addEventListener('input', fit);

      let done = false;
      const cancel = () => {
        if (done) return;
        done = true;
        el.innerHTML = original;
        el.dataset.editing = '0';
      };
      const commit = async () => {
        if (done) return;
        done = true;
        const rawNext = ta.value;
        const value = type === 'lines' ? rawNext.split('\n').map((x) => x.trim()).filter(Boolean) : rawNext.trim();
        const isEmpty = Array.isArray(value) ? value.length === 0 : value === '';
        if (isEmpty) {
          toast('内容为空，已还原');
          el.innerHTML = original;
          el.dataset.editing = '0';
          return;
        }
        const unchanged = Array.isArray(value) ? JSON.stringify(value) === JSON.stringify(before) : value === raw;
        if (unchanged) {
          el.dataset.editing = '0';
          if (type === 'lines') renderLines(el, value as string[]);
          else renderText(el, value as string);
          return;
        }
        const now = Date.now();
        const prev = entryOf(task, path);
        const history = [...(prev?.history ?? []), { at: now, before, after: value }].slice(-10);
        if (!store.tasks[task]) store.tasks[task] = {};
        store.tasks[task][path] = { value, updatedAt: now, history };
        writeLS();
        el.dataset.editing = '0';
        if (type === 'lines') renderLines(el, value as string[]);
        else renderText(el, value as string);
        el.dataset.dirty = '1';
        try {
          const res = await fetch(`${SYNC}/api/intern`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task, path, value, updatedAt: now })
          });
          setDot(res.ok ? 'synced' : 'local');
          toast(res.ok ? '已保存并同步' : '已存本地（服务未响应）');
        } catch {
          setDot('local');
          toast('已存本地（服务未启动）');
        }
      };

      ta.addEventListener('blur', () => setTimeout(commit, 120));
      ta.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape') {
          ev.preventDefault();
          cancel();
        } else if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 's') {
          ev.preventDefault();
          ta.blur();
        }
      });
    };

    document.addEventListener('dblclick', (ev) => {
      const el = (ev.target as HTMLElement)?.closest?.('[data-edit]') as HTMLElement | null;
      if (!el) return;
      ev.preventDefault();
      beginEdit(el);
    });

    document.addEventListener('click', (ev) => {
      const el = (ev.target as HTMLElement)?.closest?.('[data-edit]') as HTMLElement | null;
      if (!el) return;
      if (document.body.dataset.internEditmode !== '1') return;
      if ((ev.target as HTMLElement).tagName === 'A') return;
      ev.preventDefault();
      beginEdit(el);
    });

    document.addEventListener('keydown', (ev) => {
      const tag = (ev.target as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (ev.key.toLowerCase() === 'e' && !ev.ctrlKey && !ev.metaKey && !ev.altKey) {
        const on = document.body.dataset.internEditmode === '1';
        document.body.dataset.internEditmode = on ? '0' : '1';
        const btn = bar.querySelector('[data-act="mode"]') as HTMLElement;
        btn.dataset.on = on ? '0' : '1';
        toast(on ? '退出编辑态' : '进入编辑态（点击正文即可改）');
      }
    });

    bar.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest('button') as HTMLElement | null;
      if (!btn) return;
      const act = btn.dataset.act;
      if (act === 'mode') {
        const on = document.body.dataset.internEditmode === '1';
        document.body.dataset.internEditmode = on ? '0' : '1';
        btn.dataset.on = on ? '0' : '1';
      } else if (act === 'history') {
        if (!panel) return;
        panel.hidden = !panel.hidden;
        if (!panel.hidden) renderHistory();
      } else if (act === 'json') {
        download(`intern-edits-${new Date().toISOString().slice(0, 10)}.json`, JSON.stringify(store, null, 2), 'application/json');
      } else if (act === 'md') {
        exportMarkdown();
      }
    });

    const renderHistory = () => {
      if (!panel) return;
      const rows: string[] = [];
      for (const [task, fields] of Object.entries(store.tasks)) {
        for (const [path, entry] of Object.entries(fields)) {
          const at = new Date(entry.updatedAt).toLocaleString('zh-CN', { hour12: false });
          const count = entry.history?.length ?? 0;
          rows.push(
            `<li><code>${task}</code> · ${path}<br/><span style="opacity:.7">${at} · 改过 ${count} 次</span> ` +
              `<button data-rollback="${task}::${path}">回滚</button></li>`
          );
        }
      }
      panel.innerHTML = rows.length
        ? `<h4>变更记录（${rows.length} 个字段）</h4><ul>${rows.join('')}</ul>`
        : `<h4>变更记录</h4><p style="opacity:.7">还没有改动。双击任意正文开始编辑。</p>`;
      panel.querySelectorAll('button[data-rollback]').forEach((b) => {
        b.addEventListener('click', () => {
          const [task, path] = (b as HTMLElement).dataset.rollback!.split('::');
          const entry = store.tasks[task]?.[path];
          const last = entry?.history?.[entry.history.length - 1];
          if (!entry || !last) return;
          entry.value = last.before;
          entry.updatedAt = Date.now();
          entry.history = entry.history.slice(0, -1);
          writeLS();
          applyAll();
          fetch(`${SYNC}/api/intern`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ task, path, value: entry.value, updatedAt: entry.updatedAt })
          }).catch(() => {});
          renderHistory();
          toast('已回滚到上一版');
        });
      });
    };

    const download = (name: string, text: string, mime: string) => {
      const blob = new Blob([text], { type: `${mime};charset=utf-8` });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = name;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    };

    const exportMarkdown = () => {
      const tasks = Object.values(pageData) as any[];
      if (!tasks.length) {
        toast('本页没有内嵌数据，请到话术总表页导出');
        return;
      }
      const out: string[] = ['# 实习经历 · 三层口述稿', ''];
      for (const t of tasks) {
        const patch = store.tasks[t.id] ?? {};
        const val = (p: string) => (patch[p] ? patch[p].value : getByPath(t, p));
        out.push(`## ${t.title}`, '');
        out.push(`> ${val('oneLiner')}`, '');
        out.push('### 60 秒版', '', String(val('speak.s60') ?? '').replace(/\n+/g, '\n\n'), '');
        out.push('### 主答版', '', String(val('speak.s180') ?? '').replace(/\n+/g, '\n\n'), '');
        out.push('### 深挖版', '', String(val('speak.s600') ?? '').replace(/\n+/g, '\n\n'), '');
        const fus = (t.followUps ?? []) as any[];
        if (fus.length) {
          out.push('### 追问预案', '');
          fus.forEach((f, i) => out.push(`${i + 1}. **${f.q}**`, `   ${val(`followUps.${i}.a`)}`, ''));
        }
      }
      download(`intern-speak-${new Date().toISOString().slice(0, 10)}.md`, out.join('\n'), 'text/markdown');
      toast('已导出 Markdown');
    };

    const pullServer = async () => {
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 1500);
        const res = await fetch(`${SYNC}/api/intern/all`, { signal: ctrl.signal });
        clearTimeout(timer);
        if (!res.ok) return;
        const remote = (await res.json()) as Store;
        let changed = false;
        for (const [task, fields] of Object.entries(remote.tasks ?? {})) {
          for (const [path, entry] of Object.entries(fields ?? {})) {
            const local = entryOf(task, path);
            if (!local || (entry.updatedAt ?? 0) > (local.updatedAt ?? 0)) {
              if (!store.tasks[task]) store.tasks[task] = {};
              store.tasks[task][path] = entry;
              changed = true;
            }
          }
        }
        if (changed) {
          writeLS();
          applyAll();
          setDot('synced');
        } else if (Object.keys(remote.tasks ?? {}).length) {
          setDot('synced');
        }
      } catch {
        /* 服务没起就静默 */
      }
    };

    applyAll();
    pullServer();

    const mdBtn = document.querySelector('[data-export-md]') as HTMLElement | null;
    mdBtn?.addEventListener('click', exportMarkdown);
  }
</script>
