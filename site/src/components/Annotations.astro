---
/**
 * 选区高亮 + 右侧评论面板（纯前端，localStorage 持久化）
 * 挂载在 BaseLayout 里，全站生效；数据按 pathname 隔离，可导出/导入 JSON。
 */
---

<div id="anno-root" data-anno="on">
  <button id="anno-toggle" type="button" aria-label="打开评论">批注 <span id="anno-count">0</span></button>
  <aside id="anno-panel" aria-hidden="true">
    <header class="anno-head">
      <p class="anno-title">本页批注 <span id="anno-num">0</span></p>
      <div class="anno-actions">
        <button type="button" data-act="export" title="导出 JSON">导出</button>
        <button type="button" data-act="import" title="导入 JSON">导入</button>
        <button type="button" data-act="toggle" title="显示/隐藏高亮">隐藏</button>
        <button type="button" data-act="close" title="收起">×</button>
      </div>
    </header>
    <div id="anno-list"></div>
    <p class="anno-tip">选中正文任意一句话 → 点「高亮」或「高亮+评论」。数据存在本机浏览器。</p>
    <input id="anno-file" type="file" accept="application/json" hidden />
  </aside>
  <div id="anno-pop" hidden>
    <div class="anno-pop-quote" id="anno-pop-quote"></div>
    <textarea id="anno-pop-text" rows="3" placeholder="写下你的疑问 / 记忆点（可留空，只高亮）"></textarea>
    <div class="anno-pop-actions">
      <button type="button" data-act="save">保存</button>
      <button type="button" data-act="cancel">取消</button>
    </div>
  </div>
</div>

<style is:global>
  .anno-mark {
    background: color-mix(in srgb, #c2452d 16%, transparent);
    border-bottom: 1px solid color-mix(in srgb, #c2452d 45%, transparent);
    border-radius: 2px;
    cursor: pointer;
  }
  .anno-mark:has(+ .anno-mark),
  .anno-mark + .anno-mark {
    border-radius: 0;
  }
  .anno-mark.is-active {
    background: color-mix(in srgb, #c2452d 30%, transparent);
  }
  .anno-mark.anno-has-comment::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 2px;
    border-radius: 50%;
    background: #c2452d;
    vertical-align: super;
  }

  #anno-toggle {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 999px;
    background: var(--paper, #fbf9f5);
    color: var(--ink2, #4a4a4a);
    font-size: 12px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 8%);
    cursor: pointer;
  }
  #anno-toggle span {
    min-width: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: #c2452d;
    color: #fff;
    font-size: 10.5px;
    line-height: 16px;
    text-align: center;
  }

  #anno-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: 320px;
    height: 100vh;
    border-left: 1px solid var(--line, #e5e0d8);
    background: var(--paper, #fbf9f5);
    transform: translateX(100%);
    transition: transform 0.22s ease;
    font-size: 12.5px;
  }
  #anno-panel[aria-hidden='false'] {
    transform: none;
  }

  .anno-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line, #e5e0d8);
  }
  .anno-title {
    font-weight: 600;
    color: var(--ink, #23201c);
  }
  .anno-actions {
    margin-left: auto;
    display: flex;
    gap: 4px;
  }
  .anno-actions button {
    padding: 3px 6px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 5px;
    background: transparent;
    color: var(--ink3, #7a746c);
    font-size: 11px;
    cursor: pointer;
  }
  .anno-actions button:hover {
    color: var(--ink, #23201c);
  }

  #anno-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 10px 40px;
  }
  .anno-item {
    padding: 9px 10px;
    margin-bottom: 8px;
    border: 1px solid var(--line, #e5e0d8);
    border-left: 2px solid #c2452d;
    border-radius: 6px;
    cursor: pointer;
  }
  .anno-item:hover {
    background: color-mix(in srgb, #c2452d 5%, transparent);
  }
  .anno-item blockquote {
    margin: 0;
    color: var(--ink3, #7a746c);
    font-size: 11.5px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .anno-item .anno-body {
    margin-top: 6px;
    color: var(--ink2, #4a4a4a);
    line-height: 1.65;
    white-space: pre-wrap;
  }
  .anno-item .anno-meta {
    margin-top: 6px;
    display: flex;
    gap: 8px;
    color: var(--ink3, #7a746c);
    font-size: 10.5px;
  }
  .anno-item .anno-del {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--ink3, #7a746c);
    cursor: pointer;
    font-size: 10.5px;
  }
  .anno-item .anno-del:hover {
    color: #c2452d;
  }
  .anno-empty {
    padding: 24px 10px;
    color: var(--ink3, #7a746c);
    text-align: center;
    font-size: 12px;
  }
  .anno-tip {
    padding: 10px 14px;
    border-top: 1px solid var(--line, #e5e0d8);
    color: var(--ink3, #7a746c);
    font-size: 10.5px;
    line-height: 1.6;
  }

  #anno-pop {
    position: fixed;
    z-index: 80;
    width: 300px;
    padding: 10px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 8px;
    background: var(--paper, #fbf9f5);
    box-shadow: 0 10px 30px rgb(0 0 0 / 12%);
  }
  .anno-pop-quote {
    max-height: 60px;
    overflow: hidden;
    color: var(--ink3, #7a746c);
    font-size: 11px;
    line-height: 1.5;
  }
  #anno-pop-text {
    width: 100%;
    margin-top: 8px;
    padding: 6px 8px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 6px;
    background: transparent;
    color: var(--ink, #23201c);
    font: inherit;
    font-size: 12px;
    resize: vertical;
  }
  .anno-pop-actions {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .anno-pop-actions button {
    padding: 4px 10px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 6px;
    background: transparent;
    color: var(--ink2, #4a4a4a);
    font-size: 11.5px;
    cursor: pointer;
  }
  .anno-pop-actions button[data-act='save'] {
    border-color: #c2452d;
    background: #c2452d;
    color: #fff;
  }

  #anno-bar {
    position: fixed;
    z-index: 80;
    display: none;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--line, #e5e0d8);
    border-radius: 7px;
    background: var(--paper, #fbf9f5);
    box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
  }
  #anno-bar button {
    padding: 4px 9px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--ink2, #4a4a4a);
    font-size: 11.5px;
    cursor: pointer;
  }
  #anno-bar button:hover {
    background: #c2452d;
    color: #fff;
  }
  .anno-flash {
    animation: anno-flash 1.1s ease;
  }
  @keyframes anno-flash {
    0%,
    100% {
      background: transparent;
    }
    30% {
      background: color-mix(in srgb, #c2452d 34%, transparent);
    }
  }

  @media (max-width: 1100px) {
    #anno-panel {
      width: min(88vw, 340px);
      box-shadow: -12px 0 30px rgb(0 0 0 / 12%);
    }
  }
</style>

<script>
  (() => {
    const KEY = 'dsh:anno:' + location.pathname;
    const root = document.querySelector('main');
    const panel = document.getElementById('anno-panel') as HTMLElement;
    const list = document.getElementById('anno-list') as HTMLElement;
    const pop = document.getElementById('anno-pop') as HTMLElement;
    const popQuote = document.getElementById('anno-pop-quote') as HTMLElement;
    const popText = document.getElementById('anno-pop-text') as HTMLTextAreaElement;
    const toggle = document.getElementById('anno-toggle') as HTMLElement;
    if (!root || !panel || document.getElementById('l3-input')) return;

    type Anno = { id: string; bid: number; start: number; end: number; text: string; comment: string; created: number };
    let annos: Anno[] = [];
    let pending: { bid: number; start: number; end: number; text: string; range: Range } | null = null;
    let pendingCommentId: string | null = null;
    let hidden = false;

    const load = () => {
      try {
        const raw = localStorage.getItem(KEY);
        annos = raw ? (JSON.parse(raw) as Anno[]) : [];
      } catch {
        annos = [];
      }
    };
    const save = () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(annos));
      } catch {}
    };

    const BLOCK_SEL = 'p, li, h2, h3, h4, td, dd, figcaption, blockquote';
    const blocks: HTMLElement[] = [];
    const collect = () => {
      blocks.length = 0;
      root.querySelectorAll<HTMLElement>(BLOCK_SEL).forEach((el) => {
        if (el.closest('pre, code, #anno-panel, #anno-pop, .ed-gutter, .ed-highlight')) return;
        if (el.closest('[data-anno="off"]')) return;
        if (!el.textContent || !el.textContent.trim()) return;
        if (el.querySelector(BLOCK_SEL)) return;
        if (el.dataset.bid === undefined) el.dataset.bid = String(blocks.length);
        blocks.push(el);
      });
    };

    const textNodes = (el: HTMLElement) => {
      const out: Text[] = [];
      const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) => (n.nodeValue && n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT)
      });
      let n: Node | null;
      while ((n = w.nextNode())) out.push(n as Text);
      return out;
    };

    const charOffset = (el: HTMLElement, node: Node, offset: number) => {
      let acc = 0;
      for (const t of textNodes(el)) {
        if (t === node) return acc + offset;
        acc += t.nodeValue?.length ?? 0;
      }
      return acc;
    };

    const posAt = (el: HTMLElement, index: number) => {
      let acc = 0;
      for (const t of textNodes(el)) {
        const len = t.nodeValue?.length ?? 0;
        if (acc + len >= index) return { node: t, offset: index - acc };
        acc += len;
      }
      return null;
    };

    const clearMarks = () => {
      root.querySelectorAll('.anno-mark').forEach((m) => {
        const parent = m.parentNode;
        if (!parent) return;
        while (m.firstChild) parent.insertBefore(m.firstChild, m);
        parent.removeChild(m);
        (parent as HTMLElement).normalize?.();
      });
    };

    const paint = () => {
      clearMarks();
      if (hidden) return;
      for (const a of [...annos].sort((x, y) => y.start - x.start)) {
        const el = blocks.find((b) => b.dataset.bid === String(a.bid));
        if (!el) continue;
        const s = posAt(el, a.start);
        const e = posAt(el, a.end);
        if (!s || !e) continue;
        try {
          const range = document.createRange();
          range.setStart(s.node, s.offset);
          range.setEnd(e.node, e.offset);
          const mark = document.createElement('mark');
          mark.className = 'anno-mark' + (a.comment ? ' anno-has-comment' : '');
          mark.dataset.aid = a.id;
          range.surroundContents(mark);
        } catch {}
      }
      renderList();
    };

    const renderList = () => {
      const num = document.getElementById('anno-num');
      const cnt = document.getElementById('anno-count');
      if (num) num.textContent = String(annos.length);
      if (cnt) cnt.textContent = String(annos.length);
      if (!annos.length) {
        list.innerHTML = '<p class="anno-empty">这一页还没有批注。<br />选中一句话试试。</p>';
        return;
      }
      const sorted = [...annos].sort((a, b) => a.bid - b.bid || a.start - b.start);
      list.innerHTML = '';
      for (const a of sorted) {
        const box = document.createElement('div');
        box.className = 'anno-item';
        box.dataset.aid = a.id;
        const quote = document.createElement('blockquote');
        quote.textContent = a.text;
        box.appendChild(quote);
        if (a.comment) {
          const body = document.createElement('p');
          body.className = 'anno-body';
          body.textContent = a.comment;
          box.appendChild(body);
        }
        const meta = document.createElement('div');
        meta.className = 'anno-meta';
        const t = document.createElement('span');
        t.textContent = new Date(a.created).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
        const del = document.createElement('button');
        del.className = 'anno-del';
        del.type = 'button';
        del.textContent = '删除';
        del.addEventListener('click', (ev) => {
          ev.stopPropagation();
          annos = annos.filter((x) => x.id !== a.id);
          save();
          paint();
        });
        meta.append(t, del);
        box.appendChild(meta);
        box.addEventListener('click', () => {
          const el = blocks.find((b) => b.dataset.bid === String(a.bid));
          if (!el) return;
          el.scrollIntoView({ block: 'center', behavior: 'smooth' });
          el.classList.add('anno-flash');
          setTimeout(() => el.classList.remove('anno-flash'), 1200);
          root.querySelectorAll('.anno-mark').forEach((m) => m.classList.toggle('is-active', m.getAttribute('data-aid') === a.id));
        });
        list.appendChild(box);
      }
    };

    const blockOf = (node: Node | null): HTMLElement | null => {
      let el = node instanceof Element ? (node as Element) : node?.parentElement ?? null;
      while (el) {
        if (el instanceof HTMLElement && el.dataset.bid !== undefined && blocks.includes(el)) return el;
        el = el.parentElement;
      }
      return null;
    };

    const bar = document.createElement('div');
    bar.id = 'anno-bar';
    bar.innerHTML = '<button type="button" data-act="hl">高亮</button><button type="button" data-act="cm">高亮+评论</button>';
    document.body.appendChild(bar);

    const hideBar = () => {
      bar.style.display = 'none';
    };

    const showPop = (rect: DOMRect, quote: string) => {
      popQuote.textContent = quote;
      pop.hidden = false;
      const top = Math.min(window.innerHeight - 200, rect.bottom + 8);
      const left = Math.max(12, Math.min(window.innerWidth - 312, rect.left));
      pop.style.top = top + 'px';
      pop.style.left = left + 'px';
      popText.value = '';
      popText.focus();
    };

    const commit = (comment: string) => {
      if (!pending) return;
      const a: Anno = {
        id: Math.random().toString(36).slice(2, 10),
        bid: pending.bid,
        start: pending.start,
        end: pending.end,
        text: pending.text,
        comment,
        created: Date.now()
      };
      annos.push(a);
      save();
      pending = null;
      pop.hidden = true;
      pendingCommentId = null;
      paint();
      openPanel();
    };

    const selInfo = () => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.rangeCount) return null;
      const range = sel.getRangeAt(0);
      const startBlock = blockOf(range.startContainer);
      const endBlock = blockOf(range.endContainer);
      if (!startBlock || startBlock !== endBlock) return null;
      const start = charOffset(startBlock, range.startContainer, range.startOffset);
      const end = charOffset(startBlock, range.endContainer, range.endOffset);
      if (end - start < 2) return null;
      const text = startBlock.textContent?.slice(start, end) ?? '';
      if (!text.trim()) return null;
      return { bid: Number(startBlock.dataset.bid), start, end, text, range: range.cloneRange(), rect: range.getBoundingClientRect() };
    };

    const openPanel = () => {
      panel.setAttribute('aria-hidden', 'false');
    };
    const closePanel = () => panel.setAttribute('aria-hidden', 'true');

    toggle?.addEventListener('click', () => openPanel());

    document.addEventListener('mouseup', () => {
      setTimeout(() => {
        const info = selInfo();
        if (!info) {
          hideBar();
          return;
        }
        pending = info;
        const r = info.rect;
        bar.style.display = 'flex';
        bar.style.top = Math.max(8, r.top - 40) + 'px';
        bar.style.left = Math.max(8, Math.min(window.innerWidth - 150, r.left + r.width / 2 - 60)) + 'px';
      }, 10);
    });

    bar.addEventListener('mousedown', (ev) => ev.preventDefault());
    bar.addEventListener('click', (ev) => {
      const act = (ev.target as HTMLElement).dataset.act;
      if (!pending) return;
      if (act === 'hl') {
        commit('');
        window.getSelection()?.removeAllRanges();
      } else if (act === 'cm') {
        showPop(pending.rect, pending.text);
      }
      hideBar();
    });

    pop.addEventListener('click', (ev) => {
      const act = (ev.target as HTMLElement).dataset.act;
      if (act === 'save') commit(popText.value.trim());
      if (act === 'cancel') {
        pop.hidden = true;
        pending = null;
      }
    });

    popText?.addEventListener('keydown', (ev) => {
      if ((ev.metaKey || ev.ctrlKey) && ev.key === 'Enter') commit(popText.value.trim());
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        pop.hidden = true;
        hideBar();
        pending = null;
      }
    });

    root.addEventListener('click', (ev) => {
      const mark = (ev.target as HTMLElement).closest?.('.anno-mark');
      if (!mark) return;
      const aid = mark.getAttribute('data-aid');
      const a = annos.find((x) => x.id === aid);
      if (!a) return;
      openPanel();
      const item = list.querySelector(`[data-aid="${aid}"]`) as HTMLElement | null;
      item?.click();
    });

    panel.addEventListener('click', (ev) => {
      const act = (ev.target as HTMLElement).dataset.act;
      if (act === 'close') closePanel();
      if (act === 'toggle') {
        hidden = !hidden;
        (ev.target as HTMLElement).textContent = hidden ? '显示' : '隐藏';
        paint();
      }
      if (act === 'export') {
        const blob = new Blob([JSON.stringify({ page: location.pathname, annos }, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'anno-' + location.pathname.replace(/[^\w]+/g, '_') + '.json';
        a.click();
        URL.revokeObjectURL(a.href);
      }
      if (act === 'import') (document.getElementById('anno-file') as HTMLInputElement)?.click();
    });

    document.getElementById('anno-file')?.addEventListener('change', async (ev) => {
      const file = (ev.target as HTMLInputElement).files?.[0];
      if (!file) return;
      try {
        const data = JSON.parse(await file.text());
        const incoming: Anno[] = Array.isArray(data) ? data : data.annos ?? [];
        const seen = new Set(annos.map((a) => a.id));
        for (const a of incoming) if (!seen.has(a.id)) annos.push(a);
        save();
        paint();
      } catch {}
      (ev.target as HTMLInputElement).value = '';
    });

    collect();
    load();
    paint();
    if (annos.length) openPanel();

    const style = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      document.documentElement.style.setProperty('--anno-ink', dark ? '#e7e2d8' : '#23201c');
    };
    style();
  })();
</script>
