---
/**
 * 选区高亮 + 右侧批注面板
 * - 本机 localStorage 持久化；配置 ANNO_SYNC 后自动与 scripts/anno-server.mjs 双向同步
 * - 支持「待办 / 已解决」、按页面类型筛选、全文搜索、跨页跳转、导出/导入
 */
---

<div id="anno-root">
  <button id="anno-toggle" type="button" aria-label="打开批注">批注 <span id="anno-count">0</span></button>
  <aside id="anno-panel" aria-hidden="true">
    <header class="anno-head">
      <div class="anno-tabs">
        <button type="button" data-tab="page" class="is-on">本页</button>
        <button type="button" data-tab="all">全部</button>
      </div>
      <div class="anno-actions">
        <span id="anno-sync" class="anno-sync" title="同步状态">…</span>
        <button type="button" data-act="export" title="导出 JSON">导出</button>
        <button type="button" data-act="import" title="导入 JSON">导入</button>
        <button type="button" data-act="close" title="收起">×</button>
      </div>
    </header>

    <div id="anno-filters" class="anno-filters">
      <input id="anno-q" type="search" placeholder="搜索批注 / 原文…" />
      <div class="anno-chips">
        <button type="button" data-f="all" class="is-on">全部</button>
        <button type="button" data-f="open">待办</button>
        <button type="button" data-f="done">已解决</button>
        <button type="button" data-f="cmt">有评论</button>
      </div>
      <div class="anno-chips anno-types" id="anno-types">
        <button type="button" data-t="all" class="is-on">全部题型</button>
        <button type="button" data-t="project">项目</button>
        <button type="button" data-t="notes">笔记</button>
        <button type="button" data-t="hot200">Hot200</button>
      </div>
    </div>

    <div id="anno-list"></div>
    <p class="anno-tip">选中正文任意一句话 → 浮条上点「高亮」或「高亮+评论」。列表里可把批注标成「已解决」，跨页批注点击直接跳转。</p>
    <input id="anno-file" type="file" accept="application/json" hidden />
  </aside>

  <div id="anno-pop" hidden>
    <div class="anno-pop-quote" id="anno-pop-quote"></div>
    <div class="anno-pop-colors" id="anno-pop-colors"></div>
    <textarea id="anno-pop-text" rows="3" placeholder="写下你的疑问 / 记忆点（可留空，只高亮）"></textarea>
    <div class="anno-pop-actions">
      <button type="button" data-act="save">保存</button>
      <button type="button" data-act="cancel">取消</button>
    </div>
  </div>
</div>

<style is:global>
  .anno-mark {
    background: color-mix(in srgb, var(--anno-color, var(--hl-1)) var(--hl-alpha), transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--anno-color, var(--hl-1)) calc(var(--hl-alpha) + 28%), transparent);
    border-radius: 2px;
    cursor: pointer;
  }
  .anno-mark.is-active {
    background: color-mix(in srgb, var(--anno-color, var(--hl-1)) var(--hl-alpha-active), transparent);
  }
  .anno-mark.anno-done {
    background: color-mix(in srgb, var(--hl-3) var(--hl-alpha), transparent);
    border-bottom-color: color-mix(in srgb, var(--hl-3) 55%, transparent);
    opacity: 0.85;
  }
  .anno-mark.anno-has-comment::after {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 2px;
    border-radius: 50%;
    background: var(--anno-color, var(--hl-1));
    vertical-align: super;
  }
  .anno-sw {
    width: 15px;
    height: 15px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--c-ink) 18%, transparent);
    border-radius: 50%;
    background: var(--c);
    cursor: pointer;
  }
  .anno-sw:hover {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 35%, transparent);
  }
  .anno-pop-colors {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .anno-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 4px;
    border-radius: 50%;
    background: var(--c);
    vertical-align: middle;
  }

  #anno-toggle {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-bg);
    color: var(--c-ink-2);
    font-size: 12px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 8%);
    cursor: pointer;
  }
  #anno-toggle span {
    min-width: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--hl-1);
    color: var(--c-bg);
    font-size: 10.5px;
    line-height: 16px;
    text-align: center;
  }

  #anno-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: 336px;
    height: 100vh;
    border-left: 1px solid var(--c-line);
    background: var(--c-bg);
    transform: translateX(100%);
    transition: transform 0.22s ease;
    font-size: 12.5px;
  }
  #anno-panel[aria-hidden='false'] {
    transform: none;
  }

  .anno-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--c-line);
  }
  .anno-tabs {
    display: flex;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .anno-tabs button {
    padding: 4px 10px;
    border: 0;
    background: transparent;
    color: var(--c-ink-3);
    font-size: 11.5px;
    cursor: pointer;
  }
  .anno-tabs button.is-on {
    background: var(--hl-1);
    color: var(--c-bg);
  }
  .anno-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .anno-actions button {
    padding: 3px 6px;
    border: 1px solid var(--c-line);
    border-radius: 5px;
    background: transparent;
    color: var(--c-ink-3);
    font-size: 11px;
    cursor: pointer;
  }
  .anno-actions button:hover {
    color: var(--c-ink);
  }
  .anno-sync {
    font-size: 10px;
    color: var(--c-ink-3);
  }
  .anno-sync.online {
    color: var(--hl-3);
  }
  .anno-sync.offline {
    color: var(--hl-2);
  }

  .anno-filters {
    padding: 8px 12px;
    border-bottom: 1px solid var(--c-line);
  }
  #anno-q {
    width: 100%;
    padding: 5px 8px;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    font-size: 11.5px;
  }
  .anno-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 6px;
  }
  .anno-chips button {
    padding: 2px 7px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: transparent;
    color: var(--c-ink-3);
    font-size: 10.5px;
    cursor: pointer;
  }
  .anno-chips button.is-on {
    border-color: var(--hl-1);
    color: var(--hl-1);
  }

  #anno-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 10px 40px;
  }
  .anno-item {
    padding: 9px 10px;
    margin-bottom: 8px;
    border: 1px solid var(--c-line);
    border-left: 2px solid var(--hl-1);
    border-radius: 6px;
    cursor: pointer;
  }
  .anno-item.is-done {
    border-left-color: var(--hl-3);
    opacity: 0.72;
  }
  .anno-item:hover {
    background: color-mix(in srgb, var(--hl-1) 6%, transparent);
  }
  .anno-item blockquote {
    margin: 0;
    color: var(--c-ink-3);
    font-size: 11.5px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .anno-item .anno-body {
    margin: 6px 0 0;
    color: var(--c-ink-2);
    line-height: 1.65;
    white-space: pre-wrap;
  }
  .anno-item .anno-page {
    margin: 5px 0 0;
    color: var(--c-ink-3);
    font-size: 10.5px;
  }
  .anno-item .anno-meta {
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--c-ink-3);
    font-size: 10.5px;
  }
  .anno-item .anno-meta button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-ink-3);
    font-size: 10.5px;
    cursor: pointer;
  }
  .anno-item .anno-meta button:hover {
    color: var(--hl-1);
  }
  .anno-empty {
    padding: 24px 10px;
    color: var(--c-ink-3);
    text-align: center;
    font-size: 12px;
  }
  .anno-tip {
    padding: 10px 14px;
    border-top: 1px solid var(--c-line);
    color: var(--c-ink-3);
    font-size: 10.5px;
    line-height: 1.6;
  }

  #anno-pop {
    position: fixed;
    z-index: 80;
    width: 300px;
    padding: 10px;
    border: 1px solid var(--c-line);
    border-radius: 8px;
    background: var(--c-bg);
    box-shadow: 0 10px 30px rgb(0 0 0 / 12%);
  }
  .anno-pop-quote {
    max-height: 60px;
    overflow: hidden;
    color: var(--c-ink-3);
    font-size: 11px;
    line-height: 1.5;
  }
  #anno-pop-text {
    width: 100%;
    margin-top: 8px;
    padding: 6px 8px;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    font-size: 12px;
    resize: vertical;
  }
  .anno-pop-actions {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .anno-pop-actions button {
    padding: 4px 10px;
    border: 1px solid var(--c-line);
    border-radius: 6px;
    background: transparent;
    color: var(--c-ink-2);
    font-size: 11.5px;
    cursor: pointer;
  }
  .anno-pop-actions button[data-act='save'] {
    border-color: var(--hl-1);
    background: var(--hl-1);
    color: var(--c-bg);
  }

  #anno-bar {
    position: fixed;
    z-index: 80;
    display: none;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--c-line);
    border-radius: 7px;
    background: var(--c-bg);
    box-shadow: 0 6px 18px rgb(0 0 0 / 12%);
  }
  #anno-bar button {
    padding: 4px 9px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--c-ink-2);
    font-size: 11.5px;
    cursor: pointer;
  }
  #anno-bar button:hover {
    background: var(--hl-1);
    color: var(--c-bg);
  }
  /* 色板按钮：必须用 ID+类提高优先级，否则被 #anno-bar button 的透明背景覆盖 */
  #anno-bar .anno-sw,
  #anno-pop-colors .anno-sw {
    width: 16px;
    height: 16px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--c-ink) 22%, transparent);
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--c-bg) 55%, transparent);
    flex: 0 0 auto;
  }
  #anno-bar .anno-sw:hover,
  #anno-pop-colors .anno-sw:hover {
    background: var(--c);
    color: inherit;
    transform: scale(1.15);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent);
  }
  #anno-bar .anno-sw.is-on {
    box-shadow: 0 0 0 2px var(--c-bg), 0 0 0 3.5px var(--c);
  }
  .anno-flash {
    animation: anno-flash 1.1s ease;
  }
  @keyframes anno-flash {
    0%,
    100% {
      background: transparent;
    }
    30% {
      background: color-mix(in srgb, var(--hl-1) 34%, transparent);
    }
  }

  @media (max-width: 1100px) {
    #anno-panel {
      width: min(88vw, 360px);
      box-shadow: -12px 0 30px rgb(0 0 0 / 12%);
    }
  }
</style>

<script>
  (() => {
    const SYNC = 'http://127.0.0.1:4400';
    const LSK = 'dsh:anno:v2';
    const root = document.querySelector('main');
    const panel = document.getElementById('anno-panel') as HTMLElement;
    const list = document.getElementById('anno-list') as HTMLElement;
    const pop = document.getElementById('anno-pop') as HTMLElement;
    const popQuote = document.getElementById('anno-pop-quote') as HTMLElement;
    const popText = document.getElementById('anno-pop-text') as HTMLTextAreaElement;
    const toggle = document.getElementById('anno-toggle') as HTMLElement;
    const syncDot = document.getElementById('anno-sync') as HTMLElement;
    const qInput = document.getElementById('anno-q') as HTMLInputElement;
    if (!root || !panel || document.getElementById('l3-input')) return;

    type Anno = {
      id: string;
      page: string;
      pageTitle: string;
      bid: number;
      start: number;
      end: number;
      text: string;
      comment: string;
      color?: string;
      created: number;
      updatedAt: number;
      status: 'open' | 'done';
    };
    type Store = { pages: Record<string, Anno[]> };

    // 颜色一律走 CSS 变量：深色模式在 tokens.css 里换成更亮的同色相
    const COLORS = [
      { c: 'var(--hl-1)', n: '重要' },
      { c: 'var(--hl-2)', n: '待背' },
      { c: 'var(--hl-3)', n: '懂了' },
      { c: 'var(--hl-4)', n: '疑问' },
      { c: 'var(--hl-5)', n: '易忘' }
    ];
    /** 老数据存的是十六进制：读写时映射成主题变量，否则那些高亮在深色模式下不跟着变 */
    const LEGACY_COLOR: Record<string, string> = {
      '#c2452d': 'var(--hl-1)',
      '#b8860b': 'var(--hl-2)',
      '#5b7f5a': 'var(--hl-3)',
      '#3d6b8c': 'var(--hl-4)',
      '#7b5ea7': 'var(--hl-5)'
    };
    const colOf = (c?: string) => (c && (LEGACY_COLOR[c.toLowerCase()] || c)) || COLORS[0].c;
    const PAGE = location.pathname;
    const TITLE = document.title.replace(/\s*·\s*[^·]*$/, '');
    let store: Store = { pages: {} };
    let online = false;
    let tab: 'page' | 'all' = 'page';
    let filter: 'all' | 'open' | 'done' | 'cmt' = 'all';
    let typeFilter = 'all';
    let query = '';
    let pending: { bid: number; start: number; end: number; text: string; rect: DOMRect } | null = null;

    /* ---------- 存储 ---------- */
    const loadLocal = () => {
      try {
        const raw = localStorage.getItem(LSK);
        if (raw) store = JSON.parse(raw);
      } catch {}
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i)!;
          if (k.startsWith('dsh:anno:') && k !== LSK) {
            const page = k.slice('dsh:anno:'.length);
            const arr = JSON.parse(localStorage.getItem(k) || '[]');
            if (Array.isArray(arr) && arr.length) {
              store.pages[page] = (store.pages[page] ?? []).concat(
                arr.map((a: any) => ({ ...a, page, pageTitle: a.pageTitle ?? page, status: a.status ?? 'open', updatedAt: a.updatedAt ?? a.created }))
              );
            }
            localStorage.removeItem(k);
          }
        }
      } catch {}
      store.pages = store.pages ?? {};
    };
    const saveLocal = () => {
      try {
        localStorage.setItem(LSK, JSON.stringify(store));
      } catch {}
    };
    const annosOf = (page: string): Anno[] => store.pages[page] ?? [];
    const allAnnos = (): Anno[] =>
      Object.entries(store.pages).flatMap(([p, arr]) => arr.map((a) => ({ ...a, page: a.page ?? p })));
    const upsert = (a: Anno) => {
      const arr = annosOf(a.page);
      const i = arr.findIndex((x) => x.id === a.id);
      if (i >= 0) arr[i] = a;
      else arr.push(a);
      store.pages[a.page] = arr;
      saveLocal();
      syncPush(a);
    };
    const remove = (a: Anno) => {
      store.pages[a.page] = annosOf(a.page).filter((x) => x.id !== a.id);
      saveLocal();
      syncDelete(a);
    };

    /* ---------- 同步 ---------- */
    const setSync = (state: 'online' | 'offline') => {
      online = state === 'online';
      syncDot.className = 'anno-sync ' + state;
      syncDot.textContent = online ? '已同步' : '本地';
      syncDot.title = online ? `已连接 ${SYNC}` : '未连接同步服务；运行 node scripts/anno-server.mjs 可开启多端同步';
    };
    const syncPush = (a: Anno) => {
      if (!online) return;
      fetch(SYNC + '/api/anno', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ page: a.page, anno: a }),
        keepalive: true
      }).catch(() => setSync('offline'));
    };
    const syncDelete = (a: Anno) => {
      if (!online) return;
      fetch(`${SYNC}/api/anno?page=${encodeURIComponent(a.page)}&id=${encodeURIComponent(a.id)}`, { method: 'DELETE' }).catch(() =>
        setSync('offline')
      );
    };
    const syncPull = async () => {
      try {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 1500);
        const res = await fetch(SYNC + '/api/anno/all', { signal: ctrl.signal });
        clearTimeout(timer);
        if (!res.ok) throw new Error('bad');
        const data = (await res.json()) as { pages: Record<string, Anno[]> };
        setSync('online');
        let merged = 0;
        for (const [page, items] of Object.entries(data.pages ?? {})) {
          for (const a of items) {
            const local = annosOf(page).find((x) => x.id === a.id);
            if (!local) {
              store.pages[page] = [...annosOf(page), { ...a, page, pageTitle: a.pageTitle || page }];
              merged++;
            } else if ((a.updatedAt ?? 0) > (local.updatedAt ?? 0)) {
              Object.assign(local, a);
              merged++;
            }
          }
        }
        if (merged) {
          saveLocal();
          paint();
          renderList();
        }
        const payload: Record<string, Anno[]> = {};
        for (const [page, items] of Object.entries(store.pages)) {
          const serverIds = new Set((data.pages?.[page] ?? []).map((a) => a.id));
          const only = items.filter((a) => !serverIds.has(a.id));
          if (only.length) payload[page] = only;
        }
        if (Object.keys(payload).length) {
          fetch(SYNC + '/api/anno/bulk', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ pages: payload })
          }).catch(() => {});
        }
      } catch {
        setSync('offline');
      }
    };

    /* ---------- 正文块编号 ---------- */
    const BLOCK_SEL = 'p, li, h2, h3, h4, td, dd, figcaption, blockquote';
    const blocks: HTMLElement[] = [];
    const collect = () => {
      blocks.length = 0;
      root.querySelectorAll<HTMLElement>(BLOCK_SEL).forEach((el) => {
        if (el.closest('pre, code, #anno-panel, #anno-pop, .ed-gutter, .ed-highlight')) return;
        if (!el.textContent || !el.textContent.trim()) return;
        if (el.querySelector(BLOCK_SEL)) return;
        if (el.dataset.bid === undefined) el.dataset.bid = String(blocks.length);
        blocks.push(el);
      });
    };
    const textNodes = (el: HTMLElement) => {
      const out: Text[] = [];
      const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
        acceptNode: (n) => (n.nodeValue && n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT)
      });
      let n: Node | null;
      while ((n = w.nextNode())) out.push(n as Text);
      return out;
    };
    const charOffset = (el: HTMLElement, node: Node, offset: number) => {
      let acc = 0;
      for (const t of textNodes(el)) {
        if (t === node) return acc + offset;
        acc += t.nodeValue?.length ?? 0;
      }
      return acc;
    };
    const posAt = (el: HTMLElement, index: number) => {
      let acc = 0;
      for (const t of textNodes(el)) {
        const len = t.nodeValue?.length ?? 0;
        if (acc + len >= index) return { node: t, offset: index - acc };
        acc += len;
      }
      return null;
    };
    const clearMarks = () => {
      root.querySelectorAll('.anno-mark').forEach((m) => {
        const parent = m.parentNode;
        if (!parent) return;
        while (m.firstChild) parent.insertBefore(m.firstChild, m);
        parent.removeChild(m);
        (parent as HTMLElement).normalize?.();
      });
    };

    /* ---------- 高亮渲染 ---------- */
    const paint = () => {
      clearMarks();
      const mine = [...annosOf(PAGE)].sort((a, b) => b.start - a.start);
      for (const a of mine) {
        const el = blocks.find((b) => b.dataset.bid === String(a.bid));
        if (!el) continue;
        const s = posAt(el, a.start);
        const e = posAt(el, a.end);
        if (!s || !e) continue;
        try {
          const range = document.createRange();
          range.setStart(s.node, s.offset);
          range.setEnd(e.node, e.offset);
          const mark = document.createElement('mark');
          mark.className = 'anno-mark' + (a.comment ? ' anno-has-comment' : '') + (a.status === 'done' ? ' anno-done' : '');
          mark.style.setProperty('--anno-color', colOf(a.color));
          mark.dataset.aid = a.id;
          range.surroundContents(mark);
        } catch {}
      }
      const cnt = document.getElementById('anno-count');
      if (cnt) cnt.textContent = String(allAnnos().filter((a) => a.status === 'open').length);
    };

    /* ---------- 列表 ---------- */
    const typeOf = (page: string) =>
      page.startsWith('/project') ? 'project' : page.startsWith('/notes') ? 'notes' : page.startsWith('/hot200') ? 'hot200' : 'other';

    const visible = (): Anno[] => {
      const base = tab === 'page' ? annosOf(PAGE) : allAnnos();
      return base
        .filter((a) => (filter === 'all' ? true : filter === 'cmt' ? !!a.comment : a.status === filter))
        .filter((a) => (typeFilter === 'all' ? true : typeOf(a.page) === typeFilter))
        .filter((a) => {
          if (!query) return true;
          const q = query.toLowerCase();
          return (
            a.text.toLowerCase().includes(q) ||
            (a.comment ?? '').toLowerCase().includes(q) ||
            (a.pageTitle ?? '').toLowerCase().includes(q)
          );
        })
        .sort((a, b) => (tab === 'page' ? a.bid - b.bid || a.start - b.start : b.created - a.created));
    };

    const renderList = () => {
      const items = visible();
      if (!items.length) {
        list.innerHTML = `<p class="anno-empty">${tab === 'page' ? '这一页还没有批注。<br />选中一句话试试。' : '没有符合条件的批注。'}</p>`;
        return;
      }
      list.innerHTML = '';
      for (const a of items) {
        const box = document.createElement('div');
        box.className = 'anno-item' + (a.status === 'done' ? ' is-done' : '');
        box.dataset.aid = a.id;
        box.style.borderLeftColor = colOf(a.color);
        const quote = document.createElement('blockquote');
        const dot = document.createElement('span');
        dot.className = 'anno-dot';
        dot.style.setProperty('--c', colOf(a.color));
        quote.append(dot, document.createTextNode(a.text));
        box.appendChild(quote);
        if (a.comment) {
          const body = document.createElement('p');
          body.className = 'anno-body';
          body.textContent = a.comment;
          box.appendChild(body);
        }
        if (a.page !== PAGE) {
          const pg = document.createElement('p');
          pg.className = 'anno-page';
          pg.textContent = (a.pageTitle || a.page) + ' · ' + a.page;
          box.appendChild(pg);
        }
        const meta = document.createElement('div');
        meta.className = 'anno-meta';
        const time = document.createElement('span');
        time.textContent = new Date(a.created).toLocaleString('zh-CN', {
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit'
        });
        const doneBtn = document.createElement('button');
        doneBtn.type = 'button';
        doneBtn.textContent = a.status === 'done' ? '↩ 重开' : '✓ 已解决';
        doneBtn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          a.status = a.status === 'done' ? 'open' : 'done';
          a.updatedAt = Date.now();
          upsert(a);
          paint();
          renderList();
        });
        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.textContent = '删除';
        delBtn.style.marginLeft = 'auto';
        delBtn.addEventListener('click', (ev) => {
          ev.stopPropagation();
          remove(a);
          paint();
          renderList();
        });
        meta.append(time, doneBtn, delBtn);
        box.appendChild(meta);
        box.addEventListener('click', () => {
          if (a.page !== PAGE) {
            location.href = a.page + '#anno=' + a.id;
            return;
          }
          const el = blocks.find((b) => b.dataset.bid === String(a.bid));
          if (!el) return;
          el.scrollIntoView({ block: 'center', behavior: 'smooth' });
          el.classList.add('anno-flash');
          setTimeout(() => el.classList.remove('anno-flash'), 1200);
          root.querySelectorAll('.anno-mark').forEach((m) => m.classList.toggle('is-active', m.getAttribute('data-aid') === a.id));
        });
        list.appendChild(box);
      }
    };

    /* ---------- 选区工具条 ---------- */
    const bar = document.createElement('div');
    bar.id = 'anno-bar';
    bar.innerHTML =
      COLORS.map((x) => `<button type="button" class="anno-sw" data-c="${x.c}" title="${x.n}" style="--c:${x.c}"></button>`).join('') +
      '<button type="button" data-act="cm" style="margin-left:4px">＋评论</button>';
    document.body.appendChild(bar);

    const blockOf = (node: Node | null): HTMLElement | null => {
      let el = node instanceof Element ? (node as Element) : node?.parentElement ?? null;
      while (el) {
        if (el instanceof HTMLElement && el.dataset.bid !== undefined && blocks.includes(el)) return el;
        el = el.parentElement;
      }
      return null;
    };
    const selInfo = () => {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || !sel.rangeCount) return null;
      const range = sel.getRangeAt(0);
      const sb = blockOf(range.startContainer);
      const eb = blockOf(range.endContainer);
      if (!sb || sb !== eb) return null;
      const start = charOffset(sb, range.startContainer, range.startOffset);
      const end = charOffset(sb, range.endContainer, range.endOffset);
      if (end - start < 2) return null;
      const text = sb.textContent?.slice(start, end) ?? '';
      if (!text.trim()) return null;
      return { bid: Number(sb.dataset.bid), start, end, text, rect: range.getBoundingClientRect() };
    };

    const openPanel = () => panel.setAttribute('aria-hidden', 'false');
    const closePanel = () => panel.setAttribute('aria-hidden', 'true');
    toggle?.addEventListener('click', () => {
      panel.getAttribute('aria-hidden') === 'false' ? closePanel() : openPanel();
    });

    document.addEventListener('mouseup', () => {
      setTimeout(() => {
        const info = selInfo();
        if (!info) {
          bar.style.display = 'none';
          return;
        }
        pending = info;
        const r = info.rect;
        bar.style.display = 'flex';
        bar.style.top = Math.max(8, r.top - 40) + 'px';
        bar.style.left = Math.max(8, Math.min(window.innerWidth - 150, r.left + r.width / 2 - 60)) + 'px';
      }, 10);
    });

    bar.addEventListener('mousedown', (ev) => ev.preventDefault());
    bar.addEventListener('click', (ev) => {
      const act = (ev.target as HTMLElement).dataset.act;
      if (!pending) return;
      const picked = (ev.target as HTMLElement).dataset.c;
      if (picked) {
        commit('', picked);
        window.getSelection()?.removeAllRanges();
      } else if (act === 'cm') {
        popQuote.textContent = pending.text;
        pop.hidden = false;
        pop.style.top = Math.min(window.innerHeight - 200, pending.rect.bottom + 8) + 'px';
        pop.style.left = Math.max(12, Math.min(window.innerWidth - 312, pending.rect.left)) + 'px';
        popText.value = '';
        popText.focus();
      }
      bar.style.display = 'none';
    });

    let popColor = COLORS[0].c;
    const commit = (comment: string, color: string = popColor) => {
      if (!pending) return;
      const a: Anno = {
        id: Math.random().toString(36).slice(2, 10),
        page: PAGE,
        pageTitle: TITLE,
        bid: pending.bid,
        start: pending.start,
        end: pending.end,
        text: pending.text,
        comment,
        color,
        created: Date.now(),
        updatedAt: Date.now(),
        status: 'open'
      };
      pending = null;
      pop.hidden = true;
      upsert(a);
      paint();
      renderList();
      openPanel();
    };

    pop.addEventListener('click', (ev) => {
      const act = (ev.target as HTMLElement).dataset.act;
      if (act === 'save') commit(popText.value.trim());
      if (act === 'cancel') {
        pop.hidden = true;
        pending = null;
      }
    });
    popText?.addEventListener('keydown', (ev) => {
      if ((ev.metaKey || ev.ctrlKey) && ev.key === 'Enter') commit(popText.value.trim());
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        pop.hidden = true;
        bar.style.display = 'none';
        pending = null;
      }
    });

    root.addEventListener('click', (ev) => {
      const mark = (ev.target as HTMLElement).closest?.('.anno-mark');
      if (!mark) return;
      const aid = mark.getAttribute('data-aid');
      const a = annosOf(PAGE).find((x) => x.id === aid);
      if (!a) return;
      openPanel();
      document.querySelectorAll('.anno-tabs button').forEach((b) => b.classList.toggle('is-on', (b as HTMLElement).dataset.tab === 'page'));
      tab = 'page';
      renderList();
      const item = list.querySelector(`[data-aid="${aid}"]`) as HTMLElement | null;
      item?.click();
    });

    /* ---------- 面板交互 ---------- */
    document.querySelectorAll('.anno-tabs button').forEach((btn) => {
      btn.addEventListener('click', () => {
        tab = (btn as HTMLElement).dataset.tab as 'page' | 'all';
        document.querySelectorAll('.anno-tabs button').forEach((b) => b.classList.toggle('is-on', b === btn));
        renderList();
      });
    });
    const bindChips = (sel: string, apply: (v: string) => void) => {
      document.querySelectorAll(sel).forEach((btn) => {
        btn.addEventListener('click', () => {
          const v = (btn as HTMLElement).dataset.f ?? (btn as HTMLElement).dataset.t;
          document.querySelectorAll(sel).forEach((b) => b.classList.toggle('is-on', b === btn));
          apply(v!);
          renderList();
        });
      });
    };
    bindChips('#anno-filters .anno-chips:not(.anno-types) button', (v) => (filter = v as any));
    bindChips('#anno-types button', (v) => (typeFilter = v));
    qInput?.addEventListener('input', () => {
      query = qInput.value.trim();
      renderList();
    });

    panel.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const act = t.dataset.act;
      if (act === 'close') closePanel();
      if (act === 'export') {
        const blob = new Blob([JSON.stringify(store, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'annos-' + new Date().toISOString().slice(0, 10) + '.json';
        a.click();
        URL.revokeObjectURL(a.href);
      }
      if (act === 'import') (document.getElementById('anno-file') as HTMLInputElement)?.click();
    });

    document.getElementById('anno-file')?.addEventListener('change', async (ev) => {
      const file = (ev.target as HTMLInputElement).files?.[0];
      if (!file) return;
      try {
        const data = JSON.parse(await file.text());
        const pages = data.pages ?? (Array.isArray(data) ? { [PAGE]: data } : {});
        for (const [page, items] of Object.entries(pages as Record<string, Anno[]>)) {
          const cur = annosOf(page);
          const ids = new Set(cur.map((x) => x.id));
          store.pages[page] = cur.concat(
            items.filter((a) => !ids.has(a.id)).map((a) => ({ ...a, page, pageTitle: a.pageTitle || page }))
          );
        }
        saveLocal();
        paint();
        renderList();
      } catch {}
      (ev.target as HTMLInputElement).value = '';
    });

    // 弹层取色
    const popColors = document.getElementById('anno-pop-colors') as HTMLElement;
    const renderPopColors = () => {
      popColors.innerHTML = COLORS.map(
        (x) =>
          `<button type="button" class="anno-sw" data-pc="${x.c}" title="${x.n}" style="--c:${x.c};outline:${x.c === popColor ? '2px solid ' + x.c : 'none'};outline-offset:2px"></button>`
      ).join('');
    };
    renderPopColors();
    popColors.addEventListener('click', (ev) => {
      const c = (ev.target as HTMLElement).dataset.pc;
      if (!c) return;
      popColor = c;
      renderPopColors();
    });

    /* ---------- 启动 ---------- */
    collect();
    loadLocal();
    setSync('offline');
    paint();
    renderList();
    syncPull().then(() => {
      paint();
      renderList();
    });

    const aid = new URLSearchParams(location.hash.slice(1)).get('anno');
    if (aid) {
      openPanel();
      setTimeout(() => {
        const item = list.querySelector(`[data-aid="${aid}"]`) as HTMLElement | null;
        item?.click();
      }, 500);
    }
  })();
</script>
